<Window x:Class="WinBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WinBoost.App.Views"
        xmlns:helpers="clr-namespace:WinBoost.App.Helpers"
		
Title="{Binding Title}"
Height="700"
Width="1180"
MinWidth="1180"
MinHeight="700"
WindowStartupLocation="CenterScreen"
ResizeMode="CanResize"
Background="#1E1E1E">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="70"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="40"/>
		</Grid.RowDefinitions>
		<!-- HEADER -->

		<Border Background="#2D2D30">

			<Grid Margin="20,0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<materialDesign:PackIcon
					Grid.Column="0"
					Kind="RocketLaunch"
					Width="36"
					Height="36"
					Foreground="#4CAF50"
					VerticalAlignment="Center"/>

				<StackPanel
					Grid.Column="1"
					Margin="12,0,0,0"
					VerticalAlignment="Center">

					<TextBlock
						Text="WinBoost Pro 11"
						Foreground="White"
						FontSize="24"
						FontWeight="Bold"/>

					<TextBlock
						Text="Windows Performance Optimizer"
						Foreground="#B0B0B0"
						FontSize="12"/>

				</StackPanel>

				<!-- SELECTOR LIMBĂ -->

				<StackPanel
					Grid.Column="2"
					Margin="0,0,18,0"
					Orientation="Horizontal"
					VerticalAlignment="Center">

					<materialDesign:PackIcon
						Kind="Translate"
						Width="20"
						Height="20"
						Margin="0,0,8,0"
						Foreground="#4CAF50"
						VerticalAlignment="Center"/>

					<ComboBox
						x:Name="LanguageComboBox"
						Width="145"
						Height="34"
						SelectedIndex="0"
						SelectionChanged="LanguageComboBox_SelectionChanged"
						Foreground="Black"
						Background="White"
						VerticalContentAlignment="Center">

						<!-- ROMÂNĂ -->
						<ComboBoxItem>
							<StackPanel
								Orientation="Horizontal"
								VerticalAlignment="Center">

								<Image
									Source="/Assets/Flags/ro.png"
									Width="22"
									Height="15"
									Stretch="Uniform"
									Margin="0,0,8,0"/>

								<TextBlock
									Text="Română"
									VerticalAlignment="Center"/>

							</StackPanel>
						</ComboBoxItem>

						<!-- ENGLISH -->
						<ComboBoxItem>
							<StackPanel
								Orientation="Horizontal"
								VerticalAlignment="Center">

								<Image
									Source="/Assets/Flags/gb.png"
									Width="22"
									Height="15"
									Stretch="Uniform"
									Margin="0,0,8,0"/>

								<TextBlock
									Text="English"
									VerticalAlignment="Center"/>

							</StackPanel>
						</ComboBoxItem>

					</ComboBox>

				</StackPanel>

				<!-- VERSIUNE -->

				<Border
					Grid.Column="3"
					Padding="10,5"
					CornerRadius="6"
					Background="#4CAF50"
					VerticalAlignment="Center">

					<TextBlock
						Text="{x:Static helpers:AppVersionInfo.DisplayVersion}"
						Foreground="White"
						FontSize="12"
						FontWeight="SemiBold"/>

				</Border>

			</Grid>

		</Border>
		
		<!-- CONTENT -->

		<Grid Grid.Row="1">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- MENIU -->

			<StackPanel Background="#252526">

				<!-- DASHBOARD -->

				<Button
					x:Name="DashboardButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="DashboardButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="ViewDashboard"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuDashboard}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- PERFORMANCE -->

				<Button
					x:Name="PerformanceButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="PerformanceButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="Speedometer"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuPerformance}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- PRIVACY -->

				<Button
					x:Name="PrivacyButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="PrivacyButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="ShieldLock"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuPrivacy}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- SERVICES -->

				<Button
					x:Name="ServicesButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="ServicesButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="Cog"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuServices}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- WINDOWS UPDATE -->

				<Button
					x:Name="WindowsUpdateButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="WindowsUpdateButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="Update"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuWindowsUpdate}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- APPS -->

				<Button
					x:Name="AppsButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="AppsButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="Apps"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuApps}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- STARTUP MANAGER -->

				<Button
					x:Name="StartupButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="StartupButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="Power"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuStartupManager}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- RECOVERY & SAFETY -->

				<Button
					x:Name="RecoveryButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="RecoveryButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="Restore"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuRecovery}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>
				
				<!-- SETTINGS -->

				<Button
					x:Name="SettingsButton"
					Style="{StaticResource SidebarButtonStyle}"
					Click="SettingsButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
							Kind="Tune"
							Width="20"
							Height="20"
							Margin="0,0,12,0"
							Foreground="#4CAF50"/>

						<TextBlock
							Text="{DynamicResource MenuSettings}"
							VerticalAlignment="Center"/>

					</StackPanel>

				</Button>
				
			</StackPanel>
				
			<!-- ZONA PRINCIPALĂ -->

			<Border
                Grid.Column="1"
                Margin="20"
                CornerRadius="8"
                Background="#1E1E1E">

				<ContentControl x:Name="MainContent"/>

			</Border>

		</Grid>

		<!-- STATUS BAR -->

		<Border
            Grid.Row="2"
            Background="#2D2D30">

			<TextBlock
                Text="Ready"
                Foreground="White"
                VerticalAlignment="Center"
                Margin="15,0"/>

		</Border>

	</Grid>

</Window>