<Window x:Class="WinBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WinBoost.App.Views"

        Title="{Binding Title}"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E1E">

	<Grid>

		<Grid.RowDefinitions>
			<RowDefinition Height="70"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="40"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->

		<Border Background="#2D2D30">

			<Grid Margin="20,0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<materialDesign:PackIcon
                    Kind="RocketLaunch"
                    Width="36"
                    Height="36"
                    Foreground="#4CAF50"
                    VerticalAlignment="Center"/>

				<StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

					<TextBlock
                        Text="WinBoost Pro 11"
                        Foreground="White"
                        FontSize="24"
                        FontWeight="Bold"/>

					<TextBlock
                        Text="Windows Performance Optimizer"
                        Foreground="#B0B0B0"
                        FontSize="12"/>

				</StackPanel>

				<Border
                    Grid.Column="2"
                    Padding="10,5"
                    CornerRadius="6"
                    Background="#4CAF50"
                    VerticalAlignment="Center">

					<TextBlock
                        Text="v1.0 Preview"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"/>

				</Border>

			</Grid>

		</Border>

		<!-- CONTENT -->

		<Grid Grid.Row="1">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- MENIU -->

			<StackPanel Background="#252526">

				<!-- DASHBOARD -->

				<Button
                    x:Name="DashboardButton"
                    Style="{StaticResource SidebarButtonStyle}"
                    Click="DashboardButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="ViewDashboard"
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="Dashboard"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- PERFORMANCE -->

				<Button
                    x:Name="PerformanceButton"
                    Style="{StaticResource SidebarButtonStyle}"
                    Click="PerformanceButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="Speedometer"
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="Performance"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- PRIVACY -->

				<Button
                    x:Name="PrivacyButton"
                    Style="{StaticResource SidebarButtonStyle}"
                    Click="PrivacyButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="ShieldLock"
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="Privacy"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- SERVICES -->

				<Button
                    Style="{StaticResource SidebarButtonStyle}">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="Cog"
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="Services"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- WINDOWS UPDATE -->

				<Button
                    Style="{StaticResource SidebarButtonStyle}">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="Update"
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="Windows Update"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- APPS -->

				<Button
                    Style="{StaticResource SidebarButtonStyle}">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="Apps"
                            Width="20"
                            Height="20"
                            Margin="0,0,12,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="Apps"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

			</StackPanel>

			<!-- ZONA PRINCIPALĂ -->

			<Border
                Grid.Column="1"
                Margin="20"
                CornerRadius="8"
                Background="#333333">

				<ContentControl x:Name="MainContent"/>

			</Border>

		</Grid>

		<!-- STATUS BAR -->

		<Border
            Grid.Row="2"
            Background="#2D2D30">

			<TextBlock
                Text="Ready"
                Foreground="White"
                VerticalAlignment="Center"
                Margin="15,0"/>

		</Border>

	</Grid>

</Window>