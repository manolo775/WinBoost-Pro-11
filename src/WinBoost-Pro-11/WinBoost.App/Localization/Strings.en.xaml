<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

	<!-- MAIN MENU -->

	<sys:String x:Key="MenuDashboard">
		Dashboard
	</sys:String>

	<sys:String x:Key="MenuPerformance">
		Performance
	</sys:String>

	<sys:String x:Key="MenuPrivacy">
		Privacy
	</sys:String>

	<sys:String x:Key="MenuServices">
		Services
	</sys:String>

	<sys:String x:Key="MenuWindowsUpdate">
		Windows Update
	</sys:String>

	<sys:String x:Key="MenuApps">
		Apps
	</sys:String>

	<sys:String x:Key="MenuStartupManager">
		Startup Manager
	</sys:String>

	<!-- SERVICES PAGE -->

	<sys:String x:Key="ServicesPageTitle">
		Services
	</sys:String>

	<sys:String x:Key="ServicesPageDescription">
		Check Windows services and identify services that may affect performance.
	</sys:String>

	<sys:String x:Key="ServicesCheckTitle">
		Windows Services Check
	</sys:String>

	<sys:String x:Key="ServicesScanFallback">
		Press Scan Services to begin.
	</sys:String>

	<sys:String x:Key="ServicesScanInformation">
		The scan is informational only and does not modify Windows services.
	</sys:String>

	<sys:String x:Key="ServicesScanButton">
		Scan Services
	</sys:String>

	<sys:String x:Key="ServicesHealthTitle">
		Services Health
	</sys:String>

	<sys:String x:Key="ServicesHealthDescription">
		Summary of the Windows services identified during the scan.
	</sys:String>

	<sys:String x:Key="ServicesHealthTotal">
		Total
	</sys:String>

	<sys:String x:Key="ServicesHealthRunning">
		Running
	</sys:String>

	<sys:String x:Key="ServicesHealthCritical">
		Critical
	</sys:String>

	<sys:String x:Key="ServicesHealthRecommended">
		Recommended
	</sys:String>

	<sys:String x:Key="ServicesHealthSafe">
		Safe
	</sys:String>

	<sys:String x:Key="ServicesHealthEstimatedGain">
		Estimated gain
	</sys:String>

	<sys:String x:Key="ServicesAnalyzedTitle">
		Analyzed services
	</sys:String>

	<sys:String x:Key="ServicesAnalyzedDescription">
		Services identified during the scan will appear here.
	</sys:String>

	<sys:String x:Key="ServicesSearchToolTip">
		Search by display name or internal service name.
	</sys:String>

	<sys:String x:Key="ServicesColumnService">
		Service
	</sys:String>

	<sys:String x:Key="ServicesColumnStatus">
		Status
	</sys:String>

	<sys:String x:Key="ServicesColumnStartup">
		Startup
	</sys:String>

	<sys:String x:Key="ServicesColumnRecommendation">
		Recommendation
	</sys:String>

	<sys:String x:Key="ServicesColumnHealth">
		Health
	</sys:String>

	<sys:String x:Key="ServicesColumnActions">
		Actions
	</sys:String>

	<sys:String x:Key="ServicesActionStart">
		Start
	</sys:String>

	<sys:String x:Key="ServicesActionStop">
		Stop
	</sys:String>

	<sys:String x:Key="ServicesActionRestart">
		Restart
	</sys:String>

</ResourceDictionary>