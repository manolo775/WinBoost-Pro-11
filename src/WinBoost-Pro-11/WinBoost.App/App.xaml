<Application
    x:Class="WinBoost.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">

	<Application.Resources>

		<ResourceDictionary>

			<BooleanToVisibilityConverter
                x:Key="BooleanToVisibilityConverter"/>

			<ResourceDictionary.MergedDictionaries>

				<!-- Culori -->
				<ResourceDictionary
                    Source="Themes/Colors.xaml"/>

				<!-- Stiluri butoane -->
				<ResourceDictionary
                    Source="Themes/Buttons.xaml"/>

				<!-- Tema generală -->
				<ResourceDictionary
                    Source="Themes/Theme.xaml"/>

				<!-- Limba implicită: Română -->
				<ResourceDictionary
                    Source="Localization/Strings.ro.xaml"/>

			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>

	</Application.Resources>

</Application>