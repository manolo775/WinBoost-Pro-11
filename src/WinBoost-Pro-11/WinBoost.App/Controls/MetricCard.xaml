<UserControl x:Class="WinBoost.App.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             MinHeight="150">

	<Border
        Padding="18"
        Background="#252525"
        CornerRadius="16">

		<StackPanel>

			<TextBlock
               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="White"/>

			<TextBlock
				Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
				Margin="0,10,0,0"
				FontSize="28"
				FontWeight="Bold"
				Foreground="White"/>

			<Grid
				Height="18"
				Margin="0,14,0,0">

				<Border
					Background="#444444"
					CornerRadius="9"/>

				<ProgressBar
					Minimum="0"
					Maximum="100"
					Value="{Binding ProgressValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
					Background="Transparent"
					Foreground="{StaticResource AccentBrush}"
					BorderThickness="0"/>

			</Grid>

			<TextBlock
                Text="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="LightGreen"/>

		</StackPanel>

	</Border>

</UserControl>