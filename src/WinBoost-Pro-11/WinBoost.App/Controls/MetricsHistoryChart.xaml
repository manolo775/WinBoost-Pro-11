<UserControl
    x:Class="WinBoost.App.Controls.MetricsHistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Border
        Margin="50,15,50,10"
        Padding="20"
        CornerRadius="10"
        Background="#2B2B2B">

		<StackPanel>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">

					<TextBlock
                        Text="{DynamicResource DashboardHistoryTitle}"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White"/>

					<TextBlock
                        Margin="0,6,15,16"
                        Text="{DynamicResource DashboardHistoryDescription}"
                        TextWrapping="Wrap"
                        Foreground="#BDBDBD"/>

				</StackPanel>

				<!-- SELECTOR ȘI ȘTERGERE ISTORIC -->

				<StackPanel
                    Grid.Column="1"
                    Width="170"
                    VerticalAlignment="Top">

					<ComboBox
                        Height="36"
                        SelectedIndex="{Binding SelectedHistoryRangeIndex,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}">

						<ComboBoxItem
                            Content="{DynamicResource DashboardHistoryRangeLive}"/>

						<ComboBoxItem
                            Content="{DynamicResource DashboardHistoryRangeHour}"/>

						<ComboBoxItem
                            Content="{DynamicResource DashboardHistoryRange24Hours}"/>

						<ComboBoxItem
                            Content="{DynamicResource DashboardHistoryRange7Days}"/>

					</ComboBox>

					<Button
                        Height="34"
                        Margin="0,8,0,0"
                        Padding="10,4"
                        Command="{Binding ClearPerformanceHistoryCommand}"
                        Content="{DynamicResource DashboardHistoryClearButton}"
                        Background="#352844"
                        BorderBrush="#6A4C85"
                        Foreground="#FFD740"/>

				</StackPanel>

			</Grid>

			<!-- LEGENDĂ -->

			<StackPanel
                Orientation="Horizontal"
                Margin="0,0,0,12">

				<StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,20,0">

					<Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        Fill="#00C853"/>

					<TextBlock
                        Text="CPU"
                        Foreground="#E0E0E0"/>

				</StackPanel>

				<StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,20,0">

					<Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        Fill="#29B6F6"/>

					<TextBlock
                        Text="RAM"
                        Foreground="#E0E0E0"/>

				</StackPanel>

				<StackPanel Orientation="Horizontal">

					<Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,6,0"
                        Fill="#FFD740"/>

					<TextBlock
                        Text="{DynamicResource DashboardHistoryDiskLegend}"
                        Foreground="#E0E0E0"/>

				</StackPanel>

			</StackPanel>

			<!-- GRAFIC -->

			<Border
                Height="180"
                Background="#25272B"
                CornerRadius="8">

				<Canvas x:Name="ChartCanvas"/>

			</Border>

		</StackPanel>

	</Border>

</UserControl>