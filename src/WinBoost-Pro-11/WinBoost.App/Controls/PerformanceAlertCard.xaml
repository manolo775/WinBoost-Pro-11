<UserControl
    x:Class="WinBoost.App.Controls.PerformanceAlertCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    mc:Ignorable="d"
    d:DesignHeight="160"
    d:DesignWidth="800">

	<Border
        x:Name="CardBorder"
        Margin="50,10,50,5"
        Padding="18"
        CornerRadius="10"
        Background="{Binding PerformanceAlertBackground}"
        BorderBrush="{Binding PerformanceAlertBrush}"
        RenderTransformOrigin="0.5,0.5"
        Visibility="{Binding HasPerformanceAlert,
                     Converter={StaticResource BooleanToVisibilityConverter}}">

		<Border.Style>

			<Style
                TargetType="Border"
                BasedOn="{StaticResource MetricCardBorderStyle}">

				<Setter
                    Property="BorderThickness"
                    Value="1"/>

				<Setter Property="RenderTransform">

					<Setter.Value>

						<ScaleTransform
                            ScaleX="1"
                            ScaleY="1"/>

					</Setter.Value>

				</Setter>

				<Setter Property="Effect">

					<Setter.Value>

						<DropShadowEffect
                            Color="Black"
                            BlurRadius="10"
                            ShadowDepth="2"
                            Opacity="0.30"/>

					</Setter.Value>

				</Setter>

				<Style.Triggers>

					<Trigger
                        Property="IsMouseOver"
                        Value="True">

						<Setter
                            Property="BorderThickness"
                            Value="2"/>

						<Setter Property="RenderTransform">

							<Setter.Value>

								<ScaleTransform
                                    ScaleX="1.012"
                                    ScaleY="1.012"/>

							</Setter.Value>

						</Setter>

						<Setter Property="Effect">

							<Setter.Value>

								<DropShadowEffect
                                    Color="Black"
                                    BlurRadius="24"
                                    ShadowDepth="5"
                                    Opacity="0.75"/>

							</Setter.Value>

						</Setter>

					</Trigger>

				</Style.Triggers>

			</Style>

		</Border.Style>

		<Grid>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- ICON -->

			<materialDesign:PackIcon
                Grid.Column="0"
                Kind="{Binding PerformanceAlertIcon}"
                Width="34"
                Height="34"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Foreground="{Binding PerformanceAlertBrush}"/>

			<!-- CONȚINUT -->

			<StackPanel
                Grid.Column="1"
                VerticalAlignment="Center">

				<StackPanel Orientation="Horizontal">

					<TextBlock
                        Text="{Binding PerformanceAlertTitle}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"/>

					<TextBlock
                        Margin="12,2,0,0"
                        Text="{Binding PerformanceAlertSeverityText}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{Binding PerformanceAlertBrush}"/>

				</StackPanel>

				<TextBlock
                    Margin="0,7,15,0"
                    Text="{Binding PerformanceAlertMessage}"
                    TextWrapping="Wrap"
                    FontSize="15"
                    Foreground="White"/>

				<TextBlock
                    Margin="0,5,15,0"
                    Text="{Binding PerformanceAlertDurationText}"
                    TextWrapping="Wrap"
                    FontSize="13"
                    Foreground="#D0D0D0"/>

				<CheckBox
    Margin="0,10,15,0"
    VerticalAlignment="Center"
    IsChecked="{Binding IsCriticalAlertSoundEnabled,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
    Foreground="White"
    ToolTip="{DynamicResource PerformanceAlertCriticalSoundDescription}">

					<TextBlock
						Text="{DynamicResource PerformanceAlertCriticalSoundOption}"
						TextWrapping="Wrap"
						Foreground="White"/>

				</CheckBox>

				<Grid
    Margin="0,10,15,0"
    ToolTip="{DynamicResource PerformanceAlertRepeatDescription}">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBlock
						Grid.Column="0"
						Text="{DynamicResource PerformanceAlertRepeatLabel}"
						VerticalAlignment="Center"
						Foreground="White"/>

					<ComboBox
						Grid.Column="1"
						Width="155"
						Height="32"
						Margin="12,0,0,0"
						VerticalContentAlignment="Center"
						SelectedIndex="{Binding SelectedCriticalAlertRepeatIndex,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}">

						<ComboBoxItem
							Content="{DynamicResource PerformanceAlertRepeatNever}"/>

						<ComboBoxItem
							Content="{DynamicResource PerformanceAlertRepeat5Minutes}"/>

						<ComboBoxItem
							Content="{DynamicResource PerformanceAlertRepeat15Minutes}"/>

						<ComboBoxItem
							Content="{DynamicResource PerformanceAlertRepeat30Minutes}"/>

					</ComboBox>

				</Grid>
				
			</StackPanel>

			<!-- ÎNCHIDERE ALERTĂ -->

			<Button
                Grid.Column="2"
                MinWidth="110"
                Height="38"
                Padding="12,5"
                VerticalAlignment="Center"
                Content="{DynamicResource PerformanceAlertDismiss}"
                Command="{Binding DismissPerformanceAlertCommand}"
                Background="#25272B"
                Foreground="White"
                BorderBrush="{Binding PerformanceAlertBrush}"
                BorderThickness="1"/>

		</Grid>

	</Border>

</UserControl>