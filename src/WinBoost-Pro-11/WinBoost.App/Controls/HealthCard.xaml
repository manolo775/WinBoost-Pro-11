<UserControl
    x:Class="WinBoost.App.Controls.HealthCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="260"
    d:DesignWidth="800">

	<Border
       Style="{StaticResource DashboardCardBorderStyle}"
        Padding="22">

		<Border.Resources>

			<Style
                x:Key="HealthModuleButtonStyle"
                TargetType="Button">

				<Setter
                    Property="Margin"
                    Value="4"/>

				<Setter
                    Property="Padding"
                    Value="10"/>

				<Setter
                    Property="Background"
                    Value="#25272B"/>

				<Setter
                    Property="Foreground"
                    Value="White"/>

				<Setter
                    Property="BorderThickness"
                    Value="0"/>

				<Setter
                    Property="Cursor"
                    Value="Hand"/>

				<Setter Property="Template">

					<Setter.Value>

						<ControlTemplate
                            TargetType="Button">

							<Border
                                x:Name="ModuleBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">

								<ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>

							</Border>

							<ControlTemplate.Triggers>

								<Trigger
                                    Property="IsMouseOver"
                                    Value="True">

									<Setter
                                        TargetName="ModuleBorder"
                                        Property="Background"
                                        Value="#30333A"/>

									<Setter
                                        TargetName="ModuleBorder"
                                        Property="BorderBrush"
                                        Value="#4CAF50"/>

									<Setter
                                        TargetName="ModuleBorder"
                                        Property="BorderThickness"
                                        Value="1"/>

									<Setter
                                        TargetName="ModuleBorder"
                                        Property="Effect">

										<Setter.Value>

											<DropShadowEffect
                                                Color="Black"
                                                BlurRadius="14"
                                                ShadowDepth="3"
                                                Opacity="0.55"/>

										</Setter.Value>

									</Setter>

								</Trigger>

								<Trigger
                                    Property="IsPressed"
                                    Value="True">

									<Setter
                                        TargetName="ModuleBorder"
                                        Property="Opacity"
                                        Value="0.72"/>

								</Trigger>

							</ControlTemplate.Triggers>

						</ControlTemplate>

					</Setter.Value>

				</Setter>

			</Style>

		</Border.Resources>

		<Grid>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- SCOR GENERAL -->

			<Grid Grid.Row="0">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center">

					<TextBlock
                        Text="{DynamicResource HealthCardOverallTitle}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"/>

					<TextBlock
                        Text="{Binding HealthSummary.OverallHealthStatus,
                                       Mode=OneWay}"
                        Margin="0,5,0,0"
                        FontSize="14"
                        Foreground="{Binding HealthSummary.OverallHealthBrush,
                                             Mode=OneWay}"/>

					<ProgressBar
                        Value="{Binding HealthSummary.OverallHealthScore,
                                        Mode=OneWay}"
                        Maximum="100"
                        Height="8"
                        Margin="0,14,30,0"
                        Background="#505257"
                        Foreground="{Binding HealthSummary.OverallHealthBrush,
                                             Mode=OneWay}"/>

				</StackPanel>

				<StackPanel
                    Grid.Column="1"
                    Margin="20,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

					<TextBlock
                        Text="{Binding HealthSummary.OverallHealthText,
                                       Mode=OneWay}"
                        FontSize="38"
                        FontWeight="Bold"
                        Foreground="{Binding HealthSummary.OverallHealthBrush,
                                             Mode=OneWay}"
                        HorizontalAlignment="Center"/>

					<TextBlock
                        Text="{DynamicResource HealthCardSystemScore}"
                        Margin="0,-3,0,0"
                        FontSize="13"
                        Foreground="#B8BCC4"
                        HorizontalAlignment="Center"/>

				</StackPanel>

			</Grid>

			<!-- SCORURI MODULE -->

			<UniformGrid
                Grid.Row="1"
                Columns="5"
                Margin="0,22,0,0">

				<!-- PERFORMANȚĂ -->

				<Button
                    Style="{StaticResource HealthModuleButtonStyle}"
                    Click="PerformanceButton_Click">

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource HealthCardPerformance}"
                            HorizontalAlignment="Center"
                            Foreground="#B8BCC4"/>

						<TextBlock
                            Text="{Binding HealthSummary.PerformanceScore,
                                           StringFormat={}{0}%}"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="White"/>

					</StackPanel>

				</Button>

				<!-- SERVICII -->

				<Button
                    Style="{StaticResource HealthModuleButtonStyle}"
                    Click="ServicesButton_Click">

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource HealthCardServices}"
                            HorizontalAlignment="Center"
                            Foreground="#B8BCC4"/>

						<TextBlock
                            Text="{Binding HealthSummary.ServicesScore,
                                           StringFormat={}{0}%}"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="White"/>

					</StackPanel>

				</Button>

				<!-- PORNIRE -->

				<Button
                    Style="{StaticResource HealthModuleButtonStyle}"
                    Click="StartupButton_Click">

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource HealthCardStartup}"
                            HorizontalAlignment="Center"
                            Foreground="#B8BCC4"/>

						<TextBlock
                            Text="{Binding HealthSummary.StartupScore,
                                           StringFormat={}{0}%}"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="White"/>

					</StackPanel>

				</Button>

				<!-- CONFIDENȚIALITATE -->

				<Button
                    Style="{StaticResource HealthModuleButtonStyle}"
                    Padding="4,10"
                    Click="PrivacyButton_Click">

					<StackPanel>

						<TextBlock
	                    	Text="{DynamicResource HealthCardPrivacy}"
	                     	HorizontalAlignment="Center"
	                    	TextAlignment="Center"
	                    	FontSize="13"
	                    	TextWrapping="NoWrap"
	                    	Foreground="#B8BCC4"/>

						<TextBlock
                            Text="{Binding HealthSummary.PrivacyScore,
                                           StringFormat={}{0}%}"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="White"/>

					</StackPanel>

				</Button>

				<!-- ACTUALIZĂRI WINDOWS -->

				<Button
                    Style="{StaticResource HealthModuleButtonStyle}"
                    Click="WindowsUpdateButton_Click">

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource HealthCardWindowsUpdate}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="#B8BCC4"/>

						<TextBlock
                            Text="{Binding HealthSummary.WindowsUpdateScore,
                                           StringFormat={}{0}%}"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="White"/>

					</StackPanel>

				</Button>

			</UniformGrid>

		</Grid>

	</Border>

</UserControl>