<UserControl
    x:Class="WinBoost.App.Controls.HealthCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Border
        Padding="22,16"
        Background="#2D3035"
        CornerRadius="14">

		<Grid>

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel
                Grid.Column="0"
                VerticalAlignment="Center">

				<TextBlock
                    Text="Overall System Health"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"/>

				<TextBlock
                    Text="{Binding HealthStatus}"
                    Margin="0,5,0,0"
                    FontSize="14"
                    Foreground="#B8BCC4"/>

				<ProgressBar
                    Value="{Binding HealthScore}"
                    Maximum="100"
                    Height="8"
                    Margin="0,14,30,0"
                    Background="#505257"
                    Foreground="#00C853"/>

			</StackPanel>

			<StackPanel
                Grid.Column="1"
                Margin="20,0,5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

				<TextBlock
                    Text="{Binding HealthScore}"
                    FontSize="38"
                    FontWeight="Bold"
                    Foreground="#00D66B"
                    HorizontalAlignment="Center"/>

				<TextBlock
                    Text="/ 100"
                    Margin="0,-5,0,0"
                    FontSize="14"
                    Foreground="#B8BCC4"
                    HorizontalAlignment="Center"/>

			</StackPanel>

		</Grid>

	</Border>

</UserControl>