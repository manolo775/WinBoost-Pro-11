<UserControl x:Class="WinBoost.App.Controls.QuickActionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

	<Border
        Padding="22"
        CornerRadius="12"
        Background="{StaticResource CardBrush}">

		<StackPanel>

			<TextBlock
                Text="{DynamicResource QuickActionsTitle}"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextBrush}"/>

			<TextBlock
                Text="{DynamicResource QuickActionsDescription}"
                Margin="0,6,0,18"
                FontSize="14"
                TextWrapping="Wrap"
                Foreground="{StaticResource SecondaryTextBrush}"/>

			<UniformGrid Columns="2">

				<!-- STARTUP MANAGER -->

				<Button
                    x:Name="OpenStartupButton"
                    Height="52"
                    Margin="0,0,8,8"
                    Click="OpenStartupButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="RocketLaunch"
                            Width="22"
                            Height="22"
                            Margin="0,0,10,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="{DynamicResource QuickActionsStartup}"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- SERVICES MANAGER -->

				<Button
                    Height="52"
                    Margin="8,0,0,8"
                    IsEnabled="False">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="Cog"
                            Width="22"
                            Height="22"
                            Margin="0,0,10,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="{DynamicResource QuickActionsServices}"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- CLEAN TEMP FILES -->

				<Button
                    x:Name="CleanTempFilesButton"
                    Height="52"
                    Margin="0,8,8,0"
                    Click="CleanTempFilesButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="Broom"
                            Width="22"
                            Height="22"
                            Margin="0,0,10,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="{DynamicResource QuickActionsTempFiles}"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

				<!-- OPTIMIZE SYSTEM -->

				<Button
                    x:Name="OptimizeSystemButton"
                    Height="52"
                    Margin="8,8,0,0"
                    Click="OptimizeSystemButton_Click">

					<StackPanel Orientation="Horizontal">

						<materialDesign:PackIcon
                            Kind="Speedometer"
                            Width="22"
                            Height="22"
                            Margin="0,0,10,0"
                            Foreground="#4CAF50"/>

						<TextBlock
                            Text="{DynamicResource QuickActionsOptimize}"
                            VerticalAlignment="Center"/>

					</StackPanel>

				</Button>

			</UniformGrid>

		</StackPanel>

	</Border>

</UserControl>