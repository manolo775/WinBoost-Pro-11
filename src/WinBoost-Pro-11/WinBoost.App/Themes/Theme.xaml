<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

	<ResourceDictionary.MergedDictionaries>

		<ResourceDictionary Source="Colors.xaml"/>
		<ResourceDictionary Source="Buttons.xaml"/>

	</ResourceDictionary.MergedDictionaries>

	<!-- ========================= -->
	<!-- WinBoost Design System -->
	<!-- ========================= -->

	<!-- Card -->
	<CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
	<Thickness x:Key="CardPadding">20</Thickness>
	<Thickness x:Key="CardMargin">12</Thickness>

	<!-- Typography -->
	<sys:Double x:Key="MetricTitleFontSize">22</sys:Double>
	<sys:Double x:Key="MetricValueFontSize">44</sys:Double>
	<sys:Double x:Key="MetricSubtitleFontSize">14</sys:Double>

	<!-- Icon -->
	<sys:Double x:Key="MetricIconSize">40</sys:Double>

	<!-- Progress bar -->
	<sys:Double x:Key="MetricProgressHeight">14</sys:Double>

	<!-- Hover pentru carduri -->
	<Style x:Key="MetricCardBorderStyle"
       TargetType="Border">

		<Setter Property="Background" Value="#2F3136"/>

		<Setter Property="Cursor"
				Value="Hand"/>

		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect
					BlurRadius="14"
					ShadowDepth="2"
					Opacity="0.30"/>
			</Setter.Value>
		</Setter>
		<Setter Property="RenderTransform">
			<Setter.Value>
				<ScaleTransform ScaleX="1" ScaleY="1"/>
			</Setter.Value>
		</Setter>

		<Style.Triggers>

			<Trigger Property="IsMouseOver"
					 Value="True">

				<Setter Property="Background" Value="#3A3D44"/>

				<Setter Property="RenderTransform">
					<Setter.Value>
						<ScaleTransform
							ScaleX="1.05"
							ScaleY="1.05"/>
					</Setter.Value>
				</Setter>

			</Trigger>

		</Style.Triggers>

	</Style>

</ResourceDictionary>