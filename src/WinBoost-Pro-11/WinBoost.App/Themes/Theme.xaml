<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

	<ResourceDictionary.MergedDictionaries>

		<ResourceDictionary Source="Colors.xaml"/>
		<ResourceDictionary Source="Buttons.xaml"/>
		<ResourceDictionary Source="TabControl.xaml"/>
		<ResourceDictionary Source="ScrollBars.xaml"/>

	</ResourceDictionary.MergedDictionaries>

	<!-- ========================= -->
	<!-- WinBoost Design System    -->
	<!-- ========================= -->

	<!-- Card -->

	<CornerRadius x:Key="CardCornerRadius">
		16
	</CornerRadius>

	<Thickness x:Key="CardPadding">
		20
	</Thickness>

	<Thickness x:Key="CardMargin">
		12
	</Thickness>

	<!-- Typography -->

	<sys:Double x:Key="MetricTitleFontSize">
		22
	</sys:Double>

	<sys:Double x:Key="MetricValueFontSize">
		44
	</sys:Double>

	<sys:Double x:Key="MetricSubtitleFontSize">
		14
	</sys:Double>

	<!-- Icon -->

	<sys:Double x:Key="MetricIconSize">
		40
	</sys:Double>

	<!-- Progress bar -->

	<sys:Double x:Key="MetricProgressHeight">
		14
	</sys:Double>

	<!-- ========================= -->
	<!-- Stil general interactiv   -->
	<!-- ========================= -->

	<Style x:Key="InteractiveCardStyle" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource CardBrush}"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0"/>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="#31353B"/>
				<Setter Property="BorderBrush" Value="#4CAF50"/>
				<Setter Property="Effect">
					<Setter.Value>
						<DropShadowEffect Color="#4CAF50" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
	</Style>
	<!-- Compatibilitate cu MetricCard existent -->

	<Style
        x:Key="MetricCardBorderStyle"
        TargetType="Border"
        BasedOn="{StaticResource InteractiveCardStyle}">

		<Setter
            Property="Background"
            Value="#2F3136"/>

		<Setter
            Property="CornerRadius"
            Value="{StaticResource CardCornerRadius}"/>

	</Style>

</ResourceDictionary>