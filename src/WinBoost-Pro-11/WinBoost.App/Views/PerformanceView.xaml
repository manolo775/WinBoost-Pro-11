<UserControl
    x:Class="WinBoost.App.Views.PerformanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="Performance"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="Monitorizare și optimizare în timp real"
                    Margin="0,6,0,0"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- CARDURI METRICE -->

			<UniformGrid
                Grid.Row="1"
                Columns="3"
                Margin="0,25,0,0">

				<!-- CPU -->

				<Border
                    Margin="0,0,12,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                            Text="CPU Usage"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                               Text="{Binding CpuUsage}"
                               Margin="0,12,0,0"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
							Value="{Binding CpuUsageValue}"
							Maximum="100"
							Height="8"
							Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

				<!-- RAM -->

				<Border
                    Margin="6,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                            Text="RAM Usage"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                             Text="{Binding RamUsage}"
                             Margin="0,12,0,0"
                             FontSize="34"
                             FontWeight="Bold"
                             Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
							Value="{Binding RamUsageValue}"
							Maximum="100"
							Height="8"
							Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

				<!-- DISK -->

				<Border
                    Margin="12,0,0,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                            Text="Disk Usage"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
							Text="{Binding DiskUsage}"
							Margin="0,12,0,0"
							FontSize="34"
							FontWeight="Bold"
							Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
							Value="{Binding DiskUsageValue}"
							Maximum="100"
							Height="8"
							Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

			</UniformGrid>

			<!-- ZONA DE OPTIMIZARE -->

			<Border
                Grid.Row="2"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock
                            Text="Optimizare rapidă"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="Analizează sistemul și aplică optimizările recomandate."
                            Margin="0,8,0,0"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<Button
                        Grid.Column="1"
                        Content="Optimize Now"
                        Width="150"
                        Height="42"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"/>

				</Grid>

			</Border>
			<!-- TOP PROCESSES -->

			<Border
				Grid.Row="3"
				Margin="0,25,0,0"
				Padding="22"
				CornerRadius="10"
				Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
						Text="Top Processes"
						FontSize="20"
						FontWeight="SemiBold"
						Foreground="{StaticResource TextBrush}"/>

					<TextBlock
						Text="Procesele care folosesc cel mai mult procesorul"
						Margin="0,5,0,18"
						Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- ANTET -->

					<Grid Margin="0,0,0,8">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="80"/>
							<ColumnDefinition Width="100"/>
							<ColumnDefinition Width="120"/>
						</Grid.ColumnDefinitions>

						<TextBlock
							Text="Proces"
							FontWeight="SemiBold"
							Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
							Grid.Column="1"
							Text="PID"
							FontWeight="SemiBold"
							Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
							Grid.Column="2"
							Text="CPU"
							FontWeight="SemiBold"
							Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
							Grid.Column="3"
							Text="RAM"
							FontWeight="SemiBold"
							Foreground="{StaticResource SecondaryTextBrush}"/>

					</Grid>

					<Border
						Height="1"
						Margin="0,0,0,5"
						Background="#454545"/>

					<!-- LISTA PROCESELOR -->

					<ItemsControl ItemsSource="{Binding TopProcesses}">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Grid Margin="0,7">

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="80"/>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="120"/>
									</Grid.ColumnDefinitions>

									<TextBlock
										Text="{Binding Name}"
										Foreground="{StaticResource TextBrush}"/>

									<TextBlock
										Grid.Column="1"
										Text="{Binding ProcessId}"
										Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
										Grid.Column="2"
										Text="{Binding CpuUsageText}"
										Foreground="#00C853"/>

									<TextBlock
										Grid.Column="3"
										Text="{Binding MemoryUsageText}"
										Foreground="{StaticResource TextBrush}"/>

								</Grid>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

			</Border>
		</Grid>

	</ScrollViewer>

</UserControl>