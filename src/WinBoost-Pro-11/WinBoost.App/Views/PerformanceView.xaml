<UserControl
    x:Class="WinBoost.App.Views.PerformanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
	
	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource PerformancePageTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                   Text="{DynamicResource PerformancePageDescription}"
                    Margin="0,6,0,0"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- CARDURI METRICE -->

			<UniformGrid
                Grid.Row="1"
                Columns="3"
                Margin="0,25,0,0">

				<!-- CPU -->

				<Border
                    Margin="0,0,12,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                           Text="{DynamicResource PerformanceCpuUsage}"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{Binding CpuUsage}"
                            Margin="0,12,0,0"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
                            Value="{Binding CpuUsageValue}"
                            Maximum="100"
                            Height="8"
                            Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

				<!-- RAM -->

				<Border
                    Margin="6,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource PerformanceRamUsage}"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{Binding RamUsage}"
                            Margin="0,12,0,0"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
                            Value="{Binding RamUsageValue}"
                            Maximum="100"
                            Height="8"
                            Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

				<!-- DISK -->

				<Border
                    Margin="12,0,0,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource PerformanceDiskUsage}"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{Binding DiskUsage}"
                            Margin="0,12,0,0"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
                            Value="{Binding DiskUsageValue}"
                            Maximum="100"
                            Height="8"
                            Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

			</UniformGrid>

			<!-- ZONA DE OPTIMIZARE -->

			<Border
                Grid.Row="2"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- RECOMANDĂRI -->

					<StackPanel Grid.Column="0">


						<TextBlock
							Text="{DynamicResource PerformanceRecommendationsTitle}"
							FontSize="18"
							FontWeight="SemiBold"
							Foreground="{StaticResource TextBrush}"/>
						<ItemsControl
							
                      ItemsSource="{Binding RecommendationItems}"
                      Margin="0,10,0,0">

							<ItemsControl.ItemTemplate>

								<DataTemplate>

									<Grid Margin="0,8">

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>

										<materialDesign:PackIcon
											Grid.Column="0"
											Kind="{Binding Icon}"
											Width="20"
											Height="20"
											Margin="0,1,10,0"
											VerticalAlignment="Top"
											Foreground="{Binding IconBrush}"/>

										<TextBlock
											Grid.Column="1"
											Text="{Binding Text}"
											FontSize="15"
											LineHeight="22"
											TextWrapping="Wrap"
											Foreground="{StaticResource TextBrush}"/>

									</Grid>

								</DataTemplate>

							</ItemsControl.ItemTemplate>

						</ItemsControl>

						<TextBlock
                            Text="{DynamicResource PerformanceOptimizationDescription}"
                            Margin="0,8,0,0"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"/>

						<ItemsControl
                            ItemsSource="{Binding Recommendations}"
                            Margin="0,12,0,0">

							<ItemsControl.ItemTemplate>

								<DataTemplate>

									<CheckBox
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        Margin="0,5,0,0">

										<StackPanel Margin="8,0,0,0">

											<TextBlock
                                                Text="{Binding Title}"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextBrush}"/>

											<TextBlock
                                                Text="{Binding Description}"
                                                Margin="0,3,0,0"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

										</StackPanel>

									</CheckBox>

								</DataTemplate>

							</ItemsControl.ItemTemplate>

						</ItemsControl>

					</StackPanel>

					<!-- BUTOANE -->

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<Button
                              Content="{Binding OptimizationButtonText}"
                              Command="{Binding OptimizeCommand}"
                              Width="190"
                              Height="42"
                              HorizontalContentAlignment="Center"/>

						<Button
                                Content="{Binding ApplyButtonText}"
                                Command="{Binding ApplyOptimizationsCommand}"
                                 Width="190"
                                Height="42"
                                Margin="0,8,0,0"
                                HorizontalContentAlignment="Center"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- TOP PROCESSES -->

			<Border
                Grid.Row="3"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
                        Text="{DynamicResource PerformanceTopProcessesTitle}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="{DynamicResource PerformanceTopProcessesDescription}"
                        Margin="0,5,0,18"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- ANTET -->

					<Grid Margin="0,0,0,8">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="80"/>
							<ColumnDefinition Width="100"/>
							<ColumnDefinition Width="120"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                            Text="{DynamicResource PerformanceColumnProcess}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="1"
                            Text="{DynamicResource PerformanceColumnPid}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="2"
                            Text="{DynamicResource PerformanceColumnCpu}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="3"
                            Text="{DynamicResource PerformanceColumnRam}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</Grid>

					<Border
                        Height="1"
                        Margin="0,0,0,5"
                        Background="#454545"/>

					<!-- LISTA PROCESELOR -->

					<ItemsControl ItemsSource="{Binding TopProcesses}">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Grid Margin="0,7">

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="80"/>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="120"/>
									</Grid.ColumnDefinitions>

									<TextBlock
                                        Text="{Binding Name}"
                                        Foreground="{StaticResource TextBrush}"/>

									<TextBlock
                                        Grid.Column="1"
                                        Text="{Binding ProcessId}"
                                        Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
                                        Grid.Column="2"
                                        Text="{Binding CpuUsageText}"
                                        Foreground="#00C853"/>

									<TextBlock
                                        Grid.Column="3"
                                        Text="{Binding MemoryUsageText}"
                                        Foreground="{StaticResource TextBrush}"/>

								</Grid>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>