<UserControl
    x:Class="WinBoost.App.Views.PerformanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource PerformancePageTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                   Text="{DynamicResource PerformancePageDescription}"
                    Margin="0,6,0,0"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- CARDURI METRICE -->

			<UniformGrid
                Grid.Row="1"
                Columns="4"
                Margin="0,25,0,0">

				<!-- CPU -->

				<Border
                    Margin="0,0,12,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                           Text="{DynamicResource PerformanceCpuUsage}"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{Binding CpuUsage}"
                            Margin="0,12,0,0"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
                            Value="{Binding CpuUsageValue}"
                            Maximum="100"
                            Height="8"
                            Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

				<!-- RAM -->

				<Border
                    Margin="6,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource PerformanceRamUsage}"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{Binding RamUsage}"
                            Margin="0,12,0,0"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
                            Value="{Binding RamUsageValue}"
                            Maximum="100"
                            Height="8"
                            Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

				<!-- DISK -->

				<Border
                    Margin="12,0,0,0"
                    Padding="20"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource PerformanceDiskUsage}"
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{Binding DiskUsage}"
                            Margin="0,12,0,0"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"/>

						<ProgressBar
                            Value="{Binding DiskUsageValue}"
                            Maximum="100"
                            Height="8"
                            Margin="0,15,0,0"/>

					</StackPanel>

				</Border>

				<!-- PERFORMANCE SCORE -->

				<Border
					Margin="12,0,0,0"
					Padding="20"
					CornerRadius="10"
					Background="{StaticResource CardBrush}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource PerformanceAnalyzerScoreTitle}"
							FontSize="16"
							TextWrapping="Wrap"
							Foreground="{StaticResource SecondaryTextBrush}"/>

						<StackPanel
	                        	Margin="0,12,0,0"
	                        	Orientation="Horizontal">

							<TextBlock
								Text="{Binding PerformanceAnalyzerScore,
                                       Mode=OneWay}"
								FontSize="32"
								FontWeight="Bold"
								Foreground="{StaticResource TextBrush}"/>

							<TextBlock
								Text="/100"
								Margin="3,9,0,0"
								FontSize="16"
								Foreground="{StaticResource SecondaryTextBrush}"/>

						</StackPanel>

						<ProgressBar
							Value="{Binding PerformanceAnalyzerScore, Mode=OneWay}"
							Minimum="0"
							Maximum="100"
							Height="8"
							Margin="0,15,0,0"/>

						<TextBlock
                               Text="{Binding PerformanceAnalyzerStatus,
                                     Mode=OneWay}"
                               Margin="0,10,0,0"
                               FontSize="14"
                                 FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

				</Border>

			</UniformGrid>

			<!-- ZONA DE OPTIMIZARE -->

			<Border
				Grid.Row="2"
				Margin="0,25,0,0"
				Padding="22"
				CornerRadius="10"
				Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<!-- RECOMANDĂRI -->

						<StackPanel
							Grid.Column="0">

							<TextBlock
								Text="{DynamicResource PerformanceRecommendationsTitle}"
								FontSize="18"
								FontWeight="SemiBold"
								Foreground="{StaticResource TextBrush}"/>

							<ItemsControl
								ItemsSource="{Binding RecommendationItems}"
								Margin="0,10,0,0">

								<ItemsControl.ItemTemplate>

									<DataTemplate>

										<Grid Margin="0,8">

											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>

											<materialDesign:PackIcon
												Grid.Column="0"
												Kind="{Binding Icon}"
												Width="20"
												Height="20"
												Margin="0,1,10,0"
												VerticalAlignment="Top"
												Foreground="{Binding IconBrush}"/>

											<TextBlock
												Grid.Column="1"
												Text="{Binding Text}"
												FontSize="15"
												LineHeight="22"
												TextWrapping="Wrap"
												Foreground="{StaticResource TextBrush}"/>

										</Grid>

									</DataTemplate>

								</ItemsControl.ItemTemplate>

							</ItemsControl>

							<TextBlock
								Text="{DynamicResource PerformanceOptimizationDescription}"
								Margin="0,8,0,0"
								Foreground="{StaticResource SecondaryTextBrush}"
								TextWrapping="Wrap"/>

							<ItemsControl
								ItemsSource="{Binding Recommendations}"
								Margin="0,12,0,0">

								<ItemsControl.ItemTemplate>

									<DataTemplate>

										<CheckBox
											IsChecked="{Binding IsSelected, Mode=TwoWay}"
											Margin="0,5,0,0">

											<StackPanel Margin="8,0,0,0">

												<TextBlock
													Text="{Binding Title}"
													FontWeight="SemiBold"
													Foreground="{StaticResource TextBrush}"/>

												<TextBlock
													Text="{Binding Description}"
													Margin="0,3,0,0"
													TextWrapping="Wrap"
													Foreground="{StaticResource SecondaryTextBrush}"/>

											</StackPanel>

										</CheckBox>

									</DataTemplate>

								</ItemsControl.ItemTemplate>

							</ItemsControl>

						</StackPanel>

						<!-- BUTOANE -->

						<StackPanel
							Grid.Column="1"
							Margin="20,0,0,0"
							VerticalAlignment="Center">

							<Button
								Content="{Binding OptimizationButtonText}"
								Command="{Binding OptimizeCommand}"
								Width="190"
								Height="42"
								HorizontalContentAlignment="Center"/>

							<Button
								Content="{Binding ApplyButtonText}"
								Command="{Binding ApplyOptimizationsCommand}"
								Width="190"
								Height="42"
								Margin="0,8,0,0"
								HorizontalContentAlignment="Center"/>

						</StackPanel>

					</Grid>

					<!-- PROGRES OPTIMIZARE -->

					<StackPanel
						Grid.Row="1"
						Margin="0,20,0,0">

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Column="0"
								Text="{Binding CurrentOptimizationOperation,
                                   Mode=OneWay}"
								FontSize="14"
								TextWrapping="Wrap"
								Foreground="{StaticResource SecondaryTextBrush}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding OptimizationProgress,
                                   Mode=OneWay,
                                   StringFormat={}{0}%}"
								Margin="15,0,0,0"
								FontSize="14"
								FontWeight="SemiBold"
								Foreground="{StaticResource TextBrush}"/>

						</Grid>

						<ProgressBar
							Value="{Binding OptimizationProgress,
                                Mode=OneWay}"
							Minimum="0"
							Maximum="100"
							Height="10"
							Margin="0,8,0,0"/>

					</StackPanel>

					<TabControl
				Grid.Row="2"
				Margin="0,20,0,0"
				Background="Transparent"
				BorderThickness="0">

						<!-- RAPORT OPTIMIZARE -->

						<TabItem>

							<TabItem.Header>

								<StackPanel
									Orientation="Horizontal"
									Margin="8,4">

									<materialDesign:PackIcon
										Kind="ChartBoxOutline"
										Width="19"
										Height="19"
										Margin="0,0,7,0"
										Foreground="#00C853"/>

									<TextBlock
										Text="{DynamicResource OptimizationReportTitle}"
										FontWeight="SemiBold"/>

								</StackPanel>

							</TabItem.Header>

							<Border
								Padding="20"
								CornerRadius="10"
								Background="#2A2D31">

								<UniformGrid
									Columns="3"
									Rows="2">

									<!-- SPAȚIU RECUPERAT -->

									<Border
										Margin="0,0,10,10"
										Padding="14"
										CornerRadius="8"
										Background="#24272B">

										<StackPanel>

											<StackPanel Orientation="Horizontal">

												<materialDesign:PackIcon
													Kind="Broom"
													Width="18"
													Height="18"
													Margin="0,0,7,0"
													Foreground="#00C853"/>

												<TextBlock
													Text="{DynamicResource OptimizationRecoveredSpace}"
													TextWrapping="Wrap"
													Foreground="#B8BCC4"/>

											</StackPanel>

											<TextBlock
												Text="{Binding OptimizationSummaryViewModel.Summary.RecoveredSpaceText}"
												Margin="25,6,0,0"
												FontSize="20"
												FontWeight="Bold"
												Foreground="White"/>

										</StackPanel>

									</Border>

									<!-- FIȘIERE ȘTERSE -->

									<Border
										Margin="5,0,5,10"
										Padding="14"
										CornerRadius="8"
										Background="#24272B">

										<StackPanel>

											<StackPanel Orientation="Horizontal">

												<materialDesign:PackIcon
													Kind="FileRemoveOutline"
													Width="18"
													Height="18"
													Margin="0,0,7,0"
													Foreground="#42A5F5"/>

												<TextBlock
													Text="{DynamicResource OptimizationDeletedFiles}"
													TextWrapping="Wrap"
													Foreground="#B8BCC4"/>

											</StackPanel>

											<TextBlock
												Text="{Binding OptimizationSummaryViewModel.Summary.DeletedFilesText}"
												Margin="25,6,0,0"
												FontSize="20"
												FontWeight="Bold"
												Foreground="White"/>

										</StackPanel>

									</Border>

									<!-- DURATĂ -->

									<Border
										Margin="10,0,0,10"
										Padding="14"
										CornerRadius="8"
										Background="#24272B">

										<StackPanel>

											<StackPanel Orientation="Horizontal">

												<materialDesign:PackIcon
													Kind="TimerOutline"
													Width="18"
													Height="18"
													Margin="0,0,7,0"
													Foreground="#AB47BC"/>

												<TextBlock
													Text="{DynamicResource OptimizationDuration}"
													Foreground="#B8BCC4"/>

											</StackPanel>

											<TextBlock
												Text="{Binding OptimizationSummaryViewModel.Summary.DurationText}"
												Margin="25,6,0,0"
												FontSize="20"
												FontWeight="Bold"
												Foreground="White"/>

										</StackPanel>

									</Border>

									<!-- REUȘITE -->

									<Border
										Margin="0,5,10,0"
										Padding="14"
										CornerRadius="8"
										Background="#24272B">

										<StackPanel>

											<StackPanel Orientation="Horizontal">

												<materialDesign:PackIcon
													Kind="CheckCircle"
													Width="18"
													Height="18"
													Margin="0,0,7,0"
													Foreground="#00C853"/>

												<TextBlock
													Text="{DynamicResource OptimizationSuccessfulOperations}"
													TextWrapping="Wrap"
													Foreground="#B8BCC4"/>

											</StackPanel>

											<TextBlock
												Text="{Binding OptimizationSummaryViewModel.Summary.SuccessfulOperations}"
												Margin="25,6,0,0"
												FontSize="20"
												FontWeight="Bold"
												Foreground="#00C853"/>

										</StackPanel>

									</Border>

									<!-- EȘUATE -->

									<Border
										Margin="5,5,5,0"
										Padding="14"
										CornerRadius="8"
										Background="#24272B">

										<StackPanel>

											<StackPanel Orientation="Horizontal">

												<materialDesign:PackIcon
													Kind="CloseCircle"
													Width="18"
													Height="18"
													Margin="0,0,7,0"
													Foreground="#FF5252"/>

												<TextBlock
													Text="{DynamicResource OptimizationFailedOperations}"
													TextWrapping="Wrap"
													Foreground="#B8BCC4"/>

											</StackPanel>

											<TextBlock
												Text="{Binding OptimizationSummaryViewModel.Summary.FailedOperations}"
												Margin="25,6,0,0"
												FontSize="20"
												FontWeight="Bold"
												Foreground="#FF5252"/>

										</StackPanel>

									</Border>

									<!-- OMISE -->

									<Border
										Margin="10,5,0,0"
										Padding="14"
										CornerRadius="8"
										Background="#24272B">

										<StackPanel>

											<StackPanel Orientation="Horizontal">

												<materialDesign:PackIcon
													Kind="SkipNextCircleOutline"
													Width="18"
													Height="18"
													Margin="0,0,7,0"
													Foreground="#FFC107"/>

												<TextBlock
													Text="{DynamicResource OptimizationSkippedOperations}"
													TextWrapping="Wrap"
													Foreground="#B8BCC4"/>

											</StackPanel>

											<TextBlock
												Text="{Binding OptimizationSummaryViewModel.Summary.SkippedOperations}"
												Margin="25,6,0,0"
												FontSize="20"
												FontWeight="Bold"
												Foreground="#FFC107"/>

										</StackPanel>

									</Border>

								</UniformGrid>

							</Border>

						</TabItem>

						<!-- ISTORIC OPTIMIZĂRI -->

						<TabItem>

							<TabItem.Header>

								<StackPanel
									Orientation="Horizontal"
									Margin="8,4">

									<materialDesign:PackIcon
										Kind="History"
										Width="19"
										Height="19"
										Margin="0,0,7,0"
										Foreground="#42A5F5"/>

									<TextBlock
                                         Text="{DynamicResource OptimizationHistoryTab}"
                                         FontWeight="SemiBold"/>

								</StackPanel>

							</TabItem.Header>

							<Border
								Padding="20"
								CornerRadius="10"
								Background="#2A2D31">

								<StackPanel>

									<Grid Margin="0,0,0,15">

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<TextBlock
											Grid.Column="0"
											Text="{DynamicResource OptimizationHistoryTitle}"
											FontSize="18"
											FontWeight="SemiBold"
											Foreground="White"/>

										<Button
											Grid.Column="1"
											Content="{DynamicResource OptimizationHistoryClear}"
											Command="{Binding OptimizationHistoryViewModel.ClearHistoryCommand}"
											Padding="14,6"
											Margin="15,0,0,0"/>

									</Grid>

									<ItemsControl
										ItemsSource="{Binding OptimizationHistoryViewModel.Entries}">

										<ItemsControl.ItemTemplate>

											<DataTemplate>

												<Border
													Margin="0,0,0,10"
													Padding="16"
													CornerRadius="8"
													Background="#24272B">

													<Grid>

														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="180"/>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="*"/>
														</Grid.ColumnDefinitions>

														<!-- DATA ȘI STATUS -->

														<StackPanel Grid.Column="0">

															<TextBlock
																Text="{Binding CompletedAtText}"
																FontWeight="SemiBold"
																FontSize="15"
																Foreground="White"/>

															<Border
																Margin="0,8,0,0"
																Padding="8,3"
																CornerRadius="12"
																HorizontalAlignment="Left"
																Background="#103F1F">

																<StackPanel Orientation="Horizontal">

																	<materialDesign:PackIcon
																		Kind="CheckCircle"
																		Width="14"
																		Height="14"
																		Margin="0,0,5,0"
																		Foreground="#00E676"/>

																	<TextBlock
																		Text="{Binding StatusText}"
																		FontSize="12"
																		FontWeight="SemiBold"
																		Foreground="#00E676"/>

																</StackPanel>

															</Border>

														</StackPanel>

														<!-- SPAȚIU -->

														<StackPanel Grid.Column="1">

															<TextBlock
																Text="{DynamicResource OptimizationRecoveredSpace}"
																Foreground="#B8BCC4"/>

															<TextBlock
																Text="{Binding RecoveredSpaceText}"
																Margin="0,4,0,0"
																FontWeight="Bold"
																Foreground="White"/>

														</StackPanel>

														<!-- FIȘIERE ȘTERSE -->

														<StackPanel Grid.Column="2">

															<TextBlock
																Text="{DynamicResource OptimizationDeletedFiles}"
																Foreground="#B8BCC4"/>

															<TextBlock
																Text="{Binding DeletedFilesText}"
																Margin="0,4,0,0"
																FontWeight="Bold"
																Foreground="White"/>

														</StackPanel>

														<!-- DURATĂ ȘI OPERAȚII -->

														<StackPanel Grid.Column="3">

															<TextBlock
																Text="{Binding DurationText}"
																FontWeight="Bold"
																Foreground="White"/>

															<TextBlock
																Text="{Binding OperationsText}"
																Margin="0,5,0,0"
																TextWrapping="Wrap"
																Foreground="#B8BCC4"/>

														</StackPanel>

													</Grid>

												</Border>

											</DataTemplate>

										</ItemsControl.ItemTemplate>

									</ItemsControl>

								</StackPanel>

							</Border>

						</TabItem>

					</TabControl>
				</Grid>

			</Border>

			<!-- TOP PROCESSES -->

			<Border
                Grid.Row="3"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
                        Text="{DynamicResource PerformanceTopProcessesTitle}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="{DynamicResource PerformanceTopProcessesDescription}"
                        Margin="0,5,0,18"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- ANTET -->

					<Grid Margin="0,0,0,8">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="80"/>
							<ColumnDefinition Width="100"/>
							<ColumnDefinition Width="120"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                            Text="{DynamicResource PerformanceColumnProcess}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="1"
                            Text="{DynamicResource PerformanceColumnPid}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="2"
                            Text="{DynamicResource PerformanceColumnCpu}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="3"
                            Text="{DynamicResource PerformanceColumnRam}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</Grid>

					<Border
                        Height="1"
                        Margin="0,0,0,5"
                        Background="#454545"/>

					<!-- LISTA PROCESELOR -->

					<ItemsControl ItemsSource="{Binding TopProcesses}">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Grid Margin="0,7">

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="80"/>
										<ColumnDefinition Width="100"/>
										<ColumnDefinition Width="120"/>
									</Grid.ColumnDefinitions>

									<TextBlock
                                        Text="{Binding Name}"
                                        Foreground="{StaticResource TextBrush}"/>

									<TextBlock
                                        Grid.Column="1"
                                        Text="{Binding ProcessId}"
                                        Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
                                        Grid.Column="2"
                                        Text="{Binding CpuUsageText}"
                                        Foreground="#00C853"/>

									<TextBlock
                                        Grid.Column="3"
                                        Text="{Binding MemoryUsageText}"
                                        Foreground="{StaticResource TextBrush}"/>

								</Grid>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>