<UserControl x:Class="WinBoost.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:controls="clr-namespace:WinBoost.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

	<Grid Background="#1E1E1E">

		<TextBlock
            Text="Dashboard"
            FontSize="32"
            FontWeight="Bold"
            Foreground="White"
            Margin="30,20,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"/>

		<UniformGrid
			Rows="2"
			Columns="2"
			Margin="30,90,30,30">


			<!-- CPU -->
			<controls:MetricCard
				Title="CPU Usage"
				Value="{Binding CpuUsage}"
				Status="{Binding CpuStatus}"
				ProgressValue="{Binding CpuUsageValue}"
				Margin="10"/>

			<!-- RAM -->
			<controls:MetricCard
				Title="RAM Usage"
				Value="{Binding RamUsage}"
				Status="{Binding RamDetails}"
				ProgressValue="{Binding RamUsageValue}"
				Margin="10"/>

			<!-- DISK -->
			<controls:MetricCard
				Title="Disk Usage"
				Value="{Binding DiskUsage}"
				Status=""
				ProgressValue="{Binding DiskUsageValue}"
				Margin="10"/>
			
		<!-- UPTIME -->
			<Border
		Margin="10"
		Background="#2C2C2C"
		CornerRadius="12">

			<StackPanel Margin="15">

				<TextBlock
                    Text="Windows Uptime"
                    FontSize="18"
                    Foreground="White"/>

				<TextBlock
                    Text="{Binding Uptime}"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="{StaticResource AccentBrush}"
                    Margin="0,14,0,0"/>

			</StackPanel>

		</Border>
		</UniformGrid>
	</Grid>

</UserControl>