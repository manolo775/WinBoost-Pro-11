<UserControl
    x:Class="WinBoost.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:WinBoost.App.Controls"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="900">

	<ScrollViewer
        Style="{StaticResource WinBoostPageScrollViewerStyle}"
        HorizontalScrollBarVisibility="Disabled">

		<Grid
            Margin="0,0,0,10"
            Background="#1E1E1E">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<TextBlock
                Grid.Row="0"
                Text="Dashboard"
                Margin="40,20,40,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="32"
                FontWeight="Bold"
                Foreground="White"/>

			<!-- ALERTĂ DE PERFORMANȚĂ -->

			      <controls:PerformanceAlertCard
		              Grid.Row="1"
		             DetailsRequested="PerformanceAlertCard_DetailsRequested"/>
			<!-- SYSTEM HEALTH -->

			<controls:HealthCard
		            Grid.Row="2"
		            Margin="50,25,50,5"
		            PerformanceRequested="HealthCard_PerformanceRequested"
		            ServicesRequested="HealthCard_ServicesRequested"
		            StartupRequested="HealthCard_StartupRequested"
		            PrivacyRequested="HealthCard_PrivacyRequested"
		            WindowsUpdateRequested="HealthCard_WindowsUpdateRequested"/>

			<!-- SYSTEM SUMMARY -->

			<controls:SystemSummaryCard
                Grid.Row="3"/>

			<!-- CARDURI SISTEM -->

			<UniformGrid
                Grid.Row="4"
                Rows="2"
                Columns="2"
                Margin="40,10,40,10">

				<controls:MetricCard
                    IconKind="Cpu64Bit"
                    Title="{DynamicResource DashboardMetricCpuTitle}"
                    Value="{Binding CpuUsage}"
                    Status="{Binding CpuStatus}"
                    ProgressValue="{Binding CpuUsageValue}"
					IsClickable="True"
                    Click="PerformanceMetricCard_Click"
                    ToolTip="{DynamicResource DashboardOpenPerformanceDetails}"
                    Margin="10"/>

				<controls:MetricCard
                    IconKind="Memory"
                    Title="{DynamicResource DashboardMetricRamTitle}"
                    Value="{Binding RamUsage}"
                    Subtitle="{Binding RamDetails}"
                    Status=""
                    ProgressValue="{Binding RamUsageValue}"
					IsClickable="True"
                    Click="PerformanceMetricCard_Click"
                    ToolTip="{DynamicResource DashboardOpenPerformanceDetails}"
                    Margin="10"/>

				<controls:MetricCard
                    IconKind="Harddisk"
                    Title="{DynamicResource DashboardMetricDiskTitle}"
                    Value="{Binding DiskUsage}"
                    Status=""
                    ProgressValue="{Binding DiskUsageValue}"
					IsClickable="True"
                    Click="PerformanceMetricCard_Click"
                    ToolTip="{DynamicResource DashboardOpenPerformanceDetails}"
                    Margin="10"/>

				<controls:MetricCard
                    IconKind="ClockOutline"
                    Title="{DynamicResource DashboardMetricUptimeTitle}"
                    Value="{Binding Uptime}"
                    Subtitle=""
                    Status=""
                    ProgressValue="0"
                    ShowProgressBar="False"
                    Margin="10"/>

			</UniformGrid>

			<!-- ISTORIC PERFORMANȚĂ -->

			<controls:MetricsHistoryChart
                Grid.Row="5"
                ItemsSource="{Binding DisplayedMetricsHistory}"/>

			<!-- ANALIZA PERFORMANȚEI -->

			<controls:PerformanceAnalysisCard
                Grid.Row="6"/>

			<!-- QUICK ACTIONS -->

			<controls:QuickActionsControl
                Grid.Row="7"
                Margin="50,15,50,15"/>

		</Grid>

	</ScrollViewer>

</UserControl>