<UserControl x:Class="WinBoost.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:controls="clr-namespace:WinBoost.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

	<Grid Background="#1E1E1E">

		<TextBlock
            Text="Dashboard"
            FontSize="32"
            FontWeight="Bold"
            Foreground="White"
            Margin="30,20,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"/>

		<UniformGrid
			Rows="2"
			Columns="2"
			Margin="40,100,40,40">


			<controls:MetricCard
               IconKind="Cpu64Bit"
               Title="CPU Usage"
               Value="{Binding CpuUsage}"
               Status="{Binding CpuStatus}"
               ProgressValue="{Binding CpuUsageValue}"
               Margin="10"/>

			<controls:MetricCard
		     	IconKind="Memory"
			    Title="RAM Usage"
			    Value="{Binding RamUsage}"
			    Subtitle="{Binding RamDetails}"
			    Status=""
			    ProgressValue="{Binding RamUsageValue}"
			    Margin="10"/>

			<controls:MetricCard
		        IconKind="Harddisk"
		        Title="Disk Usage"
		        Value="{Binding DiskUsage}"
		        Status=""
	        	ProgressValue="{Binding DiskUsageValue}"
	        	Margin="10"/>

			<controls:MetricCard
				Title="Windows Uptime"
				Value="{Binding Uptime}"
				IconKind="ClockOutline"
				ProgressValue="0"
				ShowProgressBar="False"
				Subtitle=""
				Status=""/>
			
		</UniformGrid>
	</Grid>

</UserControl>