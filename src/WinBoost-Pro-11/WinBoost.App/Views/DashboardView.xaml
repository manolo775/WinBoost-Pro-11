<UserControl x:Class="WinBoost.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:WinBoost.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

	<Grid Background="#1E1E1E">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Titlu -->
		<TextBlock
            Grid.Row="0"
            Text="Dashboard"
            FontSize="32"
            FontWeight="Bold"
            Foreground="White"
            Margin="40,20,40,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"/>

		<!-- System Health -->
		<Border
            Grid.Row="1"
            Margin="50,25,50,5"
            Padding="22,16"
            Background="#2D3035"
            CornerRadius="14">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Partea stângă -->
				<StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center">

					<TextBlock
                        Text="Overall System Health"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"/>

					<TextBlock
                        Text="{Binding HealthStatus}"
                        Margin="0,5,0,0"
                        FontSize="14"
                        Foreground="#B8BCC4"/>

					<ProgressBar
                        Value="{Binding HealthScore}"
                        Maximum="100"
                        Height="8"
                        Margin="0,14,30,0"
                        Background="#505257"
                        Foreground="#00C853"/>
				</StackPanel>

				<!-- Scorul -->
				<StackPanel
                    Grid.Column="1"
                    Margin="20,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

					<TextBlock
                        Text="{Binding HealthScore}"
                        FontSize="38"
                        FontWeight="Bold"
                        Foreground="#00D66B"
                        HorizontalAlignment="Center"/>

					<TextBlock
                        Text="/ 100"
                        Margin="0,-5,0,0"
                        FontSize="14"
                        Foreground="#B8BCC4"
                        HorizontalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Cardurile cu valori -->
		<UniformGrid
            Grid.Row="2"
            Rows="2"
            Columns="2"
            Margin="40,10,40,30">

			<controls:MetricCard
                IconKind="Cpu64Bit"
                Title="CPU Usage"
                Value="{Binding CpuUsage}"
                Status="{Binding CpuStatus}"
                ProgressValue="{Binding CpuUsageValue}"
                Margin="10"/>

			<controls:MetricCard
                IconKind="Memory"
                Title="RAM Usage"
                Value="{Binding RamUsage}"
                Subtitle="{Binding RamDetails}"
                Status=""
                ProgressValue="{Binding RamUsageValue}"
                Margin="10"/>

			<controls:MetricCard
                IconKind="Harddisk"
                Title="Disk Usage"
                Value="{Binding DiskUsage}"
                Status=""
                ProgressValue="{Binding DiskUsageValue}"
                Margin="10"/>

			<controls:MetricCard
                IconKind="ClockOutline"
                Title="Windows Uptime"
                Value="{Binding Uptime}"
                Subtitle=""
                Status=""
                ProgressValue="0"
                ShowProgressBar="False"
                Margin="10"/>

		</UniformGrid>

	</Grid>

</UserControl>