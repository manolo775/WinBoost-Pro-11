<UserControl
    x:Class="WinBoost.App.Views.ServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="Auto"/>

			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource ServicesPageTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="{DynamicResource ServicesPageDescription}"
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU SCANARE -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource ServicesCheckTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="{Binding ScanMessage,
                                           FallbackValue='Apasă Scan Services pentru verificare.'}"
                            Margin="0,8,20,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{DynamicResource ServicesScanInformation}"
                            Margin="0,6,20,0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<!-- BADGE STARE -->

						<Border
                            Padding="12,7"
                            CornerRadius="6"
                            HorizontalAlignment="Center">

							<Border.Style>

								<Style TargetType="Border">

									<Setter
                                        Property="Background"
                                        Value="#3A3A3A"/>

									<Style.Triggers>

										<DataTrigger
                                            Binding="{Binding ScanStatus}"
                                            Value="Verificat">

											<Setter
                                                Property="Background"
                                                Value="#233D2A"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanStatus}"
                                            Value="Se verifică">

											<Setter
                                                Property="Background"
                                                Value="#4A3D22"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanStatus}"
                                            Value="Eroare">

											<Setter
                                                Property="Background"
                                                Value="#4A2525"/>

										</DataTrigger>

									</Style.Triggers>

								</Style>

							</Border.Style>

							<TextBlock
                                Text="{Binding ScanStatus,
                                               FallbackValue=Neverificat}">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
                                            Property="Foreground"
                                            Value="{StaticResource SecondaryTextBrush}"/>

										<Style.Triggers>

											<DataTrigger
                                                Binding="{Binding ScanStatus}"
                                                Value="Verificat">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanStatus}"
                                                Value="Se verifică">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FFB300"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanStatus}"
                                                Value="Eroare">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FF5252"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>

						</Border>

						<!-- BUTON SCANARE -->

						<Button
                            Content="{DynamicResource ServicesScanButton}"
                            Command="{Binding ScanServicesCommand}"
                            Width="150"
                            Height="42"
                            Margin="0,10,0,0"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- SERVICES HEALTH -->

			<Border
				Grid.Row="2"
				Margin="0,25,0,0"
				Padding="22"
				CornerRadius="10"
				Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
						Text="Services Health"
						FontSize="20"
						FontWeight="SemiBold"
						Foreground="{StaticResource TextBrush}"/>

					<TextBlock
						Text="Rezumatul serviciilor Windows identificate în urma scanării."
						Margin="0,6,0,18"
						TextWrapping="Wrap"
						Foreground="{StaticResource SecondaryTextBrush}"/>

					<UniformGrid Columns="6">

						<Border
							Margin="4"
							Padding="14"
							CornerRadius="8"
							Background="#303030">

							<StackPanel>

								<TextBlock
									Text="Total"
									HorizontalAlignment="Center"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock
									Text="{Binding ServicesHealth.TotalServices,
                                       Mode=OneWay}"
									Margin="0,6,0,0"
									HorizontalAlignment="Center"
									FontSize="22"
									FontWeight="Bold"
									Foreground="White"/>

							</StackPanel>

						</Border>

						<Border
							Margin="4"
							Padding="14"
							CornerRadius="8"
							Background="#303030">

							<StackPanel>

								<TextBlock
									Text="Active"
									HorizontalAlignment="Center"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock
									Text="{Binding ServicesHealth.RunningServices,
                                       Mode=OneWay}"
									Margin="0,6,0,0"
									HorizontalAlignment="Center"
									FontSize="22"
									FontWeight="Bold"
									Foreground="#00C853"/>

							</StackPanel>

						</Border>

						<Border
							Margin="4"
							Padding="14"
							CornerRadius="8"
							Background="#303030">

							<StackPanel>

								<TextBlock
									Text="Critice"
									HorizontalAlignment="Center"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock
									Text="{Binding ServicesHealth.CriticalServices,
                                       Mode=OneWay}"
									Margin="0,6,0,0"
									HorizontalAlignment="Center"
									FontSize="22"
									FontWeight="Bold"
									Foreground="#FF5252"/>

							</StackPanel>

						</Border>

						<Border
							Margin="4"
							Padding="14"
							CornerRadius="8"
							Background="#303030">

							<StackPanel>

								<TextBlock
									Text="Recomandate"
									HorizontalAlignment="Center"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock
									Text="{Binding ServicesHealth.RecommendedServices,
                                       Mode=OneWay}"
									Margin="0,6,0,0"
									HorizontalAlignment="Center"
									FontSize="22"
									FontWeight="Bold"
									Foreground="#FFB300"/>

							</StackPanel>

						</Border>

						<Border
							Margin="4"
							Padding="14"
							CornerRadius="8"
							Background="#303030">

							<StackPanel>

								<TextBlock
									Text="Sigure"
									HorizontalAlignment="Center"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock
									Text="{Binding ServicesHealth.SafeToOptimizeServices,
                                       Mode=OneWay}"
									Margin="0,6,0,0"
									HorizontalAlignment="Center"
									FontSize="22"
									FontWeight="Bold"
									Foreground="#35C759"/>

							</StackPanel>

						</Border>

						<Border
							Margin="4"
							Padding="14"
							CornerRadius="8"
							Background="#303030">

							<StackPanel>

								<TextBlock
									Text="Câștig estimat"
									HorizontalAlignment="Center"
									TextAlignment="Center"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<TextBlock
									Text="{Binding ServicesHealth.EstimatedHealthGainText,
                                       Mode=OneWay}"
									Margin="0,6,0,0"
									HorizontalAlignment="Center"
									TextAlignment="Center"
									FontSize="18"
									FontWeight="Bold"
									Foreground="#35C759"/>

							</StackPanel>

						</Border>

					</UniformGrid>

					<Border
    Margin="4,18,4,0"
    Padding="18"
    CornerRadius="8"
    Background="#315A39"
    BorderBrush="#3F7249"
    BorderThickness="1">

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Column="0"
								Text="⚡"
								Margin="0,0,14,0"
								FontSize="22"
								VerticalAlignment="Center"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding HealthInsight}"
								FontSize="15"
								FontWeight="SemiBold"
								LineHeight="22"
								TextWrapping="Wrap"
								VerticalAlignment="Center"
								Foreground="White"/>

						</Grid>

					</Border>

				</StackPanel>

			</Border>
			<!-- LISTA SERVICIILOR -->

			<Border
                Grid.Row="3"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
                        Text="Servicii analizate"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="Aici vor apărea serviciile identificate în urma scanării."
                        Margin="0,5,0,18"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- CĂUTARE ȘI FILTRU -->

					<Grid Margin="0,0,0,18">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="200"/>
						</Grid.ColumnDefinitions>

						<TextBox
                            Grid.Column="0"
                            Text="{Binding SearchText,
                                           UpdateSourceTrigger=PropertyChanged}"
                            Height="38"
                            Margin="0,0,12,0"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            Foreground="{StaticResource TextBrush}"
                            Background="#2A2A2A"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            ToolTip="Caută după numele serviciului sau numele intern"/>

						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding AvailableFilters}"
							SelectedItem="{Binding SelectedFilter,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}"
							Height="38"
							Padding="10,0"
							VerticalContentAlignment="Center"
							FontSize="14"
							Foreground="Black"
							Background="White"
							BorderBrush="#4A4A4A"
							BorderThickness="1"/>

					</Grid>

					<!-- ANTET -->

					<Grid Margin="0,0,0,8">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="90"/>
							<ColumnDefinition Width="215"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                            Grid.Column="0"
                            Text="Serviciu"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="1"
                            Text="Stare"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="2"
                            Text="Pornire"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="3"
                            Text="Recomandare"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<Border
    Grid.Column="4"
    Width="62"
    Height="32"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    CornerRadius="16"
    Background="#252525"
    BorderBrush="{Binding HealthScoreBrush}"
    BorderThickness="1">

							<TextBlock
								Text="{Binding HealthScoreText}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontWeight="SemiBold"
								Foreground="{Binding HealthScoreBrush}"/>

						</Border>
						
						<TextBlock
                             Grid.Column="4"
                             Text="Health"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             Foreground="{StaticResource SecondaryTextBrush}"/>
						
						<TextBlock
                             Grid.Column="5"
                             Text="Acțiuni"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource SecondaryTextBrush}"/>
					</Grid>

					<Border
                        Height="1"
                        Margin="0,0,0,5"
                        Background="#454545"/>

					<!-- SERVICII -->

					<ItemsControl
				
                          ItemsSource="{Binding Services}">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Border
									Margin="0,5"
									Padding="12"
									CornerRadius="6"
									Background="#303030">

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="2*"/>
											<ColumnDefinition Width="90"/>
											<ColumnDefinition Width="215"/>
										</Grid.ColumnDefinitions>

										<!-- SERVICIU -->

										<StackPanel Grid.Column="0">

											<TextBlock
												Text="{Binding DisplayName}"
												FontWeight="SemiBold"
												TextWrapping="Wrap"
												Foreground="{StaticResource TextBrush}"/>

											<TextBlock
												Text="{Binding ServiceName}"
												Margin="0,3,0,0"
												FontSize="12"
												TextWrapping="Wrap"
												Foreground="{StaticResource SecondaryTextBrush}"/>

										</StackPanel>

										<!-- STARE -->

										<TextBlock
											Grid.Column="1"
											Text="{Binding Status}"
											Margin="6,0"
											VerticalAlignment="Center"
											TextWrapping="Wrap"
											Foreground="{Binding StatusBrush}"/>

										<!-- TIP PORNIRE -->

										<TextBlock
											Grid.Column="2"
											Text="{Binding StartType}"
											Margin="6,0"
											VerticalAlignment="Center"
											TextWrapping="Wrap"
											Foreground="{StaticResource SecondaryTextBrush}"/>

										<!-- RECOMANDARE -->

										<Border
											Grid.Column="3"
											Margin="6,0"
											Padding="10,5"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											CornerRadius="6"
											Background="#252525"
											BorderBrush="{Binding RecommendationBrush}"
											BorderThickness="1">

											<TextBlock
												Text="{Binding Recommendation}"
												Foreground="{Binding RecommendationBrush}"
												FontWeight="SemiBold"
												TextWrapping="Wrap"/>

										</Border>

										<!-- HEALTH SCORE -->

										<Border
											Grid.Column="4"
											Width="62"
											Height="30"
											Margin="4,0"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											CornerRadius="15"
											Background="#252525"
											BorderBrush="{Binding HealthScoreBrush}"
											BorderThickness="1">

											<TextBlock
												Text="{Binding HealthScoreText}"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												FontWeight="SemiBold"
												Foreground="{Binding HealthScoreBrush}"/>

										</Border>

										<!-- ACȚIUNI -->

										<StackPanel
											Grid.Column="5"
											Orientation="Horizontal"
											HorizontalAlignment="Center"
											VerticalAlignment="Center">

											<!-- START -->

											<Button
												Width="62"
												Height="34"
												Margin="2"
												Padding="0"
												Foreground="White"
												BorderBrush="#2E9B43"
												BorderThickness="1"
												Command="{Binding DataContext.StartServiceCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}"
												IsEnabled="{Binding CanStart}">

												<Button.Style>

													<Style TargetType="Button">

														<Setter
															Property="Background"
															Value="#1E5E2B"/>

														<Setter Property="Template">

															<Setter.Value>

																<ControlTemplate TargetType="Button">

																	<Border
																		x:Name="StartBorder"
																		Background="{TemplateBinding Background}"
																		BorderBrush="{TemplateBinding BorderBrush}"
																		BorderThickness="{TemplateBinding BorderThickness}"
																		CornerRadius="5">

																		<ContentPresenter
																			HorizontalAlignment="Center"
																			VerticalAlignment="Center"/>

																	</Border>

																	<ControlTemplate.Triggers>

																		<Trigger
																			Property="IsMouseOver"
																			Value="True">

																			<Setter
																				TargetName="StartBorder"
																				Property="Background"
																				Value="#287A39"/>

																		</Trigger>

																		<Trigger
																			Property="IsPressed"
																			Value="True">

																			<Setter
																				TargetName="StartBorder"
																				Property="Background"
																				Value="#174A22"/>

																		</Trigger>

																		<Trigger
																			Property="IsEnabled"
																			Value="False">

																			<Setter
																				TargetName="StartBorder"
																				Property="Opacity"
																				Value="0.35"/>

																		</Trigger>

																	</ControlTemplate.Triggers>

																</ControlTemplate>

															</Setter.Value>

														</Setter>

													</Style>

												</Button.Style>

												<StackPanel
													Orientation="Horizontal"
													HorizontalAlignment="Center">

													<TextBlock
														Text="▶"
														Margin="0,0,5,0"
														VerticalAlignment="Center"/>

													<TextBlock
														Text="Start"
														VerticalAlignment="Center"/>

												</StackPanel>

											</Button>

											<!-- STOP -->

											<Button
												Width="62"
												Height="34"
												Margin="2"
												Padding="0"
												Foreground="White"
												BorderBrush="#B13A3A"
												BorderThickness="1"
												Command="{Binding DataContext.StopServiceCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}"
												IsEnabled="{Binding CanStop}">

												<Button.Style>

													<Style TargetType="Button">

														<Setter
															Property="Background"
															Value="#5F2222"/>

														<Setter Property="Template">

															<Setter.Value>

																<ControlTemplate TargetType="Button">

																	<Border
																		x:Name="StopBorder"
																		Background="{TemplateBinding Background}"
																		BorderBrush="{TemplateBinding BorderBrush}"
																		BorderThickness="{TemplateBinding BorderThickness}"
																		CornerRadius="5">

																		<ContentPresenter
																			HorizontalAlignment="Center"
																			VerticalAlignment="Center"/>

																	</Border>

																	<ControlTemplate.Triggers>

																		<Trigger
																			Property="IsMouseOver"
																			Value="True">

																			<Setter
																				TargetName="StopBorder"
																				Property="Background"
																				Value="#7A2B2B"/>

																		</Trigger>

																		<Trigger
																			Property="IsPressed"
																			Value="True">

																			<Setter
																				TargetName="StopBorder"
																				Property="Background"
																				Value="#481919"/>

																		</Trigger>

																		<Trigger
																			Property="IsEnabled"
																			Value="False">

																			<Setter
																				TargetName="StopBorder"
																				Property="Opacity"
																				Value="0.35"/>

																		</Trigger>

																	</ControlTemplate.Triggers>

																</ControlTemplate>

															</Setter.Value>

														</Setter>

													</Style>

												</Button.Style>

												<StackPanel
													Orientation="Horizontal"
													HorizontalAlignment="Center">

													<TextBlock
														Text="■"
														Margin="0,0,5,0"
														VerticalAlignment="Center"/>

													<TextBlock
														Text="Stop"
														VerticalAlignment="Center"/>

												</StackPanel>

											</Button>

											<!-- RESTART -->

											<Button
												Width="76"
												Height="34"
												Margin="2"
												Padding="0"
												Foreground="White"
												BorderBrush="#3577A8"
												BorderThickness="1"
												Command="{Binding DataContext.RestartServiceCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}"
												IsEnabled="{Binding CanRestart}">

												<Button.Style>

													<Style TargetType="Button">

														<Setter
															Property="Background"
															Value="#234B68"/>

														<Setter Property="Template">

															<Setter.Value>

																<ControlTemplate TargetType="Button">

																	<Border
																		x:Name="RestartBorder"
																		Background="{TemplateBinding Background}"
																		BorderBrush="{TemplateBinding BorderBrush}"
																		BorderThickness="{TemplateBinding BorderThickness}"
																		CornerRadius="5">

																		<ContentPresenter
																			HorizontalAlignment="Center"
																			VerticalAlignment="Center"/>

																	</Border>

																	<ControlTemplate.Triggers>

																		<Trigger
																			Property="IsMouseOver"
																			Value="True">

																			<Setter
																				TargetName="RestartBorder"
																				Property="Background"
																				Value="#2F668E"/>

																		</Trigger>

																		<Trigger
																			Property="IsPressed"
																			Value="True">

																			<Setter
																				TargetName="RestartBorder"
																				Property="Background"
																				Value="#18364C"/>

																		</Trigger>

																		<Trigger
																			Property="IsEnabled"
																			Value="False">

																			<Setter
																				TargetName="RestartBorder"
																				Property="Opacity"
																				Value="0.35"/>

																		</Trigger>

																	</ControlTemplate.Triggers>

																</ControlTemplate>

															</Setter.Value>

														</Setter>

													</Style>

												</Button.Style>

												<StackPanel
													Orientation="Horizontal"
													HorizontalAlignment="Center">

													<TextBlock
														Text="↻"
														Margin="0,0,5,0"
														VerticalAlignment="Center"/>

													<TextBlock
														Text="Restart"
														VerticalAlignment="Center"/>

												</StackPanel>

											</Button>

										</StackPanel>

									</Grid>

								</Border>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>