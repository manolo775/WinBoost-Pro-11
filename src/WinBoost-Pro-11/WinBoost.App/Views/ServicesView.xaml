<UserControl
    x:Class="WinBoost.App.Views.ServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


	<UserControl.Resources>

		<!-- Bară orizontală mai vizibilă pentru modulul Services. -->
		<Style
            x:Key="ServicesHorizontalScrollBarStyle"
            TargetType="ScrollBar">

			<Setter Property="Orientation" Value="Horizontal"/>
			<Setter Property="Height" Value="16"/>
			<Setter Property="MinWidth" Value="100"/>
			<Setter Property="Background" Value="#171A1E"/>
			<Setter Property="BorderBrush" Value="#424850"/>
			<Setter Property="BorderThickness" Value="1"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollBar">

						<Border
                            Height="{TemplateBinding Height}"
                            CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

							<Track
                                x:Name="PART_Track"
                                Margin="3"
                                Orientation="Horizontal"
                                IsDirectionReversed="False">

								<Track.DecreaseRepeatButton>
									<RepeatButton
                                        Command="ScrollBar.PageLeftCommand"
                                        Focusable="False"
                                        IsTabStop="False"
                                        Opacity="0"/>
								</Track.DecreaseRepeatButton>

								<Track.Thumb>
									<Thumb
                                        MinWidth="55"
                                        Cursor="Hand">

										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">

												<Border
                                                    x:Name="ThumbBorder"
                                                    CornerRadius="5"
                                                    Background="#7B838D"
                                                    BorderBrush="#A1A8B0"
                                                    BorderThickness="1"/>

												<ControlTemplate.Triggers>

													<Trigger
                                                        Property="IsMouseOver"
                                                        Value="True">

														<Setter
                                                            TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="#00A83B"/>

														<Setter
                                                            TargetName="ThumbBorder"
                                                            Property="BorderBrush"
                                                            Value="#00E676"/>

													</Trigger>

													<Trigger
                                                        Property="IsDragging"
                                                        Value="True">

														<Setter
                                                            TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="#00C853"/>

														<Setter
                                                            TargetName="ThumbBorder"
                                                            Property="BorderBrush"
                                                            Value="#69F0AE"/>

													</Trigger>

												</ControlTemplate.Triggers>

											</ControlTemplate>
										</Thumb.Template>

									</Thumb>
								</Track.Thumb>

								<Track.IncreaseRepeatButton>
									<RepeatButton
                                        Command="ScrollBar.PageRightCommand"
                                        Focusable="False"
                                        IsTabStop="False"
                                        Opacity="0"/>
								</Track.IncreaseRepeatButton>

							</Track>

						</Border>

					</ControlTemplate>
				</Setter.Value>
			</Setter>

		</Style>

		<!-- Bară verticală pentru lista serviciilor. -->
		<Style
			x:Key="ServicesVerticalScrollBarStyle"
			TargetType="ScrollBar">

			<Setter Property="Orientation" Value="Vertical"/>
			<Setter Property="Width" Value="22"/>
			<Setter Property="MinHeight" Value="100"/>
			<Setter Property="Background" Value="#171A1E"/>
			<Setter Property="BorderBrush" Value="#424850"/>
			<Setter Property="BorderThickness" Value="1"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="ScrollBar">

						<Border
							Width="{TemplateBinding Width}"
							CornerRadius="7"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">

							<Track
								x:Name="PART_Track"
								Margin="2"
								Orientation="Vertical"
								IsDirectionReversed="True">

								<Track.DecreaseRepeatButton>

									<RepeatButton
										Command="ScrollBar.PageUpCommand"
										Focusable="False"
										IsTabStop="False"
										Opacity="0"/>

								</Track.DecreaseRepeatButton>

								<Track.Thumb>

									<Thumb
                                       Width="18"
                                       MinHeight="55"
                                       HorizontalAlignment="Center"
                                       Cursor="Hand">

										<Thumb.Template>

											<ControlTemplate TargetType="Thumb">

												<Border
		                                           x:Name="ThumbBorder"
	                                            	Width="18"
                                            		MinHeight="65"
	                                            	Margin="0"
		                                            HorizontalAlignment="Center"
	                                            	VerticalAlignment="Stretch"
	                                             	CornerRadius="7"
	                                            	Background="#7B838D"
		                                            BorderBrush="#A1A8B0"
		                                              BorderThickness="1"/>

												<ControlTemplate.Triggers>

													<Trigger
														Property="IsMouseOver"
														Value="True">

														<Setter
															TargetName="ThumbBorder"
															Property="Background"
															Value="#00A83B"/>

														<Setter
															TargetName="ThumbBorder"
															Property="BorderBrush"
															Value="#00E676"/>

													</Trigger>

													<Trigger
														Property="IsDragging"
														Value="True">

														<Setter
															TargetName="ThumbBorder"
															Property="Background"
															Value="#00C853"/>

														<Setter
															TargetName="ThumbBorder"
															Property="BorderBrush"
															Value="#69F0AE"/>

													</Trigger>

												</ControlTemplate.Triggers>

											</ControlTemplate>

										</Thumb.Template>

									</Thumb>

								</Track.Thumb>

								<Track.IncreaseRepeatButton>

									<RepeatButton
										Command="ScrollBar.PageDownCommand"
										Focusable="False"
										IsTabStop="False"
										Opacity="0"/>

								</Track.IncreaseRepeatButton>

							</Track>

						</Border>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>
		<!-- ScrollViewer vertical cu bara poziționată în stânga. -->
		<Style
			x:Key="LeftVerticalScrollViewerStyle"
			TargetType="ScrollViewer">

			<Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="CanContentScroll" Value="False"/>

			<Setter Property="Template">
				<Setter.Value>

					<ControlTemplate TargetType="ScrollViewer">

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<ScrollBar
								x:Name="PART_VerticalScrollBar"
								Grid.Column="0"
								Margin="0,0,10,0"
								Minimum="0"
								Maximum="{TemplateBinding ScrollableHeight}"
								Value="{TemplateBinding VerticalOffset}"
								ViewportSize="{TemplateBinding ViewportHeight}"
								Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
								Style="{StaticResource ServicesVerticalScrollBarStyle}"/>

							<ScrollContentPresenter
								x:Name="PART_ScrollContentPresenter"
								Grid.Column="1"
								CanContentScroll="{TemplateBinding CanContentScroll}"
								Content="{TemplateBinding Content}"
								ContentTemplate="{TemplateBinding ContentTemplate}"
								Margin="{TemplateBinding Padding}"/>

						</Grid>

					</ControlTemplate>

				</Setter.Value>
			</Setter>

		</Style>

		<!-- ScrollViewer cu bara orizontală poziționată sus. -->
		<Style
            x:Key="TopHorizontalScrollViewerStyle"
            TargetType="ScrollViewer">

			<Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="CanContentScroll" Value="False"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollViewer">

						<Grid>

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="0"
                                Margin="0,0,0,12"
                                Minimum="0"
                                Maximum="{TemplateBinding ScrollableWidth}"
                                Value="{TemplateBinding HorizontalOffset}"
                                ViewportSize="{TemplateBinding ViewportWidth}"
                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                Style="{StaticResource ServicesHorizontalScrollBarStyle}"/>

							<ScrollContentPresenter
                                x:Name="PART_ScrollContentPresenter"
                                Grid.Row="1"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="{TemplateBinding Padding}"/>

						</Grid>

					</ControlTemplate>
				</Setter.Value>
			</Setter>

		</Style>

	</UserControl.Resources>

	<ScrollViewer
		Style="{StaticResource WinBoostPageScrollViewerStyle}">

		<Grid Margin="30">

			<Grid.RowDefinitions>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="Auto"/>

				<RowDefinition Height="Auto"/>

			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource ServicesPageTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="{DynamicResource ServicesPageDescription}"
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU SCANARE -->

			<Border
                    Grid.Row="1"
                    Margin="0,25,0,0"
                    Padding="22"
                    CornerRadius="10"
                    Background="{StaticResource CardBrush}"
                     Style="{StaticResource InteractiveCardStyle}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource ServicesCheckTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="{Binding ScanMessage}"
                            Margin="0,8,20,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{DynamicResource ServicesScanInformation}"
                            Margin="0,6,20,0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<!-- BADGE STARE -->

						<Border
                            Padding="12,7"
                            CornerRadius="6"
                            HorizontalAlignment="Center">

							<Border.Style>

								<Style TargetType="Border">

									<Setter
                                        Property="Background"
                                        Value="#3A3A3A"/>

									<Style.Triggers>

										<DataTrigger
                                            Binding="{Binding ScanStatusCode}"
                                            Value="Verified">

											<Setter
                                                Property="Background"
                                                Value="#233D2A"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanStatusCode}"
                                            Value="Checking">

											<Setter
                                                Property="Background"
                                                Value="#4A3D22"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanStatusCode}"
                                            Value="Error">

											<Setter
                                                Property="Background"
                                                Value="#4A2525"/>

										</DataTrigger>

									</Style.Triggers>

								</Style>

							</Border.Style>

							<TextBlock
                                Text="{Binding ScanStatus}">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
                                            Property="Foreground"
                                            Value="{StaticResource SecondaryTextBrush}"/>

										<Style.Triggers>

											<DataTrigger
                                                Binding="{Binding ScanStatusCode}"
                                                Value="Verified">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanStatusCode}"
                                                Value="Checking">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FFB300"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanStatusCode}"
                                                Value="Error">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FF5252"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>

						</Border>

						<!-- BUTON SCANARE -->

						<Button
                            Content="{DynamicResource ServicesScanButton}"
                            Command="{Binding ScanServicesCommand}"
                            Width="175"
                            Height="42"
                            Margin="0,10,0,0"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- SERVICES HEALTH -->

			<Border
                 Grid.Row="2"
                 Margin="0,25,0,0"
                 Padding="22"
                 Style="{StaticResource InteractiveCardStyle}">

				<StackPanel>

					<TextBlock
						Text="{DynamicResource ServicesHealthTitle}"
						FontSize="20"
						FontWeight="SemiBold"
						Foreground="{StaticResource TextBrush}"/>

					<TextBlock
						Text="{DynamicResource ServicesHealthDescription}"
						Margin="0,6,0,18"
						TextWrapping="Wrap"
						Foreground="{StaticResource SecondaryTextBrush}"/>

					<ScrollViewer
						HorizontalScrollBarVisibility="Visible"
						VerticalScrollBarVisibility="Disabled"
						CanContentScroll="False">

						<ScrollViewer.Resources>
							<Style
								TargetType="ScrollBar"
								BasedOn="{StaticResource ServicesHorizontalScrollBarStyle}"/>
						</ScrollViewer.Resources>

						<UniformGrid
						Columns="6"
						MinWidth="980">

							<Border
								Margin="4"
								Padding="14"
								Style="{StaticResource InteractiveCardStyle}">

								<StackPanel>

									<TextBlock
										Text="{DynamicResource ServicesHealthTotal}"
										HorizontalAlignment="Center"
										Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
										Text="{Binding ServicesHealth.TotalServices,
                                       Mode=OneWay}"
										Margin="0,6,0,0"
										HorizontalAlignment="Center"
										FontSize="22"
										FontWeight="Bold"
										Foreground="White"/>

								</StackPanel>

							</Border>

							<Border
								Margin="4"
								Padding="14"
								Style="{StaticResource InteractiveCardStyle}">

								<StackPanel>

									<TextBlock
										Text="{DynamicResource ServicesHealthRunning}"
										HorizontalAlignment="Center"
										Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
										Text="{Binding ServicesHealth.RunningServices,
                                       Mode=OneWay}"
										Margin="0,6,0,0"
										HorizontalAlignment="Center"
										FontSize="22"
										FontWeight="Bold"
										Foreground="#00C853"/>

								</StackPanel>

							</Border>

							<Border
								Margin="4"
								Padding="14"
								Style="{StaticResource InteractiveCardStyle}">

								<StackPanel>

									<TextBlock
										Text="{DynamicResource ServicesHealthCritical}"
										HorizontalAlignment="Center"
										Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
										Text="{Binding ServicesHealth.CriticalServices,
                                       Mode=OneWay}"
										Margin="0,6,0,0"
										HorizontalAlignment="Center"
										FontSize="22"
										FontWeight="Bold"
										Foreground="#FF5252"/>

								</StackPanel>

							</Border>

							<Border
								Margin="4"
								Padding="14"
								Style="{StaticResource InteractiveCardStyle}">

								<StackPanel>

									<TextBlock
										Text="{DynamicResource ServicesHealthRecommended}"
										HorizontalAlignment="Center"
										Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
										Text="{Binding ServicesHealth.RecommendedServices,
                                       Mode=OneWay}"
										Margin="0,6,0,0"
										HorizontalAlignment="Center"
										FontSize="22"
										FontWeight="Bold"
										Foreground="#FFB300"/>

								</StackPanel>

							</Border>

							<Border
								Margin="4"
								Padding="14"
								Style="{StaticResource InteractiveCardStyle}">

								<StackPanel>

									<TextBlock
										Text="{DynamicResource ServicesHealthSafe}"
										HorizontalAlignment="Center"
										Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
										Text="{Binding ServicesHealth.SafeToOptimizeServices,
                                       Mode=OneWay}"
										Margin="0,6,0,0"
										HorizontalAlignment="Center"
										FontSize="22"
										FontWeight="Bold"
										Foreground="#35C759"/>

								</StackPanel>

							</Border>

							<Border
								Margin="4"
								Padding="14"
								Style="{StaticResource InteractiveCardStyle}">

								<StackPanel>

									<TextBlock
										Text="{DynamicResource ServicesHealthEstimatedGain}"
										HorizontalAlignment="Center"
										TextAlignment="Center"
										Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
										Text="{Binding ServicesHealth.EstimatedHealthGainText,
                                       Mode=OneWay}"
										Margin="0,6,0,0"
										HorizontalAlignment="Center"
										TextAlignment="Center"
										FontSize="18"
										FontWeight="Bold"
										Foreground="#35C759"/>

								</StackPanel>

							</Border>

						</UniformGrid>


					</ScrollViewer>

					<Border
    Margin="4,18,4,0"
    Padding="18"
    CornerRadius="8"
    Background="#315A39"
    BorderBrush="#3F7249"
    BorderThickness="1">

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Column="0"
								Text="⚡"
								Margin="0,0,14,0"
								FontSize="22"
								VerticalAlignment="Center"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding HealthInsight}"
								FontSize="15"
								FontWeight="SemiBold"
								LineHeight="22"
								TextWrapping="Wrap"
								VerticalAlignment="Center"
								Foreground="White"/>

						</Grid>

					</Border>

				</StackPanel>

			</Border>
			<!-- LISTA SERVICIILOR -->


			<Border
                      Grid.Row="3"
                     Margin="0,25,0,0"
                     Padding="22"
                     Style="{StaticResource InteractiveCardStyle}">
				<StackPanel>

					<TextBlock
                        Text="{DynamicResource ServicesAnalyzedTitle}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="{DynamicResource ServicesAnalyzedDescription}"
                        Margin="0,5,0,18"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- CĂUTARE ȘI FILTRU -->

					<Grid Margin="0,0,0,18">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="200"/>
						</Grid.ColumnDefinitions>

						<TextBox
                            Grid.Column="0"
                            Text="{Binding SearchText,
                                           UpdateSourceTrigger=PropertyChanged}"
                            Height="38"
                            Margin="0,0,12,0"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            Foreground="{StaticResource TextBrush}"
                            Background="#2A2A2A"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            ToolTip="{DynamicResource ServicesSearchToolTip}"/>

						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding AvailableFilters}"
							SelectedItem="{Binding SelectedFilter,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}"
							Height="38"
							Padding="10,0"
							VerticalContentAlignment="Center"
							FontSize="14"
							Foreground="Black"
							Background="White"
							BorderBrush="#4A4A4A"
							BorderThickness="1"/>

					</Grid>

					<ScrollViewer
						Style="{StaticResource TopHorizontalScrollViewerStyle}">

						<StackPanel MinWidth="1360">

							<!-- ANTET -->

							<Grid Margin="44,0,0,8">

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="350"/>
									<ColumnDefinition Width="175"/>
									<ColumnDefinition Width="155"/>
									<ColumnDefinition Width="220"/>
									<ColumnDefinition Width="100"/>
									<ColumnDefinition Width="470"/>
								</Grid.ColumnDefinitions>

								<!-- SERVICIU -->
								<TextBlock
									Grid.Column="0"
									Text="{DynamicResource ServicesColumnService}"
									VerticalAlignment="Center"
									FontWeight="SemiBold"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<!-- PORNIRE -->

								<TextBlock
									Grid.Column="1"
									Text="{DynamicResource ServicesColumnStartup}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									TextAlignment="Center"
									FontWeight="SemiBold"
									Foreground="{StaticResource SecondaryTextBrush}"/>
								<!-- STARE -->

								<TextBlock
									Grid.Column="2"
									Text="{DynamicResource ServicesColumnStatus}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									TextAlignment="Center"
									FontWeight="SemiBold"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<!-- RECOMANDARE -->
								<TextBlock
									Grid.Column="3"
									Text="{DynamicResource ServicesColumnRecommendation}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									TextAlignment="Center"
									FontWeight="SemiBold"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<!-- SĂNĂTATE -->
								<TextBlock
									Grid.Column="4"
									Text="{DynamicResource ServicesColumnHealth}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									TextAlignment="Center"
									FontWeight="SemiBold"
									Foreground="{StaticResource SecondaryTextBrush}"/>

								<!-- ACȚIUNI -->
								<TextBlock
									Grid.Column="5"
									Text="{DynamicResource ServicesColumnActions}"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									TextAlignment="Center"
									FontWeight="SemiBold"
									Foreground="{StaticResource SecondaryTextBrush}"/>

							</Grid>

							<Border
								Height="1"
								Margin="0,0,0,5"
								Background="#454545"/>

							<!-- SERVICII -->

							<ScrollViewer
                                Height="420"
                                Style="{StaticResource LeftVerticalScrollViewerStyle}">

								<ItemsControl
					
									  ItemsSource="{Binding Services}">

									<ItemsControl.ItemTemplate>

										<DataTemplate>

											<Border
												Margin="0,5"
												Padding="12"
												CornerRadius="6"
												Background="#303030">

												<Grid>

													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="350"/>
														<ColumnDefinition Width="175"/>
														<ColumnDefinition Width="155"/>
														<ColumnDefinition Width="220"/>
														<ColumnDefinition Width="100"/>
														<ColumnDefinition Width="470"/>
													</Grid.ColumnDefinitions>
													<!-- SERVICIU -->

													<StackPanel Grid.Column="0">

														<TextBlock
															Text="{Binding DisplayName}"
															FontWeight="SemiBold"
															TextWrapping="Wrap"
															Foreground="{StaticResource TextBrush}"/>

														<TextBlock
															Text="{Binding ServiceName}"
															Margin="0,3,0,0"
															FontSize="12"
															TextWrapping="Wrap"
															Foreground="{StaticResource SecondaryTextBrush}"/>

													</StackPanel>

													<!-- TIP PORNIRE EDITABIL -->

													<StackPanel
														Grid.Column="1"
														Margin="4,0"
														HorizontalAlignment="Center"
														VerticalAlignment="Center">

														<ComboBox
                                                               Width="155"
                                                                Height="32"
                                                                IsEnabled="{Binding CanChangeStartupType}"
                                                                SelectedValuePath="Tag"
                                                                SelectedValue="{Binding SelectedStartupType,
                                                                  Mode=TwoWay,
                                                                   UpdateSourceTrigger=PropertyChanged}">

															<ComboBoxItem
																Tag="Automatic"
																Content="{DynamicResource ServicesStartupAutomatic}"/>

															<ComboBoxItem
																Tag="Automatic (Delayed)"
																Content="{DynamicResource ServicesStartupAutomaticDelayed}"/>

															<ComboBoxItem
																Tag="Manual"
																Content="{DynamicResource ServicesStartupManual}"/>

															<ComboBoxItem
																Tag="Disabled"
																Content="{DynamicResource ServicesStartupDisabled}"/>

														</ComboBox>

														<Button
														Width="110"
														Height="32"
														Margin="0,6,0,0"
														Padding="10,0"
														Content="{DynamicResource ServicesApplyStartupType}"
														Command="{Binding DataContext.ChangeStartupTypeCommand,
																  RelativeSource={RelativeSource AncestorType=UserControl}}"
														CommandParameter="{Binding}">

															<Button.Style>
																<Style TargetType="Button">

																	<Setter Property="Foreground" Value="White"/>
																	<Setter Property="Background" Value="#237A36"/>
																	<Setter Property="BorderBrush" Value="#35A84F"/>
																	<Setter Property="BorderThickness" Value="1"/>
																	<Setter Property="FontWeight" Value="SemiBold"/>
																	<Setter Property="Cursor" Value="Hand"/>

																	<Setter Property="Template">
																		<Setter.Value>
																			<ControlTemplate TargetType="Button">

																				<Border
																					x:Name="ApplyStartupBorder"
																					Background="{TemplateBinding Background}"
																					BorderBrush="{TemplateBinding BorderBrush}"
																					BorderThickness="{TemplateBinding BorderThickness}"
																					CornerRadius="5">

																					<ContentPresenter
																						HorizontalAlignment="Center"
																						VerticalAlignment="Center"/>

																				</Border>

																				<ControlTemplate.Triggers>

																					<Trigger
																						Property="IsMouseOver"
																						Value="True">

																						<Setter
																							TargetName="ApplyStartupBorder"
																							Property="Background"
																							Value="#2D9445"/>

																					</Trigger>

																					<Trigger
																						Property="IsPressed"
																						Value="True">

																						<Setter
																							TargetName="ApplyStartupBorder"
																							Property="Background"
																							Value="#185A29"/>

																					</Trigger>

																					<Trigger
																						Property="IsEnabled"
																						Value="False">

																						<Setter
																							TargetName="ApplyStartupBorder"
																							Property="Background"
																							Value="#3A3A3A"/>

																						<Setter
																							TargetName="ApplyStartupBorder"
																							Property="BorderBrush"
																							Value="#555555"/>

																						<Setter
																							Property="Foreground"
																							Value="#BDBDBD"/>

																						<Setter
																							Property="Cursor"
																							Value="Arrow"/>

																					</Trigger>

																				</ControlTemplate.Triggers>

																			</ControlTemplate>
																		</Setter.Value>
																	</Setter>

																</Style>
															</Button.Style>

														</Button>


													</StackPanel>

													<!-- STARE SERVICIU -->

													<TextBlock
														Grid.Column="2"
														Text="{Binding StatusText}"
														Margin="0"
														HorizontalAlignment="Center"
														VerticalAlignment="Center"
														TextAlignment="Center"
														TextWrapping="Wrap"
														Foreground="{StaticResource SecondaryTextBrush}"/>
													<!-- RECOMANDARE -->

													<Border
														Grid.Column="3"
														MinWidth="96"
														MinHeight="34"
														Margin="6,0"
														Padding="14,6"
														HorizontalAlignment="Stretch"
														VerticalAlignment="Center"
														CornerRadius="17"
														Background="#252525"
														BorderBrush="{Binding RecommendationBrush}"
														BorderThickness="1">

														<TextBlock
															Text="{Binding RecommendationText}"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															TextAlignment="Center"
															TextWrapping="Wrap"
															FontSize="13"
															FontWeight="SemiBold"
															Foreground="{Binding RecommendationBrush}"/>

													</Border>
													<!-- HEALTH SCORE -->

													<Border
													  Grid.Column="4"
													   Width="72"
													   Height="34"
													   Margin="4,0"
														HorizontalAlignment="Center"
														VerticalAlignment="Center"
														CornerRadius="17"
														Background="#252525"
														BorderBrush="{Binding HealthScoreBrush}"
														 BorderThickness="1">

														<TextBlock
															Text="{Binding HealthScoreText}"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															FontSize="14"
															FontWeight="SemiBold"
															Foreground="{Binding HealthScoreBrush}"/>

													</Border>

													<!-- ACȚIUNI -->

													<StackPanel
														  Grid.Column="5"
														  Margin="0"
														  Orientation="Horizontal"
														  HorizontalAlignment="Center"
														  VerticalAlignment="Center">

														<!-- START -->

														<Button
															Width="92"
															Height="34"
															Margin="2"
															Padding="0"
															Foreground="White"
															BorderBrush="#2E9B43"
															BorderThickness="1"
															Command="{Binding DataContext.StartServiceCommand,
	                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}"
															IsEnabled="{Binding CanStart}">

															<Button.Style>

																<Style TargetType="Button">

																	<Setter
																		Property="Background"
																		Value="#1E5E2B"/>

																	<Setter Property="Template">

																		<Setter.Value>

																			<ControlTemplate TargetType="Button">

																				<Border
																					x:Name="StartBorder"
																					Background="{TemplateBinding Background}"
																					BorderBrush="{TemplateBinding BorderBrush}"
																					BorderThickness="{TemplateBinding BorderThickness}"
																					CornerRadius="5">

																					<ContentPresenter
																						HorizontalAlignment="Center"
																						VerticalAlignment="Center"/>

																				</Border>

																				<ControlTemplate.Triggers>

																					<Trigger
																						Property="IsMouseOver"
																						Value="True">

																						<Setter
																							TargetName="StartBorder"
																							Property="Background"
																							Value="#287A39"/>

																					</Trigger>

																					<Trigger
																						Property="IsPressed"
																						Value="True">

																						<Setter
																							TargetName="StartBorder"
																							Property="Background"
																							Value="#174A22"/>

																					</Trigger>

																					<Trigger
																						Property="IsEnabled"
																						Value="False">

																						<Setter
																							TargetName="StartBorder"
																							Property="Opacity"
																							Value="0.35"/>

																					</Trigger>

																				</ControlTemplate.Triggers>

																			</ControlTemplate>

																		</Setter.Value>

																	</Setter>

																</Style>

															</Button.Style>

															<StackPanel
																Orientation="Horizontal"
																HorizontalAlignment="Center">

																<TextBlock
																	Text="▶"
																	Margin="0,0,5,0"
																	VerticalAlignment="Center"/>

																<TextBlock
																	Text="{DynamicResource ServicesActionStart}"
																	VerticalAlignment="Center"/>

															</StackPanel>

														</Button>

														<!-- STOP -->

														<Button
															Width="92"
															Height="34"
															Margin="2"
															Padding="0"
															Foreground="White"
															BorderBrush="#B13A3A"
															BorderThickness="1"
															Command="{Binding DataContext.StopServiceCommand,
	                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}"
															IsEnabled="{Binding CanStop}">

															<Button.Style>

																<Style TargetType="Button">

																	<Setter
																		Property="Background"
																		Value="#5F2222"/>

																	<Setter Property="Template">

																		<Setter.Value>

																			<ControlTemplate TargetType="Button">

																				<Border
																					x:Name="StopBorder"
																					Background="{TemplateBinding Background}"
																					BorderBrush="{TemplateBinding BorderBrush}"
																					BorderThickness="{TemplateBinding BorderThickness}"
																					CornerRadius="5">

																					<ContentPresenter
																						HorizontalAlignment="Center"
																						VerticalAlignment="Center"/>

																				</Border>

																				<ControlTemplate.Triggers>

																					<Trigger
																						Property="IsMouseOver"
																						Value="True">

																						<Setter
																							TargetName="StopBorder"
																							Property="Background"
																							Value="#7A2B2B"/>

																					</Trigger>

																					<Trigger
																						Property="IsPressed"
																						Value="True">

																						<Setter
																							TargetName="StopBorder"
																							Property="Background"
																							Value="#481919"/>

																					</Trigger>

																					<Trigger
																						Property="IsEnabled"
																						Value="False">

																						<Setter
																							TargetName="StopBorder"
																							Property="Opacity"
																							Value="0.35"/>

																					</Trigger>

																				</ControlTemplate.Triggers>

																			</ControlTemplate>

																		</Setter.Value>

																	</Setter>

																</Style>

															</Button.Style>

															<StackPanel
																Orientation="Horizontal"
																HorizontalAlignment="Center">

																<TextBlock
																	Text="■"
																	Margin="0,0,5,0"
																	VerticalAlignment="Center"/>

																<TextBlock
																	Text="{DynamicResource ServicesActionStop}"
																	VerticalAlignment="Center"/>

															</StackPanel>

														</Button>

														<!-- RESTART -->

														<Button
															Width="120"
															Height="34"
															Margin="2"
															Padding="0"
															Foreground="White"
															BorderBrush="#3577A8"
															BorderThickness="1"
															Command="{Binding DataContext.RestartServiceCommand,
	                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}"
															IsEnabled="{Binding CanRestart}">

															<Button.Style>

																<Style TargetType="Button">

																	<Setter
																		Property="Background"
																		Value="#234B68"/>

																	<Setter Property="Template">

																		<Setter.Value>

																			<ControlTemplate TargetType="Button">

																				<Border
																					x:Name="RestartBorder"
																					Background="{TemplateBinding Background}"
																					BorderBrush="{TemplateBinding BorderBrush}"
																					BorderThickness="{TemplateBinding BorderThickness}"
																					CornerRadius="5">

																					<ContentPresenter
																						HorizontalAlignment="Center"
																						VerticalAlignment="Center"/>

																				</Border>

																				<ControlTemplate.Triggers>

																					<Trigger
																						Property="IsMouseOver"
																						Value="True">

																						<Setter
																							TargetName="RestartBorder"
																							Property="Background"
																							Value="#2F668E"/>

																					</Trigger>

																					<Trigger
																						Property="IsPressed"
																						Value="True">

																						<Setter
																							TargetName="RestartBorder"
																							Property="Background"
																							Value="#18364C"/>

																					</Trigger>

																					<Trigger
																						Property="IsEnabled"
																						Value="False">

																						<Setter
																							TargetName="RestartBorder"
																							Property="Opacity"
																							Value="0.35"/>

																					</Trigger>

																				</ControlTemplate.Triggers>

																			</ControlTemplate>

																		</Setter.Value>

																	</Setter>

																</Style>

															</Button.Style>

															<StackPanel
																Orientation="Horizontal"
																HorizontalAlignment="Center">

																<TextBlock
																	Text="↻"
																	Margin="0,0,5,0"
																	VerticalAlignment="Center"/>

																<TextBlock
																	Text="{DynamicResource ServicesActionRestart}"
																	VerticalAlignment="Center"/>

															</StackPanel>

														</Button>

													</StackPanel>

												</Grid>

											</Border>

										</DataTemplate>

									</ItemsControl.ItemTemplate>

								</ItemsControl>

							</ScrollViewer>

						</StackPanel>

					</ScrollViewer>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>