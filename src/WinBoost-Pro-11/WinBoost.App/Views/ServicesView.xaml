<UserControl
    x:Class="WinBoost.App.Views.ServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="Services"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="Verifică serviciile Windows și identifică serviciile care pot afecta performanța."
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU SCANARE -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock
                            Text="Windows Services Check"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="{Binding ScanMessage,
                                           FallbackValue='Apasă Scan Services pentru verificare.'}"
                            Margin="0,8,20,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="Scanarea este doar informativă și nu modifică serviciile Windows."
                            Margin="0,6,20,0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<!-- BADGE STARE -->

						<Border
                            Padding="12,7"
                            CornerRadius="6"
                            HorizontalAlignment="Center">

							<Border.Style>

								<Style TargetType="Border">

									<Setter
                                        Property="Background"
                                        Value="#3A3A3A"/>

									<Style.Triggers>

										<DataTrigger
                                            Binding="{Binding ScanStatus}"
                                            Value="Verificat">

											<Setter
                                                Property="Background"
                                                Value="#233D2A"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanStatus}"
                                            Value="Se verifică">

											<Setter
                                                Property="Background"
                                                Value="#4A3D22"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanStatus}"
                                            Value="Eroare">

											<Setter
                                                Property="Background"
                                                Value="#4A2525"/>

										</DataTrigger>

									</Style.Triggers>

								</Style>

							</Border.Style>

							<TextBlock
                                Text="{Binding ScanStatus,
                                               FallbackValue=Neverificat}">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
                                            Property="Foreground"
                                            Value="{StaticResource SecondaryTextBrush}"/>

										<Style.Triggers>

											<DataTrigger
                                                Binding="{Binding ScanStatus}"
                                                Value="Verificat">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanStatus}"
                                                Value="Se verifică">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FFB300"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanStatus}"
                                                Value="Eroare">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FF5252"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>

						</Border>

						<!-- BUTON SCANARE -->

						<Button
                            Content="{Binding ScanButtonText,
                                              FallbackValue='Scan Services'}"
                            Command="{Binding ScanServicesCommand}"
                            Width="150"
                            Height="42"
                            Margin="0,10,0,0"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- LISTA SERVICIILOR -->

			<Border
                Grid.Row="2"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
                        Text="Servicii analizate"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="Aici vor apărea serviciile identificate în urma scanării."
                        Margin="0,5,0,18"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- CĂUTARE ȘI FILTRU -->

					<Grid Margin="0,0,0,18">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="200"/>
						</Grid.ColumnDefinitions>

						<TextBox
                            Grid.Column="0"
                            Text="{Binding SearchText,
                                           UpdateSourceTrigger=PropertyChanged}"
                            Height="38"
                            Margin="0,0,12,0"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            Foreground="{StaticResource TextBrush}"
                            Background="#2A2A2A"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            ToolTip="Caută după numele serviciului sau numele intern"/>

						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding AvailableFilters}"
							SelectedItem="{Binding SelectedFilter,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}"
							Height="38"
							Padding="10,0"
							VerticalContentAlignment="Center"
							FontSize="14"
							Foreground="Black"
							Background="White"
							BorderBrush="#4A4A4A"
							BorderThickness="1"/>

					</Grid>

					<!-- ANTET -->

					<Grid Margin="0,0,0,8">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="2*"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                            Grid.Column="0"
                            Text="Serviciu"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="1"
                            Text="Stare"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="2"
                            Text="Pornire"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="3"
                            Text="Recomandare"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</Grid>

					<Border
                        Height="1"
                        Margin="0,0,0,5"
                        Background="#454545"/>

					<!-- SERVICII -->

					<ItemsControl
				
                          ItemsSource="{Binding Services}">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Border
                                    Margin="0,5"
                                    Padding="12"
                                    CornerRadius="6"
                                    Background="#303030">

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="2*"/>
										</Grid.ColumnDefinitions>

										<StackPanel Grid.Column="0">

											<TextBlock
                                                Text="{Binding DisplayName}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource TextBrush}"/>

											<TextBlock
                                                Text="{Binding ServiceName}"
                                                Margin="0,3,0,0"
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

										</StackPanel>

										<TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Status}"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding StatusBrush}"/>

										<TextBlock
                                            Grid.Column="2"
                                            Text="{Binding StartType}"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

										<TextBlock
                                            Grid.Column="3"
                                            Text="{Binding Recommendation}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

									</Grid>

								</Border>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>