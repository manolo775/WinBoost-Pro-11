<UserControl
    x:Class="WinBoost.App.Views.PrivacyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="Privacy"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="Verifică setările Windows care pot afecta confidențialitatea."
                    Margin="0,6,0,0"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- STAREA SCANĂRII -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock
                            Text="Privacy Check"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="{Binding ScanStatus}"
                            Margin="0,8,20,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<Border
                        Grid.Column="1"
                        Padding="12,7"
                        CornerRadius="6"
                        Background="#3A3A3A"
                        VerticalAlignment="Center">

						<TextBlock
                            Text="{Binding OverallStatus}"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</Border>

				</Grid>

			</Border>

			<!-- LISTA SETĂRILOR -->

			<StackPanel
                Grid.Row="2"
                Margin="0,25,0,0">

				<TextBlock
                    Text="Setări verificate"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<ItemsControl
                    ItemsSource="{Binding PrivacyItems}"
                    Margin="0,10,0,0">

					<ItemsControl.ItemTemplate>

						<DataTemplate>

							<Border
                                Margin="0,5"
                                Padding="20"
                                CornerRadius="8"
                                Background="{StaticResource CardBrush}">

								<Grid>

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<StackPanel>

										<TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextBrush}"/>

										<TextBlock
                                            Text="{Binding Description}"
                                            Margin="0,6,20,0"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

									</StackPanel>

									<TextBlock
    Grid.Column="1"
    Text="{Binding Status}"
    Margin="20,0,0,0"
    VerticalAlignment="Center">

										<TextBlock.Style>
											<Style TargetType="TextBlock">

												<Setter
													Property="Foreground"
													Value="{StaticResource SecondaryTextBrush}"/>

												<Style.Triggers>

													<DataTrigger
														Binding="{Binding StatusLevel}"
														Value="Good">

														<Setter
															Property="Foreground"
															Value="#00C853"/>

													</DataTrigger>

													<DataTrigger
														Binding="{Binding StatusLevel}"
														Value="Attention">

														<Setter
															Property="Foreground"
															Value="#FFB300"/>

													</DataTrigger>

												</Style.Triggers>

											</Style>
										</TextBlock.Style>

									</TextBlock>

								</Grid>

							</Border>

						</DataTemplate>

					</ItemsControl.ItemTemplate>

				</ItemsControl>

			</StackPanel>

			<!-- BUTONUL DE SCANARE -->

			<Border
                Grid.Row="3"
                Margin="0,20,0,0"
                Padding="20"
                CornerRadius="8"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBlock
                        Text="Scanarea este doar informativă și nu modifică setările Windows."
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<Button
                        Grid.Column="1"
                        Content="{Binding ScanButtonText}"
                        Command="{Binding ScanPrivacyCommand}"
                        Width="150"
                        Height="42"
                        VerticalAlignment="Center"/>

				</Grid>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>