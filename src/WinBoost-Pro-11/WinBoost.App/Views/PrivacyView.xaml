<UserControl
    x:Class="WinBoost.App.Views.PrivacyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer
		Style="{StaticResource WinBoostPageScrollViewerStyle}">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource PrivacyPageTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="{DynamicResource PrivacyPageDescription}"
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- STAREA SCANĂRII -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="190"/>
					</Grid.ColumnDefinitions>

					<StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center">

						<TextBlock
                            Text="{DynamicResource PrivacyScanTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<StackPanel
                            Margin="0,14,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

							<Ellipse
                                Width="16"
                                Height="16"
                                Fill="#35C759"
                                Margin="0,0,18,0"
                                VerticalAlignment="Center"/>

							<StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

								<TextBlock
                                    Text="{DynamicResource PrivacyRecommendationsPrefix}"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="White"/>

								<TextBlock
                                    Text="{Binding RecommendationCount,
                                                   Mode=OneWay}"
                                    Margin="7,0"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="ExtraBold"
                                    Foreground="#35C759"/>

								<TextBlock
                                    Text="{DynamicResource PrivacyRecommendationsSuffix}"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap"
                                    Foreground="White"/>

							</StackPanel>

						</StackPanel>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

						<Border
                            MinWidth="96"
                            Padding="14,8"
                            HorizontalAlignment="Center"
                            CornerRadius="7"
                            Background="#3A3A3A">

							<TextBlock
                                Text="{Binding OverallStatus}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                FontWeight="SemiBold">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
                                            Property="Foreground"
                                            Value="{StaticResource SecondaryTextBrush}"/>

										<Style.Triggers>

											<DataTrigger
                                                Binding="{Binding OverallStatus}"
                                                Value="Verificat">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding OverallStatus}"
                                                Value="Se verifică">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FFB300"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding OverallStatus}"
                                                Value="Eroare">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FF5252"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>

						</Border>

						<Button
                            Content="{Binding ScanButtonText}"
                            Command="{Binding ScanPrivacyCommand}"
                            Width="170"
                            Height="42"
                            Margin="0,12,0,0"
                            Foreground="White"
                            BorderBrush="#2E9B43"
                            BorderThickness="1">

							<Button.Style>

								<Style TargetType="Button">

									<Setter
                                        Property="Background"
                                        Value="#1E5E2B"/>

									<Setter Property="Template">

										<Setter.Value>

											<ControlTemplate TargetType="Button">

												<Border
                                                    x:Name="ScanButtonBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">

													<ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>

												</Border>

												<ControlTemplate.Triggers>

													<Trigger
                                                        Property="IsMouseOver"
                                                        Value="True">

														<Setter
                                                            TargetName="ScanButtonBorder"
                                                            Property="Background"
                                                            Value="#287A39"/>

													</Trigger>

													<Trigger
                                                        Property="IsPressed"
                                                        Value="True">

														<Setter
                                                            TargetName="ScanButtonBorder"
                                                            Property="Background"
                                                            Value="#174A22"/>

													</Trigger>

													<Trigger
                                                        Property="IsEnabled"
                                                        Value="False">

														<Setter
                                                            TargetName="ScanButtonBorder"
                                                            Property="Opacity"
                                                            Value="0.45"/>

													</Trigger>

												</ControlTemplate.Triggers>

											</ControlTemplate>

										</Setter.Value>

									</Setter>

								</Style>

							</Button.Style>

						</Button>

					</StackPanel>

				</Grid>

			</Border>

			<!-- LISTA SETĂRILOR -->

			<StackPanel
                Grid.Row="2"
                Margin="0,25,0,0">

				<TextBlock
                    Text="{DynamicResource PrivacyCheckedSettingsTitle}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<ItemsControl
                    ItemsSource="{Binding PrivacyItems}"
                    Margin="0,10,0,0">

					<ItemsControl.ItemTemplate>

						<DataTemplate>

							<Border
                                Margin="0,5"
                                Padding="20"
                                CornerRadius="8"
                                Background="{StaticResource CardBrush}">

								<Grid>

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<StackPanel Grid.Column="0">

										<TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextBrush}"/>

										<TextBlock
                                            Text="{Binding Description}"
                                            Margin="0,6,25,0"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

									</StackPanel>

									<Border
                                        Grid.Column="1"
                                        Margin="20,0,0,0"
                                        Padding="10,6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        CornerRadius="6"
                                        Background="#252525">

										<TextBlock
                                            Text="{Binding Status}"
                                            FontWeight="SemiBold">

											<TextBlock.Style>

												<Style TargetType="TextBlock">

													<Setter
                                                        Property="Foreground"
                                                        Value="{StaticResource SecondaryTextBrush}"/>

													<Style.Triggers>

														<DataTrigger
                                                            Binding="{Binding StatusLevel}"
                                                            Value="Good">

															<Setter
                                                                Property="Foreground"
                                                                Value="#00C853"/>

														</DataTrigger>

														<DataTrigger
                                                            Binding="{Binding StatusLevel}"
                                                            Value="Attention">

															<Setter
                                                                Property="Foreground"
                                                                Value="#FFB300"/>

														</DataTrigger>

														<DataTrigger
                                                            Binding="{Binding StatusLevel}"
                                                            Value="Critical">

															<Setter
                                                                Property="Foreground"
                                                                Value="#FF5252"/>

														</DataTrigger>

													</Style.Triggers>

												</Style>

											</TextBlock.Style>

										</TextBlock>

									</Border>

								</Grid>

							</Border>

						</DataTemplate>

					</ItemsControl.ItemTemplate>

				</ItemsControl>

			</StackPanel>

			<!-- MESAJ INFORMATIV -->

			<Border
                Grid.Row="3"
                Margin="0,20,0,0"
                Padding="20"
                CornerRadius="8"
                Background="{StaticResource CardBrush}">

				<TextBlock
                    Text="{DynamicResource PrivacyInformationMessage}"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>