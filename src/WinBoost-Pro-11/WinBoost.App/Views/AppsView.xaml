<UserControl
    x:Class="WinBoost.App.Views.AppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="900">

	<ScrollViewer
        Style="{StaticResource WinBoostPageScrollViewerStyle}">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource AppsTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Margin="0,6,0,0"
                    Text="{DynamicResource AppsDescription}"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU SCANARE -->

			<Border
             Grid.Row="1"
             Margin="0,25,0,0"
             Padding="22"
             Style="{StaticResource InteractiveCardStyle}">
				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock
                            Text="{DynamicResource AppsScanTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Margin="0,8,20,0"
                            Text="{Binding ScanStatus}"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Margin="0,6,20,0"
                            Text="{DynamicResource AppsScanInformation}"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<Border
                            Padding="12,7"
                            CornerRadius="6"
                            Background="#3A3A3A"
                            HorizontalAlignment="Center">

							<TextBlock
                                Text="{Binding ScanBadgeText}"
                                Foreground="{Binding ScanBadgeBrush}"/>

						</Border>

						<Button
                            Width="170"
                            Height="42"
                            Margin="0,10,0,0"
                            Content="{Binding ScanButtonText}"
                            Command="{Binding ScanAppsCommand}"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- LISTA APLICAȚIILOR -->

				<Border
		               Grid.Row="2"
		               Margin="0,25,0,0"
		               Padding="22"
		               Style="{StaticResource InteractiveCardStyle}">

				<StackPanel>

					<TextBlock
                        Text="{DynamicResource AppsListTitle}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Margin="0,5,0,18"
                        Text="{DynamicResource AppsListDescription}"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- CĂUTARE ȘI SORTARE -->

					<Grid Margin="0,0,0,18">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="220"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                            Text="{DynamicResource AppsSearchLabel}"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBox
                            Grid.Column="1"
							MinWidth="150"
                            Height="36"
                            Padding="10,6"
                            Text="{Binding SearchText,
                                   UpdateSourceTrigger=PropertyChanged}"
                            Background="#303030"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="#454545"/>

						<TextBlock
                            Grid.Column="2"
                            Text="{DynamicResource AppsSortLabel}"
                            Margin="18,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<ComboBox
                            Grid.Column="3"
                            Height="36"
                            SelectedIndex="{Binding SelectedSortIndex,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                            Background="White"
                            Foreground="Black"
                            VerticalContentAlignment="Center">

							<ComboBoxItem
                                Content="{DynamicResource AppsSortName}"/>

							<ComboBoxItem
                                Content="{DynamicResource AppsSortPublisher}"/>

							<ComboBoxItem
                                Content="{DynamicResource AppsSortInstallDate}"/>

						</ComboBox>

					</Grid>

					<!-- ANTET TABEL -->

					<Grid Margin="0,0,0,8">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2.2*"/>
							<ColumnDefinition Width="1.8*"/>
							<ColumnDefinition Width="1.1*"/>
							<ColumnDefinition Width="1.3*"/>
						</Grid.ColumnDefinitions>

						<TextBlock
							Text="{DynamicResource AppsColumnName}"
							FontWeight="SemiBold"
							Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
							Grid.Column="1"
							Text="{DynamicResource AppsColumnPublisher}"
							FontWeight="SemiBold"
							Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
							Grid.Column="2"
							Text="{DynamicResource AppsColumnVersion}"
							FontWeight="SemiBold"
							TextWrapping="Wrap"
							Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
							Grid.Column="3"
							Text="{DynamicResource AppsColumnInstallDate}"
							FontWeight="SemiBold"
							TextWrapping="Wrap"
							Foreground="{StaticResource SecondaryTextBrush}"/>

					</Grid>

					<Border
						Height="1"
						Margin="0,0,0,5"
						Background="#454545"/>

					<!-- LISTĂ CU DERULARE PROPRIE -->

					<ScrollViewer
						MaxHeight="270"
						Style="{StaticResource WinBoostPageScrollViewerStyle}"
						HorizontalScrollBarVisibility="Disabled">

						<ListBox
							ItemsSource="{Binding FilteredApplications}"
							SelectedItem="{Binding SelectedApplication,
                               Mode=TwoWay}"
							Background="Transparent"
							BorderThickness="0"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							ScrollViewer.VerticalScrollBarVisibility="Disabled">

							<ListBox.ItemContainerStyle>

								<Style TargetType="ListBoxItem">

									<Setter
										Property="HorizontalContentAlignment"
										Value="Stretch"/>

									<Setter
										Property="Padding"
										Value="0"/>

									<Setter
										Property="Margin"
										Value="0"/>

									<Setter
										Property="Background"
										Value="Transparent"/>

									<Setter
										Property="BorderThickness"
										Value="0"/>

									<Setter
										Property="FocusVisualStyle"
										Value="{x:Null}"/>

								</Style>

							</ListBox.ItemContainerStyle>

							<ListBox.ItemTemplate>

								<DataTemplate>

									<Border
										Margin="0,5"
										Padding="12"
										CornerRadius="6"
										BorderThickness="1"
										Background="#303030"
										BorderBrush="Transparent">

										<Border.Style>

											<Style TargetType="Border">

												<Style.Triggers>

													<DataTrigger
														Binding="{Binding IsSelected,
                                        RelativeSource={
                                            RelativeSource AncestorType=ListBoxItem}}"
														Value="True">

														<Setter
															Property="Background"
															Value="#3A3A3A"/>

														<Setter
															Property="BorderBrush"
															Value="{StaticResource AccentBrush}"/>

													</DataTrigger>

												</Style.Triggers>

											</Style>

										</Border.Style>

										<Grid>

											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="2.2*"/>
												<ColumnDefinition Width="1.8*"/>
												<ColumnDefinition Width="1.1*"/>
												<ColumnDefinition Width="1.3*"/>
											</Grid.ColumnDefinitions>

											<TextBlock
												Text="{Binding DisplayName}"
												FontWeight="SemiBold"
												TextWrapping="Wrap"
												Foreground="{StaticResource TextBrush}"/>

											<TextBlock
												Grid.Column="1"
												Text="{Binding Publisher}"
												Margin="8,0,8,0"
												VerticalAlignment="Center"
												TextWrapping="Wrap"
												Foreground="{StaticResource SecondaryTextBrush}"/>

											<TextBlock
												Grid.Column="2"
												Text="{Binding Version}"
												Margin="8,0,8,0"
												VerticalAlignment="Center"
												TextTrimming="CharacterEllipsis"
												ToolTip="{Binding Version}"
												Foreground="{StaticResource SecondaryTextBrush}"/>

											<TextBlock
												Grid.Column="3"
												Text="{Binding InstallDate}"
												Margin="8,0,0,0"
												VerticalAlignment="Center"
												TextTrimming="CharacterEllipsis"
												ToolTip="{Binding InstallDate}"
												Foreground="{StaticResource SecondaryTextBrush}"/>

										</Grid>

									</Border>

								</DataTemplate>

							</ListBox.ItemTemplate>

						</ListBox>

					</ScrollViewer>

					<!-- DETALII APLICAȚIE SELECTATĂ -->

					<Border
                        Margin="0,18,0,0"
                        Padding="22"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="10">

						<Border.Style>

							<Style
                                TargetType="Border"
                                BasedOn="{StaticResource MetricCardBorderStyle}">

								<Setter
                                    Property="Visibility"
                                    Value="Visible"/>

								<Style.Triggers>

									<DataTrigger
                                        Binding="{Binding SelectedApplication}"
                                        Value="{x:Null}">

										<Setter
                                            Property="Visibility"
                                            Value="Collapsed"/>

									</DataTrigger>

								</Style.Triggers>

							</Style>

						</Border.Style>

						<StackPanel>

							<TextBlock
                                Text="{DynamicResource AppsDetailsTitle}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}"/>

							<TextBlock
                                Margin="0,6,0,18"
                                Text="{Binding SelectedApplication.DisplayName}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource AccentBrush}"/>

							<Grid>

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="2*"/>
									<ColumnDefinition Width="2*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0">

									<TextBlock
                                        Text="{DynamicResource AppsDetailsPublisher}"
                                        Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
                                        Margin="0,4,0,0"
                                        Text="{Binding SelectedApplication.Publisher}"
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource TextBrush}"/>

								</StackPanel>

								<StackPanel Grid.Column="1">

									<TextBlock
                                        Text="{DynamicResource AppsDetailsVersion}"
                                        Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
                                        Margin="0,4,0,0"
                                        Text="{Binding SelectedApplication.Version}"
                                        Foreground="{StaticResource TextBrush}"/>

								</StackPanel>

								<StackPanel Grid.Column="2">

									<TextBlock
                                        Text="{DynamicResource AppsDetailsInstallDate}"
                                        Foreground="{StaticResource SecondaryTextBrush}"/>

									<TextBlock
                                        Margin="0,4,0,0"
                                        Text="{Binding SelectedApplication.InstallDate}"
                                        Foreground="{StaticResource TextBrush}"/>

								</StackPanel>

							</Grid>

							<StackPanel Margin="0,18,0,0">

								<StackPanel Orientation="Horizontal">

									<Button
										MinWidth="175"
										Height="38"
										Content="{DynamicResource AppsCheckUpdate}"
										Command="{Binding CheckSelectedAppUpdateCommand}"/>

									<Button
										MinWidth="170"
										Height="38"
										Margin="12,0,0,0"
										Content="{DynamicResource AppsUpdateNow}"
										Command="{Binding UpdateSelectedAppCommand}"
										Visibility="{Binding CanUpdateSelectedApp,
                         Converter={StaticResource BooleanToVisibilityConverter}}"/>

									<Button
										MinWidth="190"
										Height="38"
										Margin="12,0,0,0"
										Content="{DynamicResource AppsOpenLocation}"
										Command="{Binding OpenSelectedAppLocationCommand}"/>

								</StackPanel>

								<TextBlock
									Margin="0,12,0,0"
									Text="{Binding SelectedAppUpdateStatusText}"
									TextWrapping="Wrap"
									Foreground="{StaticResource SecondaryTextBrush}"/>

							</StackPanel>

						</StackPanel>

					</Border>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>