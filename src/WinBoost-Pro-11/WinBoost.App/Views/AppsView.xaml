<UserControl
    x:Class="WinBoost.App.Views.AppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="Apps"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="Scanează și afișează aplicațiile instalate în Windows."
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU SCANARE -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock
                            Text="Installed Apps Check"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="{Binding ScanStatus,
                                           FallbackValue='Apasă Scan Apps pentru verificare.'}"
                            Margin="0,8,20,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="Scanarea este informativă și nu dezinstalează nicio aplicație."
                            Margin="0,6,20,0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<Border
                            Padding="12,7"
                            CornerRadius="6"
                            Background="#3A3A3A"
                            HorizontalAlignment="Center">

							<TextBlock
                                Text="{Binding ScanBadgeText,
                                               FallbackValue='Neverificat'}"
                                Foreground="{Binding ScanBadgeBrush,
                                                     FallbackValue=LightGray}"/>

						</Border>

						<Button
                            Content="{Binding ScanButtonText,
                                              FallbackValue='Scan Apps'}"
                            Command="{Binding ScanAppsCommand}"
                            Width="150"
                            Height="42"
                            Margin="0,10,0,0"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- LISTA APLICAȚIILOR -->

			<Border
                Grid.Row="2"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
                        Text="Aplicații instalate"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="Aici vor apărea aplicațiile identificate în urma scanării."
                        Margin="0,5,0,18"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- ANTET -->

					<Grid Margin="0,0,0,8">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<TextBlock
                            Text="Aplicație"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="1"
                            Text="Publisher"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="2"
                            Text="Versiune"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Grid.Column="3"
                            Text="Instalare"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</Grid>

					<Border
                        Height="1"
                        Margin="0,0,0,5"
                        Background="#454545"/>

					<!-- REZULTATE -->

					<ItemsControl ItemsSource="{Binding Applications}">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Border
                                    Margin="0,5"
                                    Padding="12"
                                    CornerRadius="6"
                                    Background="#303030">

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*"/>
											<ColumnDefinition Width="2*"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>

										<TextBlock
                                            Text="{Binding DisplayName}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource TextBrush}"/>

										<TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Publisher}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

										<TextBlock
                                            Grid.Column="2"
                                            Text="{Binding Version}"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

										<TextBlock
                                            Grid.Column="3"
                                            Text="{Binding InstallDate}"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

									</Grid>

								</Border>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>