<UserControl
    x:Class="WinBoost.App.Views.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Loaded="StartupView_Loaded">

	<UserControl.Resources>

		<!-- Bară orizontală pentru tabelul Startup Manager. -->
		<Style
			x:Key="StartupHorizontalScrollBarStyle"
			TargetType="ScrollBar">

			<Setter Property="Orientation" Value="Horizontal"/>
			<Setter Property="Height" Value="16"/>
			<Setter Property="MinWidth" Value="100"/>
			<Setter Property="Background" Value="#171A1E"/>
			<Setter Property="BorderBrush" Value="#424850"/>
			<Setter Property="BorderThickness" Value="1"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollBar">
						<Border
							Height="{TemplateBinding Height}"
							CornerRadius="7"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">

							<Track
								x:Name="PART_Track"
								Margin="3"
								Orientation="Horizontal"
								IsDirectionReversed="False">

								<Track.DecreaseRepeatButton>
									<RepeatButton
										Command="ScrollBar.PageLeftCommand"
										Focusable="False"
										IsTabStop="False"
										Opacity="0"/>
								</Track.DecreaseRepeatButton>

								<Track.Thumb>
									<Thumb
										MinWidth="55"
										Style="{StaticResource WinBoostScrollBarThumbStyle}"/>
								</Track.Thumb>

								<Track.IncreaseRepeatButton>
									<RepeatButton
										Command="ScrollBar.PageRightCommand"
										Focusable="False"
										IsTabStop="False"
										Opacity="0"/>
								</Track.IncreaseRepeatButton>

							</Track>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Bară verticală pentru tabelul Startup Manager. -->
		<Style
			x:Key="StartupVerticalScrollBarStyle"
			TargetType="ScrollBar">

			<Setter Property="Orientation" Value="Vertical"/>
			<Setter Property="Width" Value="16"/>
			<Setter Property="MinHeight" Value="80"/>
			<Setter Property="Background" Value="#171A1E"/>
			<Setter Property="BorderBrush" Value="#424850"/>
			<Setter Property="BorderThickness" Value="1"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollBar">
						<Border
							Width="{TemplateBinding Width}"
							CornerRadius="7"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">

							<Track
								x:Name="PART_Track"
								Margin="2"
								Orientation="Vertical"
								IsDirectionReversed="True">

								<Track.DecreaseRepeatButton>
									<RepeatButton
										Command="ScrollBar.PageUpCommand"
										Focusable="False"
										IsTabStop="False"
										Opacity="0"/>
								</Track.DecreaseRepeatButton>

								<Track.Thumb>
									<Thumb
										MinHeight="55"
										Style="{StaticResource WinBoostScrollBarThumbStyle}"/>
								</Track.Thumb>

								<Track.IncreaseRepeatButton>
									<RepeatButton
										Command="ScrollBar.PageDownCommand"
										Focusable="False"
										IsTabStop="False"
										Opacity="0"/>
								</Track.IncreaseRepeatButton>

							</Track>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ScrollViewer cu bara orizontală poziționată sus, ca în Services. -->
		<Style
			x:Key="StartupTopHorizontalScrollViewerStyle"
			TargetType="ScrollViewer">

			<Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
			<Setter Property="CanContentScroll" Value="False"/>

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ScrollViewer">
						<Grid>

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<ScrollBar
								x:Name="PART_HorizontalScrollBar"
								Grid.Row="0"
								Margin="0,0,0,10"
								Minimum="0"
								Maximum="{TemplateBinding ScrollableWidth}"
								Value="{TemplateBinding HorizontalOffset}"
								ViewportSize="{TemplateBinding ViewportWidth}"
								Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
								Style="{StaticResource StartupHorizontalScrollBarStyle}"/>

							<ScrollContentPresenter
								x:Name="PART_ScrollContentPresenter"
								Grid.Row="1"
								CanContentScroll="{TemplateBinding CanContentScroll}"
								Content="{TemplateBinding Content}"
								ContentTemplate="{TemplateBinding ContentTemplate}"
								Margin="{TemplateBinding Padding}"/>

						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ScrollViewer vertical cu bara poziționată în stânga. -->
		<Style
			x:Key="StartupLeftVerticalScrollViewerStyle"
			TargetType="ScrollViewer">

			<Setter
				Property="VerticalScrollBarVisibility"
				Value="Visible"/>

			<Setter
				Property="HorizontalScrollBarVisibility"
				Value="Disabled"/>

			<Setter
		       Property="CanContentScroll"
		       Value="True"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="ScrollViewer">

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<ScrollBar
								x:Name="PART_VerticalScrollBar"
								Grid.Column="0"
								Margin="0,0,10,0"
								Minimum="0"
								Maximum="{TemplateBinding ScrollableHeight}"
								Value="{TemplateBinding VerticalOffset}"
								ViewportSize="{TemplateBinding ViewportHeight}"
								Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
								Style="{StaticResource StartupVerticalScrollBarStyle}"/>

							<ScrollContentPresenter
								x:Name="PART_ScrollContentPresenter"
								Grid.Column="1"
								CanContentScroll="{TemplateBinding CanContentScroll}"
								Content="{TemplateBinding Content}"
								ContentTemplate="{TemplateBinding ContentTemplate}"
								Margin="{TemplateBinding Padding}"/>

						</Grid>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>
		
	</UserControl.Resources>

	<ScrollViewer
		Style="{StaticResource WinBoostPageScrollViewerStyle}">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource StartupPageTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="{DynamicResource StartupPageDescription}"
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU SCANARE -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="22"
                Style="{StaticResource InteractiveCardStyle}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">

						<StackPanel Orientation="Horizontal">

							<materialDesign:PackIcon
                                Kind="RocketLaunchOutline"
                                Width="24"
                                Height="24"
                                Margin="0,0,10,0"
                                Foreground="#00C853"/>

							<TextBlock
                                Text="{DynamicResource StartupScanPanelTitle}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}"/>

						</StackPanel>

						<TextBlock
                            Text="{Binding ScanStatus}"
                            Margin="0,10,20,0"
                            FontSize="14"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{DynamicResource StartupSafeChangesDescription}"
                            Margin="0,6,20,0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<Border
                            Padding="13,7"
                            CornerRadius="14"
                            Background="#30343A"
                            HorizontalAlignment="Center">

							<StackPanel Orientation="Horizontal">

								<Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Fill="{Binding ScanBadgeBrush}"/>

								<TextBlock
                                    Text="{Binding ScanBadgeText}"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding ScanBadgeBrush}"/>

							</StackPanel>

						</Border>

						<Button
                            Content="{Binding ScanButtonText}"
                            Command="{Binding ScanStartupCommand}"
                            Width="165"
                            Height="42"
                            Margin="0,12,0,0"
                            HorizontalContentAlignment="Center"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- STATISTICI -->

			<UniformGrid
                Grid.Row="2"
                Columns="3"
                Margin="0,20,0,0">

				<!-- TOTAL -->

				<Border
                    Margin="0,0,10,0"
                    Padding="17"
                    Style="{StaticResource InteractiveCardStyle}">

					<StackPanel>

						<StackPanel Orientation="Horizontal">

							<materialDesign:PackIcon
                                Kind="FormatListBulleted"
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                Foreground="#42A5F5"/>

							<TextBlock
                                Text="{DynamicResource StartupTotalLabel}"
                                Foreground="{StaticResource SecondaryTextBrush}"/>

						</StackPanel>

						<TextBlock
                            Text="{Binding TotalApplications}"
                            Margin="28,7,0,0"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextBrush}"/>

					</StackPanel>

				</Border>

				<!-- ACTIVATE -->

				<Border
                    Margin="5,0"
                    Padding="17"
                    Style="{StaticResource InteractiveCardStyle}">

					<StackPanel>

						<StackPanel Orientation="Horizontal">

							<materialDesign:PackIcon
                                Kind="CheckCircleOutline"
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                Foreground="#00C853"/>

							<TextBlock
                                Text="{DynamicResource StartupEnabledLabel}"
                                Foreground="{StaticResource SecondaryTextBrush}"/>

						</StackPanel>

						<TextBlock
                            Text="{Binding EnabledApplications}"
                            Margin="28,7,0,0"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#00C853"/>

					</StackPanel>

				</Border>

				<!-- DEZACTIVATE -->

				<Border
                    Margin="10,0,0,0"
                    Padding="17"
                    Style="{StaticResource InteractiveCardStyle}">

					<StackPanel>

						<StackPanel Orientation="Horizontal">

							<materialDesign:PackIcon
                                Kind="PauseCircleOutline"
                                Width="20"
                                Height="20"
                                Margin="0,0,8,0"
                                Foreground="#FFC107"/>

							<TextBlock
                                Text="{DynamicResource StartupDisabledLabel}"
                                Foreground="{StaticResource SecondaryTextBrush}"/>

						</StackPanel>

						<TextBlock
                            Text="{Binding DisabledApplications}"
                            Margin="28,7,0,0"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#FFC107"/>

					</StackPanel>

				</Border>

			</UniformGrid>

			<!-- LISTA APLICAȚIILOR -->

			<Border
                Grid.Row="3"
                Margin="0,20,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- TITLU -->

					<StackPanel Grid.Row="0">

						<StackPanel Orientation="Horizontal">

							<materialDesign:PackIcon
                                Kind="ApplicationCogOutline"
                                Width="24"
                                Height="24"
                                Margin="0,0,10,0"
                                Foreground="#AB47BC"/>

							<TextBlock
                                Text="{DynamicResource StartupApplicationsTitle}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}"/>

						</StackPanel>

						<TextBlock
                            Text="{DynamicResource StartupApplicationsDescription}"
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<!-- CĂUTARE ȘI FILTRARE -->

					<Grid
                        Grid.Row="1"
                        Margin="0,18,0,16">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="210"/>
						</Grid.ColumnDefinitions>

						<Grid Grid.Column="0">

							<materialDesign:PackIcon
                                Kind="Magnify"
                                Width="21"
                                Height="21"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="2"
                                IsHitTestVisible="False"
                                Foreground="#8F949C"/>

							<TextBox
                                Text="{Binding SearchText,
                                               UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint=
                                    "{DynamicResource StartupSearchPlaceholder}"
                                Padding="42,10,12,10"
                                FontSize="14"/>

						</Grid>

						<ComboBox
                            Grid.Column="1"
                            ItemsSource="{Binding StartupFilters}"
                            SelectedIndex="{Binding SelectedFilterIndex,
                                                    Mode=TwoWay}"
                            Margin="14,0,0,0"
                            Padding="10,7"
                            VerticalContentAlignment="Center"/>

					</Grid>

					<!-- SEPARATOR -->

					<Border
                        Grid.Row="2"
                        Height="1"
                        Margin="0,0,0,10"
                        Background="#454A50"/>

					<!-- DATAGRID -->

					<ScrollViewer
						Grid.Row="3"
						Style="{StaticResource StartupTopHorizontalScrollViewerStyle}">

						<DataGrid
							ItemsSource="{Binding StartupApplicationsView}"
							AutoGenerateColumns="False"
							FlowDirection="RightToLeft"
							CanUserAddRows="False"
							CanUserDeleteRows="False"
							CanUserResizeRows="False"
							CanUserReorderColumns="True"
							CanUserSortColumns="True"
							IsReadOnly="True"
							SelectionMode="Single"
							SelectionUnit="FullRow"
							HeadersVisibility="Column"
							GridLinesVisibility="Horizontal"
							HorizontalGridLinesBrush="#3A3E44"
							VerticalGridLinesBrush="Transparent"
							RowBackground="#292C31"
							AlternatingRowBackground="#25282D"
							Background="Transparent"
							BorderThickness="0"
							RowHeaderWidth="0"
							MinHeight="280"
							MaxHeight="520"
							MinWidth="1120"
							Width="Auto"
							HorizontalAlignment="Stretch"
							FontSize="14"
							Foreground="{StaticResource TextBrush}"
							HorizontalScrollBarVisibility="Disabled"
							VerticalScrollBarVisibility="Auto"
							ScrollViewer.CanContentScroll="True">

							<DataGrid.Resources>

								<!-- Doar bara verticală internă a DataGrid-ului. -->
								<Style
									TargetType="ScrollBar"
									BasedOn="{StaticResource StartupVerticalScrollBarStyle}"/>

								<!-- HEADER -->

								<Style TargetType="DataGridColumnHeader">

									<Setter
										Property="Background"
										Value="#24272B"/>

									<Setter
										Property="Foreground"
										Value="#B8BCC4"/>

									<Setter
										Property="FontWeight"
										Value="SemiBold"/>

									<Setter
										Property="Padding"
										Value="12,12"/>

									<Setter
										Property="BorderBrush"
										Value="#3A3E44"/>

									<Setter
										Property="BorderThickness"
										Value="0,0,0,1"/>

									<Setter
										Property="HorizontalContentAlignment"
										Value="Center"/>

									<Setter
										  Property="FontSize"
										  Value="14"/>

								</Style>

								<!-- RÂND -->

								<Style TargetType="DataGridRow">

									<Setter
										Property="MinHeight"
										Value="72"/>

									<Setter
										Property="BorderThickness"
										Value="0"/>

									<Setter
										Property="Cursor"
										Value="Arrow"/>

									<Style.Triggers>

										<Trigger
											Property="IsMouseOver"
											Value="True">

											<Setter
												Property="Background"
												Value="#31353B"/>

										</Trigger>

										<Trigger
											Property="IsSelected"
											Value="True">

											<Setter
												Property="Background"
												Value="#34413A"/>

											<Setter
												Property="Foreground"
												Value="White"/>

										</Trigger>

									</Style.Triggers>

								</Style>

								<!-- CELULĂ -->

								<Style TargetType="DataGridCell">

									<Setter
										Property="Padding"
										Value="11,8"/>

									<Setter
										Property="BorderThickness"
										Value="0"/>

									<Setter
										Property="VerticalContentAlignment"
										Value="Center"/>

									<Setter
										Property="FocusVisualStyle"
										Value="{x:Null}"/>

								</Style>

							</DataGrid.Resources>

							<DataGrid.Columns>

								<!-- APLICAȚIE -->

								<DataGridTemplateColumn
                                        Width="1.6*"
                                        MinWidth="185"
                                        DisplayIndex="6"
                                        SortMemberPath="Name">

									<DataGridTemplateColumn.Header>

										<TextBlock
                                            Text="{DynamicResource StartupColumnApplication}"/>

									</DataGridTemplateColumn.Header>

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<StackPanel>

												<TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}"
                                                        Foreground="{StaticResource TextBrush}"/>

												<TextBlock
                                                   Text="{Binding Description}"
                                                   Margin="0,4,0,0"
                                                     FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Description}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
											</StackPanel>

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

								<!-- PRODUCĂTOR -->

								<DataGridTemplateColumn
									Width="1.2*"
									MinWidth="145"
									DisplayIndex="5"
									SortMemberPath="Publisher">

									<DataGridTemplateColumn.Header>

										<TextBlock
											Text="{DynamicResource StartupColumnPublisher}"/>

									</DataGridTemplateColumn.Header>

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<TextBlock
												Text="{Binding Publisher}"
												TextTrimming="CharacterEllipsis"
												ToolTip="{Binding Publisher}"
												Foreground="{StaticResource TextBrush}"/>

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

								<!-- SURSĂ -->

								<DataGridTemplateColumn
									Width="1.15*"
									MinWidth="150"
									DisplayIndex="4"
									SortMemberPath="Source">

									<DataGridTemplateColumn.Header>

										<TextBlock
											Text="{DynamicResource StartupColumnSource}"/>

									</DataGridTemplateColumn.Header>

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<TextBlock
												Text="{Binding Source}"
												TextWrapping="Wrap"
												ToolTip="{Binding Source}"
												Foreground="{StaticResource SecondaryTextBrush}"/>

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

								<!-- STARE -->

								<DataGridTemplateColumn
									Width="140"
									MinWidth="140"
									DisplayIndex="3"
									SortMemberPath="IsEnabled">

									<DataGridTemplateColumn.Header>

										<TextBlock
											Text="{DynamicResource StartupColumnStatus}"/>

									</DataGridTemplateColumn.Header>

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<Border
												Padding="9,4"
												CornerRadius="12"
												HorizontalAlignment="Left">

												<Border.Style>

													<Style TargetType="Border">

														<Setter
															Property="Background"
															Value="#4A3510"/>

														<Style.Triggers>

															<DataTrigger
																Binding="{Binding IsEnabled}"
																Value="True">

																<Setter
																	Property="Background"
																	Value="#103F1F"/>

															</DataTrigger>

														</Style.Triggers>

													</Style>

												</Border.Style>

												<StackPanel
	                                            	Orientation="Horizontal"
		                                            VerticalAlignment="Center">

													<materialDesign:PackIcon
														Width="16"
														Height="16"
														Margin="0,0,6,0"
														VerticalAlignment="Center">

														<materialDesign:PackIcon.Style>

															<Style TargetType="materialDesign:PackIcon">

																<Setter
																	Property="Kind"
																	Value="PauseCircle"/>

																<Setter
																	Property="Foreground"
																	Value="#FFC107"/>

																<Style.Triggers>

																	<DataTrigger
																		Binding="{Binding IsEnabled}"
																		Value="True">

																		<Setter
																			Property="Kind"
																			Value="CheckCircle"/>

																		<Setter
																			Property="Foreground"
																			Value="#00E676"/>

																	</DataTrigger>

																</Style.Triggers>

															</Style>

														</materialDesign:PackIcon.Style>

													</materialDesign:PackIcon>

													<TextBlock
														Text="{Binding Status}"
														FontSize="14"
														FontWeight="SemiBold"
														VerticalAlignment="Center">

														<TextBlock.Style>

															<Style TargetType="TextBlock">

																<Setter
																	Property="Foreground"
																	Value="#FFC107"/>

																<Style.Triggers>

																	<DataTrigger
																		Binding="{Binding IsEnabled}"
																		Value="True">

																		<Setter
																			Property="Foreground"
																			Value="#00E676"/>

																	</DataTrigger>

																</Style.Triggers>

															</Style>

														</TextBlock.Style>

													</TextBlock>

												</StackPanel>

											</Border>

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

								<!-- IMPACT -->

								<DataGridTemplateColumn
                                     Width="110"
                                     MinWidth="110"
                                     DisplayIndex="2"
                                     SortMemberPath="StartupImpact">
									
									<DataGridTemplateColumn.Header>

										<TextBlock
											Text="{DynamicResource StartupColumnImpact}"/>

									</DataGridTemplateColumn.Header>

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<TextBlock
												Text="{Binding StartupImpact}"
												TextTrimming="CharacterEllipsis"
												ToolTip="{Binding StartupImpact}"
												Foreground="{StaticResource SecondaryTextBrush}"/>

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

								<!-- CALE -->

								<DataGridTemplateColumn
									Width="1.3*"
									MinWidth="200"
									DisplayIndex="1"
									SortMemberPath="ExecutablePath">

									<DataGridTemplateColumn.Header>

										<TextBlock
											Text="{DynamicResource StartupColumnPath}"/>

									</DataGridTemplateColumn.Header>

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<TextBlock
												Text="{Binding DisplayPath}"
												TextTrimming="CharacterEllipsis"
												ToolTip="{Binding Command}"
												Foreground="{StaticResource SecondaryTextBrush}"/>

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

								<!-- ACȚIUNE -->

								<DataGridTemplateColumn
	                                	Width="155"
	                                	MinWidth="155"
	                                	DisplayIndex="0">

									<DataGridTemplateColumn.Header>

										<TextBlock
											Text="{DynamicResource StartupColumnAction}"/>

									</DataGridTemplateColumn.Header>

									<DataGridTemplateColumn.CellTemplate>

										<DataTemplate>

											<Button
												Content="{Binding ActionText}"
												Command="{Binding DataContext.ToggleStartupCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
												CommandParameter="{Binding}"
												MinWidth="130"
												Height="36"
												Padding="12,5"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"/>

										</DataTemplate>

									</DataGridTemplateColumn.CellTemplate>

								</DataGridTemplateColumn>

							</DataGrid.Columns>

						</DataGrid>

					</ScrollViewer>

				</Grid>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>