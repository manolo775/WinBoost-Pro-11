<UserControl
    x:Class="WinBoost.App.Views.WindowsUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="Windows Update"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="Verifică starea actualizărilor și serviciile necesare pentru Windows Update."
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU VERIFICARE -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel>

						<TextBlock
                            Text="Windows Update Check"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="{Binding ScanStatus}"
                            Margin="0,8,20,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="Scanarea va fi informativă și nu va instala actualizări."
                            Margin="0,6,20,0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<!-- STATUS -->

						<Border
                            Padding="12,7"
                            CornerRadius="6"
                            HorizontalAlignment="Center">

							<Border.Style>

								<Style TargetType="Border">

									<Setter
                                        Property="Background"
                                        Value="#3A3A3A"/>

									<Style.Triggers>

										<DataTrigger
                                            Binding="{Binding ScanBadgeText}"
                                            Value="Se verifică">

											<Setter
                                                Property="Background"
                                                Value="#664500"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanBadgeText}"
                                            Value="Verificat">

											<Setter
                                                Property="Background"
                                                Value="#164A29"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanBadgeText}"
                                            Value="Eroare">

											<Setter
                                                Property="Background"
                                                Value="#5A2020"/>

										</DataTrigger>

									</Style.Triggers>

								</Style>

							</Border.Style>

							<TextBlock
                                Text="{Binding ScanBadgeText}">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
                                            Property="Foreground"
                                            Value="{StaticResource SecondaryTextBrush}"/>

										<Style.Triggers>

											<DataTrigger
                                                Binding="{Binding ScanBadgeText}"
                                                Value="Se verifică">

												<Setter
                                                    Property="Foreground"
                                                    Value="Orange"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanBadgeText}"
                                                Value="Verificat">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanBadgeText}"
                                                Value="Eroare">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FF5252"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>

						</Border>

						<!-- BUTON SCANARE -->

						<Button
                            Content="{Binding ScanButtonText}"
                            Command="{Binding ScanUpdatesCommand}"
                            Width="150"
                            Height="42"
                            Margin="0,10,0,0"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- REZULTAT -->

			<Border
                Grid.Row="2"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
                        Text="Rezultatul verificării"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="{Binding ScanStatus}"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>