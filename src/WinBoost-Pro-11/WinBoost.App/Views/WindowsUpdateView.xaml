<UserControl
    x:Class="WinBoost.App.Views.WindowsUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>

		<!-- Scrollbar dark pentru pagina Windows Update -->

		<Style
            x:Key="WindowsUpdateScrollBarStyle"
            TargetType="ScrollBar">

			<Setter Property="Width" Value="12"/>
			<Setter Property="Background" Value="#171A1E"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="ScrollBar">

						<Grid
                            Width="12"
                            Background="{TemplateBinding Background}">

							<Track
                                x:Name="PART_Track"
                                Focusable="False"
                                IsDirectionReversed="True">

								<Track.DecreaseRepeatButton>

									<RepeatButton
                                        Command="{x:Static ScrollBar.PageUpCommand}"
                                        Focusable="False"
                                        Opacity="0"/>

								</Track.DecreaseRepeatButton>

								<Track.Thumb>

									<Thumb
                                        Width="8"
                                        Margin="2">

										<Thumb.Template>

											<ControlTemplate TargetType="Thumb">

												<Border
                                                    x:Name="ThumbBorder"
                                                    CornerRadius="4"
                                                    Background="#4A5058"/>

												<ControlTemplate.Triggers>

													<Trigger
                                                        Property="IsMouseOver"
                                                        Value="True">

														<Setter
                                                            TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="#626A74"/>

													</Trigger>

													<Trigger
                                                        Property="IsDragging"
                                                        Value="True">

														<Setter
                                                            TargetName="ThumbBorder"
                                                            Property="Background"
                                                            Value="#4CAF50"/>

													</Trigger>

												</ControlTemplate.Triggers>

											</ControlTemplate>

										</Thumb.Template>

									</Thumb>

								</Track.Thumb>

								<Track.IncreaseRepeatButton>

									<RepeatButton
                                        Command="{x:Static ScrollBar.PageDownCommand}"
                                        Focusable="False"
                                        Opacity="0"/>

								</Track.IncreaseRepeatButton>

							</Track>

						</Grid>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>

	</UserControl.Resources>

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<ScrollViewer.Resources>

			<Style
                TargetType="ScrollBar"
                BasedOn="{StaticResource WindowsUpdateScrollBarStyle}"/>

		</ScrollViewer.Resources>

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource WindowsUpdatePageTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="{DynamicResource WindowsUpdatePageDescription}"
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU VERIFICARE -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                 Style="{StaticResource MetricCardBorderStyle}"
                 Padding="22">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">

						<TextBlock
                            Text="{DynamicResource WindowsUpdateCheckTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="{Binding ScanStatus}"
                            Margin="0,8,20,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{DynamicResource WindowsUpdateSafeScanDescription}"
                            Margin="0,6,20,0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<!-- STATUS -->

						<Border
                            Padding="12,7"
                            CornerRadius="6"
                            HorizontalAlignment="Center">

							<Border.Style>

								<Style TargetType="Border">

									<Setter
                                        Property="Background"
                                        Value="#3A3A3A"/>

									<Style.Triggers>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="Checking">

											<Setter
                                                Property="Background"
                                                Value="#664500"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="Warning">

											<Setter
                                                Property="Background"
                                                Value="#664500"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="Checked">

											<Setter
                                                Property="Background"
                                                Value="#164A29"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="UpdatesAvailable">

											<Setter
                                                Property="Background"
                                                Value="#164A29"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="Error">

											<Setter
                                                Property="Background"
                                                Value="#5A2020"/>

										</DataTrigger>

									</Style.Triggers>

								</Style>

							</Border.Style>

							<TextBlock
                                Text="{Binding ScanBadgeText}">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
                                            Property="Foreground"
                                            Value="{StaticResource SecondaryTextBrush}"/>

										<Style.Triggers>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="Checking">

												<Setter
                                                    Property="Foreground"
                                                    Value="Orange"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="Warning">

												<Setter
                                                    Property="Foreground"
                                                    Value="Orange"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="Checked">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="UpdatesAvailable">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="Error">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FF5252"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>

						</Border>

						<!-- BUTON SCANARE -->

						<Button
                            Content="{Binding ScanButtonText}"
                            Command="{Binding ScanUpdatesCommand}"
                            Width="180"
                            Height="42"
                            Margin="0,10,0,0"
                            HorizontalContentAlignment="Center"/>

						<Button
                             Content="{Binding InstallButtonText}"
                             Command="{Binding InstallUpdatesCommand}"
                             Width="180"
                             Height="42"
                             Margin="0,10,0,0"
                             HorizontalContentAlignment="Center"
                             IsEnabled="{Binding CanInstallUpdates}"/>
						
					</StackPanel>

				</Grid>

			</Border>

			<!-- REZULTAT -->

			<Border
                Grid.Row="2"
                Margin="0,25,0,0"
                Style="{StaticResource MetricCardBorderStyle}"
				Padding="22">

				<StackPanel>

					<TextBlock
                        Text="{DynamicResource WindowsUpdateResultTitle}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="{Binding ScanStatus}"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- SEPARATOR -->

					<Border
                        Height="1"
                        Margin="0,18,0,16"
                        Background="#454A50"/>

					<!-- ACTUALIZARI DISPONIBILE -->

					<TextBlock
                        Text="{DynamicResource WindowsUpdateAvailableUpdatesTitle}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<ItemsControl
                        ItemsSource="{Binding AvailableUpdates}"
                        Margin="0,12,0,0">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Border
                                    Margin="0,0,0,10"
                                    Padding="14"
                                    CornerRadius="7"
                                    Background="#24272B">

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="180"/>
										</Grid.ColumnDefinitions>

										<!-- DETALII UPDATE -->

										<StackPanel
                                            Grid.Column="0"
                                            Margin="0,0,20,0">

											<TextBlock
                                                Text="{Binding Title}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource TextBrush}"/>

											<!--
                                                Descriere compactă.
                                                Textul complet rămâne disponibil
                                                în ToolTip.
                                            -->

											<TextBlock
                                                Text="{Binding Description}"
                                                ToolTip="{Binding Description}"
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                LineHeight="16"
                                                MaxHeight="48"
                                                TextWrapping="Wrap"
                                                ClipToBounds="True"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

										</StackPanel>

										<!-- STATUS UPDATE -->

										<StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center">

											<TextBlock
                                                Text="{DynamicResource WindowsUpdateDownloadedLabel}"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

											<TextBlock
                                                Text="{Binding IsDownloaded}"
                                                Margin="0,3,0,10"
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextBrush}"/>

											<TextBlock
                                                Text="{DynamicResource WindowsUpdateRestartRequiredLabel}"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

											<TextBlock
                                                Text="{Binding RebootRequired}"
                                                Margin="0,3,0,0"
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextBrush}"/>

										</StackPanel>

									</Grid>

								</Border>

								
							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

			</Border>

			<!-- WINDOWS UPDATE ADVISOR -->

			<Border
				Grid.Row="3"
				Margin="0,25,0,0"
				Style="{StaticResource MetricCardBorderStyle}"
				Padding="22">

				<StackPanel>

					<!-- TITLU -->

					<TextBlock
						Text="{DynamicResource WindowsUpdateAdvisorTitle}"
						FontSize="20"
						FontWeight="SemiBold"
						Foreground="{StaticResource TextBrush}"/>


					<!-- STARE -->

					<TextBlock
						Text="{Binding AdvisorStatusText, Mode=OneWay}"
						Margin="0,14,0,0"
						FontSize="16"
						FontWeight="SemiBold"
						Foreground="#39C85A"/>


					<!-- EXPLICAȚIE -->

					<TextBlock
						Text="{Binding AdvisorMessage, Mode=OneWay}"
						Margin="0,5,0,0"
						FontSize="13"
						TextWrapping="Wrap"
						Foreground="{StaticResource SecondaryTextBrush}"/>


					<!-- RECOMANDARE -->

					<StackPanel
						Orientation="Horizontal"
						Margin="0,12,0,0">

						<TextBlock
							Text="{DynamicResource WindowsUpdateAdvisorRecommended}"
							FontSize="13"
							FontWeight="SemiBold"
							Foreground="{StaticResource TextBrush}"/>

						<TextBlock
							Text=" "
							FontSize="13"/>

						<TextBlock
							Text="{Binding AdvisorRecommendation, Mode=OneWay}"
							FontSize="13"
							FontWeight="SemiBold"
							TextWrapping="Wrap"
							Foreground="{StaticResource TextBrush}"/>

					</StackPanel>


					<!-- SEPARATOR -->

					<Border
						Height="1"
						Margin="0,16,0,13"
						Background="#454545"/>


					<!-- CATEGORII UPDATE -->

					<TextBlock
						TextWrapping="Wrap"
						Foreground="{StaticResource SecondaryTextBrush}">

						<Run
							Text="{DynamicResource WindowsUpdateAdvisorSecurity}"/>

						<Run Text=" "/>

						<Run
							Text="{Binding SecurityUpdateCount, Mode=OneWay}"
							FontWeight="SemiBold"/>


						<Run Text="     "/>


						<Run
							Text="{DynamicResource WindowsUpdateAdvisorSystem}"/>

						<Run Text=" "/>

						<Run
							Text="{Binding SystemUpdateCount, Mode=OneWay}"
							FontWeight="SemiBold"/>


						<Run Text="     "/>


						<Run
							Text="{DynamicResource WindowsUpdateAdvisorDriver}"/>

						<Run Text=" "/>

						<Run
							Text="{Binding DriverUpdateCount, Mode=OneWay}"
							FontWeight="SemiBold"/>


						<Run Text="     "/>


						<Run
							Text="{DynamicResource WindowsUpdateAdvisorOptional}"/>

						<Run Text=" "/>

						<Run
							Text="{Binding OptionalUpdateCount, Mode=OneWay}"
							FontWeight="SemiBold"/>

					</TextBlock>


					<!-- TOTAL RECOMANDATE -->

					<TextBlock
						Margin="0,10,0,0"
						TextWrapping="Wrap"
						Foreground="{StaticResource TextBrush}">

						<Run
							Text="{DynamicResource WindowsUpdateAdvisorRecommended}"/>

						<Run Text=" "/>

						<Run
							Text="{Binding RecommendedUpdateCount, Mode=OneWay}"
							FontWeight="SemiBold"/>

					</TextBlock>

				</StackPanel>

			</Border>
			
			<!-- PROGRES INSTALARE WINDOWS UPDATE -->

			<Border
		       Grid.Row="4"
		       Margin="0,25,0,0"
		    
		       Padding="22">

					<Border.Style>
						<Style
							TargetType="Border"
							BasedOn="{StaticResource MetricCardBorderStyle}">
						<Setter Property="Visibility" Value="Collapsed"/>

						<Style.Triggers>

							<DataTrigger
								Binding="{Binding IsInstallingUpdates}"
								Value="True">

								<Setter
									Property="Visibility"
									Value="Visible"/>

							</DataTrigger>

						</Style.Triggers>
					</Style>
				</Border.Style>

				<StackPanel>

					<TextBlock
						Text="Windows Update"
						FontSize="20"
						FontWeight="SemiBold"
						Foreground="{StaticResource TextBrush}"/>

					<TextBlock
						Text="{Binding InstallationMessage}"
						Margin="0,10,0,0"
						TextWrapping="Wrap"
						Foreground="{StaticResource SecondaryTextBrush}"/>

					<TextBlock
						Text="{Binding CurrentUpdateTitle}"
						Margin="0,8,0,0"
						FontWeight="SemiBold"
						TextWrapping="Wrap"
						Foreground="{StaticResource TextBrush}"/>
					<ProgressBar
    Minimum="0"
    Maximum="100"
    Value="{Binding InstallationPercent, Mode=OneWay}"
    Height="12"
    Margin="0,18,0,0"/>

					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Right"
						Foreground="{StaticResource SecondaryTextBrush}">

						<Run Text="{Binding InstallationPercent, Mode=OneWay}"/>
						<Run Text="%"/>
					</TextBlock>

					<TextBlock
						Text="{Binding InstallationState}"
						Margin="0,4,0,0"
						FontSize="12"
						Foreground="{StaticResource SecondaryTextBrush}"/>

				</StackPanel>

			</Border>
			
		</Grid>

	</ScrollViewer>

</UserControl>