<UserControl
    x:Class="WinBoost.App.Views.WindowsUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

		<Grid Margin="30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- TITLU -->

			<StackPanel Grid.Row="0">

				<TextBlock
                    Text="{DynamicResource WindowsUpdatePageTitle}"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"/>

				<TextBlock
                    Text="{DynamicResource WindowsUpdatePageDescription}"
                    Margin="0,6,0,0"
                    FontSize="14"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

			</StackPanel>

			<!-- PANOU VERIFICARE -->

			<Border
                Grid.Row="1"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<Grid>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">

						<TextBlock
                            Text="{DynamicResource WindowsUpdateCheckTitle}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

						<TextBlock
                            Text="{Binding ScanStatus}"
                            Margin="0,8,20,0"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

						<TextBlock
                            Text="{DynamicResource WindowsUpdateSafeScanDescription}"
                            Margin="0,6,20,0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

					</StackPanel>

					<StackPanel
                        Grid.Column="1"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center">

						<!-- STATUS -->

						<Border
                            Padding="12,7"
                            CornerRadius="6"
                            HorizontalAlignment="Center">

							<Border.Style>

								<Style TargetType="Border">

									<Setter
                                        Property="Background"
                                        Value="#3A3A3A"/>

									<Style.Triggers>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="Checking">

											<Setter
                                                Property="Background"
                                                Value="#664500"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="Warning">

											<Setter
                                                Property="Background"
                                                Value="#664500"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="Checked">

											<Setter
                                                Property="Background"
                                                Value="#164A29"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="UpdatesAvailable">

											<Setter
                                                Property="Background"
                                                Value="#164A29"/>

										</DataTrigger>

										<DataTrigger
                                            Binding="{Binding ScanState}"
                                            Value="Error">

											<Setter
                                                Property="Background"
                                                Value="#5A2020"/>

										</DataTrigger>

									</Style.Triggers>

								</Style>

							</Border.Style>

							<TextBlock
                                Text="{Binding ScanBadgeText}">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
                                            Property="Foreground"
                                            Value="{StaticResource SecondaryTextBrush}"/>

										<Style.Triggers>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="Checking">

												<Setter
                                                    Property="Foreground"
                                                    Value="Orange"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="Warning">

												<Setter
                                                    Property="Foreground"
                                                    Value="Orange"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="Checked">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="UpdatesAvailable">

												<Setter
                                                    Property="Foreground"
                                                    Value="#00C853"/>

											</DataTrigger>

											<DataTrigger
                                                Binding="{Binding ScanState}"
                                                Value="Error">

												<Setter
                                                    Property="Foreground"
                                                    Value="#FF5252"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>

						</Border>

						<!-- BUTON SCANARE -->

						<Button
                            Content="{Binding ScanButtonText}"
                            Command="{Binding ScanUpdatesCommand}"
                            Width="180"
                            Height="42"
                            Margin="0,10,0,0"
                            HorizontalContentAlignment="Center"/>

					</StackPanel>

				</Grid>

			</Border>

			<!-- REZULTAT -->

			<Border
                Grid.Row="2"
                Margin="0,25,0,0"
                Padding="22"
                CornerRadius="10"
                Background="{StaticResource CardBrush}">

				<StackPanel>

					<TextBlock
                        Text="{DynamicResource WindowsUpdateResultTitle}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<TextBlock
                        Text="{Binding ScanStatus}"
                        Margin="0,8,0,0"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

					<!-- SEPARATOR -->

					<Border
                        Height="1"
                        Margin="0,18,0,16"
                        Background="#454A50"/>

					<!-- ACTUALIZARI DISPONIBILE -->

					<TextBlock
                        Text="{DynamicResource WindowsUpdateAvailableUpdatesTitle}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"/>

					<ItemsControl
                        ItemsSource="{Binding AvailableUpdates}"
                        Margin="0,12,0,0">

						<ItemsControl.ItemTemplate>

							<DataTemplate>

								<Border
                                    Margin="0,0,0,10"
                                    Padding="14"
                                    CornerRadius="7"
                                    Background="#24272B">

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="180"/>
										</Grid.ColumnDefinitions>

										<!-- DETALII UPDATE -->

										<StackPanel
                                            Grid.Column="0"
                                            Margin="0,0,20,0">

											<TextBlock
                                                Text="{Binding Title}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource TextBrush}"/>

											<TextBlock
                                                Text="{Binding Description}"
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

										</StackPanel>

										<!-- STATUS UPDATE -->

										<StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center">

											<TextBlock
                                                Text="{DynamicResource WindowsUpdateDownloadedLabel}"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

											<TextBlock
                                                Text="{Binding IsDownloaded}"
                                                Margin="0,3,0,10"
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextBrush}"/>

											<TextBlock
                                                Text="{DynamicResource WindowsUpdateRestartRequiredLabel}"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>

											<TextBlock
                                                Text="{Binding RebootRequired}"
                                                Margin="0,3,0,0"
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextBrush}"/>

										</StackPanel>

									</Grid>

								</Border>

							</DataTemplate>

						</ItemsControl.ItemTemplate>

					</ItemsControl>

				</StackPanel>

			</Border>

		</Grid>

	</ScrollViewer>

</UserControl>