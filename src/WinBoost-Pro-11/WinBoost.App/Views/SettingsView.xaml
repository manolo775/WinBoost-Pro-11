<UserControl
    x:Class="WinBoost.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="clr-namespace:WinBoost.App.Helpers"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="900">

	<ScrollViewer
    Style="{StaticResource WinBoostPageScrollViewerStyle}"
    HorizontalScrollBarVisibility="Disabled">

		<Grid
			Margin="0,0,0,20"
			Background="#1E1E1E">

			<StackPanel Margin="40,20,40,0">

				<TextBlock
					Text="{DynamicResource SettingsTitle}"
					FontSize="32"
					FontWeight="Bold"
					Foreground="White"/>

				<TextBlock
					Margin="0,8,0,0"
					Text="{DynamicResource SettingsDescription}"
					FontSize="15"
					TextWrapping="Wrap"
					Foreground="#BDBDBD"/>

				<!-- MOD DE RULARE -->

				<Border
					Margin="0,18,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<Grid>

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel
							Grid.Column="0"
							Margin="0,0,24,0">

							<TextBlock
								Text="{DynamicResource SettingsPrivilegeModeTitle}"
								FontSize="20"
								FontWeight="SemiBold"
								Foreground="White"/>

							<TextBlock
								Margin="0,6,0,0"
								Text="{DynamicResource SettingsPrivilegeModeDescription}"
								TextWrapping="Wrap"
								Foreground="#BDBDBD"/>

							<StackPanel
								Margin="0,14,0,0"
								Orientation="Horizontal">

								<TextBlock
									Text="{DynamicResource SettingsPrivilegeCurrentMode}"
									FontSize="16"
									FontWeight="SemiBold"
									Foreground="White"/>

								<TextBlock
									Margin="8,0,0,0"
									Text="{Binding CurrentPrivilegeModeText}"
									FontSize="16"
									FontWeight="Bold"
									Foreground="#FFD740"/>

							</StackPanel>

						</StackPanel>

						<Button
							Grid.Column="1"
							MinWidth="220"
							Height="40"
							Padding="14,5"
							VerticalAlignment="Center"
							Content="{Binding RestartPrivilegeButtonText}"
							Command="{Binding RestartWithDifferentPrivilegesCommand}"
							Background="#25272B"
							Foreground="White"
							BorderBrush="#FFD740"
							BorderThickness="1"/>

					</Grid>

				</Border>

				<!-- ALERTE -->

				<Border
					Margin="0,28,0,0"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}"
					Cursor="Hand"
					RenderTransformOrigin="0.5,0.5"
					MouseLeftButtonUp="AlertsCard_MouseLeftButtonUp">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsAlertsTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,18"
							Text="{DynamicResource SettingsAlertsDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<CheckBox
							IsChecked="{Binding AlertsEnabled,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
							Foreground="White">

							<StackPanel>

								<TextBlock
									Text="{DynamicResource SettingsAlertsEnabled}"
									FontSize="16"
									FontWeight="SemiBold"
									Foreground="White"/>

								<TextBlock
									Margin="0,4,0,0"
									Text="{DynamicResource SettingsAlertsEnabledDescription}"
									TextWrapping="Wrap"
									Foreground="#BDBDBD"/>

							</StackPanel>

						</CheckBox>

					</StackPanel>

				</Border>

				<!-- PROCESOR -->

				<Border
					Margin="0,18,0,0"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsCpuThresholdsTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,20"
							Text="{DynamicResource SettingsCpuThresholdsDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<TextBlock
							Text="{DynamicResource SettingsWarningThreshold}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,18">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="60"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="1"
								Maximum="100"
								TickFrequency="1"
								IsSnapToTickEnabled="True"
								Value="{Binding CpuWarningThreshold,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding CpuWarningThreshold,
                                           StringFormat={}{0:0}%}"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FFD740"/>

						</Grid>

						<TextBlock
							Text="{DynamicResource SettingsCriticalThreshold}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,0">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="60"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="1"
								Maximum="100"
								TickFrequency="1"
								IsSnapToTickEnabled="True"
								Value="{Binding CpuCriticalThreshold,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding CpuCriticalThreshold,
                                           StringFormat={}{0:0}%}"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FF5722"/>

						</Grid>

					</StackPanel>

				</Border>

				<!-- MEMORIE RAM -->

				<Border
					Margin="0,18,0,0"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsRamThresholdsTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,20"
							Text="{DynamicResource SettingsRamThresholdsDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<TextBlock
							Text="{DynamicResource SettingsWarningThreshold}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,18">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="60"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="1"
								Maximum="100"
								TickFrequency="1"
								IsSnapToTickEnabled="True"
								Value="{Binding RamWarningThreshold,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding RamWarningThreshold,
                                           StringFormat={}{0:0}%}"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FFD740"/>

						</Grid>

						<TextBlock
							Text="{DynamicResource SettingsCriticalThreshold}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,0">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="60"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="1"
								Maximum="100"
								TickFrequency="1"
								IsSnapToTickEnabled="True"
								Value="{Binding RamCriticalThreshold,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding RamCriticalThreshold,
                                           StringFormat={}{0:0}%}"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FF5722"/>

						</Grid>

					</StackPanel>

				</Border>

				<!-- DISC -->

				<Border
					Margin="0,18,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsDiskThresholdsTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,20"
							Text="{DynamicResource SettingsDiskThresholdsDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<TextBlock
							Text="{DynamicResource SettingsWarningThreshold}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,18">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="60"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="1"
								Maximum="100"
								TickFrequency="1"
								IsSnapToTickEnabled="True"
								Value="{Binding DiskWarningThreshold,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding DiskWarningThreshold,
                                           StringFormat={}{0:0}%}"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FFD740"/>

						</Grid>

						<TextBlock
							Text="{DynamicResource SettingsCriticalThreshold}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,0">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="60"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="1"
								Maximum="100"
								TickFrequency="1"
								IsSnapToTickEnabled="True"
								Value="{Binding DiskCriticalThreshold,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding DiskCriticalThreshold,
                                           StringFormat={}{0:0}%}"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FF5722"/>

						</Grid>

					</StackPanel>

				</Border>

				<!-- TEMPERATURĂ PROCESOR -->

				<Border
					Margin="0,18,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsCpuTemperatureThresholdsTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,20"
							Text="{DynamicResource SettingsCpuTemperatureThresholdsDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<TextBlock
							Text="{DynamicResource SettingsWarningThreshold}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,18">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="70"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="30"
								Maximum="110"
								TickFrequency="1"
								IsSnapToTickEnabled="True"
								Value="{Binding CpuTemperatureWarningThreshold,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding CpuTemperatureWarningThreshold,
                               StringFormat={}{0:0} °C}"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FFD740"/>

						</Grid>

						<TextBlock
							Text="{DynamicResource SettingsCriticalThreshold}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,0">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="70"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="30"
								Maximum="110"
								TickFrequency="1"
								IsSnapToTickEnabled="True"
								Value="{Binding CpuTemperatureCriticalThreshold,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock
								Grid.Column="1"
								Text="{Binding CpuTemperatureCriticalThreshold,
                               StringFormat={}{0:0} °C}"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FF5722"/>

						</Grid>

					</StackPanel>

				</Border>

				<!-- DURATA MINIMĂ A ALERTEI -->

				<Border
					Margin="0,18,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsAlertTimingTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,20"
							Text="{DynamicResource SettingsAlertTimingDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<TextBlock
							Text="{DynamicResource SettingsSustainedDuration}"
							FontSize="16"
							FontWeight="SemiBold"
							Foreground="White"/>

						<Grid Margin="0,8,0,0">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="120"/>
							</Grid.ColumnDefinitions>

							<Slider
								Grid.Column="0"
								Minimum="5"
								Maximum="300"
								TickFrequency="5"
								IsSnapToTickEnabled="True"
								Value="{Binding SustainedDurationSeconds,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

							<StackPanel
								Grid.Column="1"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								VerticalAlignment="Center">

								<TextBlock
									Text="{Binding SustainedDurationSeconds}"
									FontSize="16"
									FontWeight="SemiBold"
									Foreground="#4CAF50"/>

								<TextBlock
									Margin="5,0,0,0"
									Text="{DynamicResource SettingsSeconds}"
									FontSize="16"
									Foreground="#BDBDBD"/>

							</StackPanel>

						</Grid>

					</StackPanel>

				</Border>

				<!-- ALERTE CRITICE -->

				<Border
					Margin="0,18,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsCriticalAlertsTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,20"
							Text="{DynamicResource SettingsCriticalAlertsDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<CheckBox
							IsChecked="{Binding EnableSoundForCriticalAlerts,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
							Foreground="White">

							<TextBlock
								Text="{DynamicResource SettingsCriticalAlertSound}"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="White"/>

						</CheckBox>

						<Grid Margin="0,22,0,0">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="180"/>
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Column="0"
								Text="{DynamicResource SettingsCriticalAlertRepeat}"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="White"/>

							<ComboBox
								Grid.Column="1"
								Height="34"
								SelectedValuePath="Tag"
								SelectedValue="{Binding CriticalAlertRepeatIntervalMinutes,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
								Foreground="Black"
								Background="White"
								VerticalContentAlignment="Center">

								<ComboBoxItem
									Tag="0"
									Content="{DynamicResource SettingsRepeatNever}"/>

								<ComboBoxItem
									Tag="5"
									Content="{DynamicResource SettingsRepeatAfter5Minutes}"/>

								<ComboBoxItem
									Tag="15"
									Content="{DynamicResource SettingsRepeatAfter15Minutes}"/>

								<ComboBoxItem
									Tag="30"
									Content="{DynamicResource SettingsRepeatAfter30Minutes}"/>

							</ComboBox>

						</Grid>

					</StackPanel>

				</Border>

				<!-- TIPURI DE ALERTE -->

				<Border
					Margin="0,18,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsAlertSourcesTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,18"
							Text="{DynamicResource SettingsAlertSourcesDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<CheckBox
							Margin="0,0,0,12"
							IsChecked="{Binding CpuAlertsEnabled,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
							Foreground="White">

							<TextBlock
								Text="{DynamicResource SettingsCpuAlertsEnabled}"
								FontSize="16"
								Foreground="White"/>

						</CheckBox>

						<CheckBox
							Margin="0,0,0,12"
							IsChecked="{Binding RamAlertsEnabled,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
							Foreground="White">

							<TextBlock
								Text="{DynamicResource SettingsRamAlertsEnabled}"
								FontSize="16"
								Foreground="White"/>

						</CheckBox>

						<CheckBox
							Margin="0,0,0,12"
							IsChecked="{Binding DiskAlertsEnabled,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
							Foreground="White">

							<TextBlock
								Text="{DynamicResource SettingsDiskAlertsEnabled}"
								FontSize="16"
								Foreground="White"/>

						</CheckBox>

						<CheckBox
							IsChecked="{Binding CpuTemperatureAlertsEnabled,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
							Foreground="White">

							<TextBlock
								Text="{DynamicResource SettingsCpuTemperatureAlertsEnabled}"
								FontSize="16"
								Foreground="White"/>

						</CheckBox>

					</StackPanel>

				</Border>

				<!-- ISTORIC PERFORMANȚĂ -->

				<Border
					Margin="0,18,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsHistoryTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,20"
							Text="{DynamicResource SettingsHistoryDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="180"/>
							</Grid.ColumnDefinitions>

							<TextBlock
								Grid.Column="0"
								Text="{DynamicResource SettingsHistoryRetention}"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="White"/>

							<ComboBox
								Grid.Column="1"
								Height="34"
								SelectedValuePath="Tag"
								SelectedValue="{Binding HistoryRetentionDays,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
								Foreground="Black"
								Background="White"
								VerticalContentAlignment="Center">

								<ComboBoxItem
									Tag="7"
									Content="{DynamicResource SettingsHistory7Days}"/>

								<ComboBoxItem
									Tag="14"
									Content="{DynamicResource SettingsHistory14Days}"/>

								<ComboBoxItem
									Tag="30"
									Content="{DynamicResource SettingsHistory30Days}"/>

								<ComboBoxItem
									Tag="90"
									Content="{DynamicResource SettingsHistory90Days}"/>

							</ComboBox>

						</Grid>

						<Border
    Margin="0,22,0,0"
    Padding="16"
    Background="#25272B"
    CornerRadius="8">

							<Grid>

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<TextBlock
									Grid.Column="0"
									Margin="0,0,18,0"
									Text="{DynamicResource SettingsClearHistoryDescription}"
									TextWrapping="Wrap"
									VerticalAlignment="Center"
									Foreground="#BDBDBD"/>

								<Button
									Grid.Column="1"
									MinWidth="145"
									Height="36"
									Padding="12,5"
									Content="{DynamicResource SettingsClearHistory}"
									Command="{Binding ClearHistoryCommand}"
									Background="#7F1D1D"
									Foreground="White"
									BorderBrush="#EF5350"
									BorderThickness="1"/>

							</Grid>

						</Border>

						<!-- RESTABILIRE SETĂRI -->

						<Border
							Margin="0,18,0,20"
							Padding="22"
							Background="#2D3035"
							CornerRadius="12"
							Style="{StaticResource MetricCardBorderStyle}">

							<Grid>

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0">

									<TextBlock
										Text="{DynamicResource SettingsResetTitle}"
										FontSize="20"
										FontWeight="SemiBold"
										Foreground="White"/>

									<TextBlock
										Margin="0,6,18,0"
										Text="{DynamicResource SettingsResetDescription}"
										TextWrapping="Wrap"
										Foreground="#BDBDBD"/>

								</StackPanel>

								<Button
									Grid.Column="1"
									MinWidth="180"
									Height="38"
									Padding="12,5"
									VerticalAlignment="Center"
									Content="{DynamicResource SettingsResetButton}"
									Command="{Binding ResetSettingsCommand}"
									Background="#25272B"
									Foreground="White"
									BorderBrush="#FFD740"
									BorderThickness="1"/>

							</Grid>

						</Border>

					</StackPanel>

				</Border>

				<!-- ====================================== -->
				<!-- LICENȚĂ WINBOOST -->
				<!-- ====================================== -->

				<Border
					Margin="0,0,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<Border.Resources>

						<!-- BUTOANE LICENȚĂ -->

						<Style
							x:Key="LicenseActionButtonStyle"
							TargetType="Button">

							<Setter
								Property="Height"
								Value="44"/>

							<Setter
								Property="Padding"
								Value="14,6"/>

							<Setter
								Property="Background"
								Value="#25272B"/>

							<Setter
								Property="Foreground"
								Value="White"/>

							<Setter
								Property="BorderBrush"
								Value="#FFD740"/>

							<Setter
								Property="BorderThickness"
								Value="1"/>

							<Setter
								Property="FontSize"
								Value="15"/>

							<Setter
								Property="FontWeight"
								Value="SemiBold"/>

							<Setter
								Property="HorizontalContentAlignment"
								Value="Center"/>

							<Setter
								Property="VerticalContentAlignment"
								Value="Center"/>

							<Setter
								Property="Opacity"
								Value="1"/>

							<Setter Property="Template">

								<Setter.Value>

									<ControlTemplate TargetType="Button">

										<Border
											x:Name="ButtonBorder"
											Background="{TemplateBinding Background}"
											BorderBrush="{TemplateBinding BorderBrush}"
											BorderThickness="{TemplateBinding BorderThickness}"
											CornerRadius="6"
											Padding="{TemplateBinding Padding}">

											<ContentPresenter
												HorizontalAlignment="Center"
												VerticalAlignment="Center"/>

										</Border>

										<ControlTemplate.Triggers>

											<Trigger
												Property="IsMouseOver"
												Value="True">

												<Setter
													TargetName="ButtonBorder"
													Property="Background"
													Value="#34373C"/>

											</Trigger>

											<Trigger
												Property="IsEnabled"
												Value="False">

												<Setter
													Property="Foreground"
													Value="#D0D0D0"/>

												<Setter
													Property="BorderBrush"
													Value="#666A70"/>

												<Setter
													TargetName="ButtonBorder"
													Property="Background"
													Value="#3A3D42"/>

											</Trigger>

										</ControlTemplate.Triggers>

									</ControlTemplate>

								</Setter.Value>

							</Setter>

						</Style>

					</Border.Resources>

					<StackPanel>

						<!-- TITLU -->

						<TextBlock
							Text="{DynamicResource SettingsLicensePurchaseTitle}"
							FontSize="22"
							FontWeight="SemiBold"
							Foreground="White"/>

						<!-- DESCRIERE -->

						<TextBlock
						Margin="0,6,0,20"
						Text="{DynamicResource SettingsLicensePurchaseDescription}"
						TextWrapping="Wrap"
						Foreground="#BDBDBD"/>

						<!-- EMAIL -->

						<TextBlock
							Margin="0,0,0,7"
							Text="{DynamicResource SettingsLicenseEmailLabel}"
							FontSize="15"
							FontWeight="SemiBold"
							Foreground="#D0D0D0"/>

						<TextBox
							Height="44"
							Padding="12,0"
							VerticalContentAlignment="Center"
							FontSize="15"
							Background="White"
							Foreground="#202020"
							BorderBrush="#80858C"
							BorderThickness="1"
							Text="{Binding CustomerEmailInput,
                UpdateSourceTrigger=PropertyChanged}"
							MaxLength="254"/>

						<!-- EXPLICAȚIE EMAIL -->

						<TextBlock
							Margin="0,8,0,20"
							Text="{DynamicResource SettingsLicenseEmailHint}"
							TextWrapping="Wrap"
							FontSize="13"
							Foreground="#AEB2B7"/>

						<!-- PLAN LICENȚĂ -->

						<TextBlock
							Margin="0,0,0,7"
							Text="{DynamicResource SettingsLicensePlanLabel}"
							FontSize="15"
							FontWeight="SemiBold"
							Foreground="#D0D0D0"/>

						<ComboBox
							Height="44"
							Padding="10,0"
							ItemsSource="{Binding AvailableLicenseOffers}"
							SelectedItem="{Binding SelectedLicenseOffer,
								Mode=TwoWay,
								UpdateSourceTrigger=PropertyChanged}"
							IsEnabled="{Binding HasAvailableLicenseOffers}"
							Background="White"
							Foreground="#202020"
							BorderBrush="#80858C"
							BorderThickness="1"
							VerticalContentAlignment="Center">

							<ComboBox.ItemTemplate>

								<DataTemplate>

									<Grid>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<TextBlock
											Grid.Column="0"
											Text="{Binding DisplayName}"
											FontSize="15"
											FontWeight="SemiBold"
											Foreground="#202020"/>

										<TextBlock
											Grid.Column="1"
											Margin="20,0,0,0"
											Text="{Binding PriceText}"
											FontSize="15"
											FontWeight="SemiBold"
											Foreground="#202020"/>

									</Grid>

								</DataTemplate>

							</ComboBox.ItemTemplate>

						</ComboBox>

						<TextBlock
							Margin="0,8,0,20"
							Text="{Binding LicenseOffersStatusText}"
							TextWrapping="Wrap"
							FontSize="13"
							Foreground="#AEB2B7"/>

						<!-- BUTOANE -->

						<Grid>

							<Grid.ColumnDefinitions>

								<ColumnDefinition Width="*"/>

								<ColumnDefinition Width="16"/>

								<ColumnDefinition Width="*"/>

							</Grid.ColumnDefinitions>

							<!-- CUMPĂRĂ LICENȚĂ -->

							<Button
								Grid.Column="0"
								MinWidth="180"
								Style="{StaticResource LicenseActionButtonStyle}"
								IsEnabled="{Binding CanStartLicensePurchase}"
			            		Command="{Binding PurchaseLicenseCommand}">

								<TextBlock
									Text="{DynamicResource SettingsLicensePurchaseButton}"
									TextAlignment="Center"
									TextWrapping="Wrap"/>

							</Button>

							<!-- VERIFICĂ ACTIVAREA -->

							<Button
								Grid.Column="2"
								MinWidth="180"
								Style="{StaticResource LicenseActionButtonStyle}"
								IsEnabled="{Binding CanCheckLicenseActivation}"
								Command="{Binding CheckLicenseActivationCommand}">

								<TextBlock
									Text="{DynamicResource SettingsLicenseCheckButton}"
									TextAlignment="Center"
									TextWrapping="Wrap"/>

							</Button>

						</Grid>

						<!-- NOTĂ PLATĂ -->

						<TextBlock
							Margin="0,16,0,0"
							Text="{DynamicResource SettingsLicensePaymentNote}"
							TextWrapping="Wrap"
							FontSize="13"
							LineHeight="19"
							Foreground="#AEB2B7"/>

					</StackPanel>

				</Border>


				<!-- DESPRE WINBOOST -->

				<Border
					Margin="0,0,0,20"
					Padding="22"
					Background="#2D3035"
					CornerRadius="12"
					Style="{StaticResource MetricCardBorderStyle}">

					<StackPanel>

						<TextBlock
							Text="{DynamicResource SettingsAboutTitle}"
							FontSize="20"
							FontWeight="SemiBold"
							Foreground="White"/>

						<TextBlock
							Margin="0,6,0,18"
							Text="{DynamicResource SettingsAboutDescription}"
							TextWrapping="Wrap"
							Foreground="#BDBDBD"/>

						<Grid>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="250"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Margin="0,0,0,10"
								Text="{DynamicResource SettingsAboutProduct}"
								Foreground="#BDBDBD"/>

							<TextBlock
								Grid.Row="0"
								Grid.Column="1"
								Margin="0,0,0,10"
								Text="{x:Static helpers:AppBrandInfo.ProductName}"
								FontWeight="SemiBold"
								Foreground="White"/>

							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="0,0,0,10"
								Text="{DynamicResource SettingsAboutVersion}"
								Foreground="#BDBDBD"/>

							<TextBlock
								Grid.Row="1"
								Grid.Column="1"
								Margin="0,0,0,10"
								Text="{x:Static helpers:AppVersionInfo.InformationalVersion}"
								FontWeight="SemiBold"
								Foreground="White"/>

							<TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Text="{DynamicResource SettingsAboutChannel}"
								Foreground="#BDBDBD"/>

							<TextBlock
								Grid.Row="2"
								Grid.Column="1"
								Text="{x:Static helpers:AppVersionInfo.DisplayVersion}"
								FontWeight="SemiBold"
								Foreground="#FFD740"/>

							<TextBlock
	                                 Grid.Row="3"
                                    	Grid.Column="0"
                                	Margin="0,10,0,0"
                                	Text="{DynamicResource SettingsAboutLicenseStatus}"
	                                Foreground="#BDBDBD"/>

							<TextBlock
								Grid.Row="3"
								Grid.Column="1"
								Margin="0,10,0,0"
								Text="{Binding LicenseStatusText}"
								FontWeight="SemiBold"
								Foreground="#FFD740"/>

							<!-- TIMP RĂMAS TRIAL -->

							<TextBlock
								Grid.Row="4"
								Grid.Column="0"
								Margin="0,10,0,0"
								Text="{DynamicResource SettingsTrialRemainingTime}"
								Foreground="#BDBDBD">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
											Property="Visibility"
											Value="Collapsed"/>

										<Style.Triggers>

											<DataTrigger
												Binding="{Binding IsTrialCountdownVisible}"
												Value="True">

												<Setter
													Property="Visibility"
													Value="Visible"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>

							<TextBlock
								Grid.Row="4"
								Grid.Column="1"
								Margin="0,10,0,0"
								Text="{Binding TrialRemainingTimeText}"
								FontSize="16"
								FontWeight="SemiBold"
								Foreground="#FFD740">

								<TextBlock.Style>

									<Style TargetType="TextBlock">

										<Setter
											Property="Visibility"
											Value="Collapsed"/>

										<Style.Triggers>

											<DataTrigger
												Binding="{Binding IsTrialCountdownVisible}"
												Value="True">

												<Setter
													Property="Visibility"
													Value="Visible"/>

											</DataTrigger>

										</Style.Triggers>

									</Style>

								</TextBlock.Style>

							</TextBlock>
						</Grid>

						<!-- ACTUALIZĂRI WINBOOST -->

						<Border
							Margin="0,22,0,0"
							Padding="16"
							Background="#25272B"
							CornerRadius="8">

							<Grid>

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<!-- STARE -->

								<StackPanel
									Grid.Column="0"
									Margin="0,0,20,0"
									VerticalAlignment="Center">

									<TextBlock
										Text="{DynamicResource SettingsUpdateTitle}"
										FontSize="16"
										FontWeight="SemiBold"
										Foreground="White"/>

									<TextBlock
										Margin="0,6,0,0"
										Text="{Binding WinBoostUpdateStatusText}"
										TextWrapping="Wrap"
										Foreground="#BDBDBD"/>

									<TextBlock
										Margin="0,6,0,0"
										Text="{Binding WinBoostUpdateDownloadStatusText}"
										TextWrapping="Wrap"
										Foreground="#FFD740">

										<TextBlock.Style>

											<Style TargetType="TextBlock">

												<Style.Triggers>

													<Trigger
														Property="Text"
														Value="">

														<Setter
															Property="Visibility"
															Value="Collapsed"/>

													</Trigger>

												</Style.Triggers>

											</Style>

										</TextBlock.Style>

									</TextBlock>

								</StackPanel>

								<!-- ACȚIUNI -->

								<StackPanel
									Grid.Column="1"
									VerticalAlignment="Center">

									<!-- VERIFICĂ ACTUALIZĂRI -->

									<Button
										MinWidth="190"
										Height="38"
										Padding="12,5"
										Command="{Binding CheckWinBoostUpdateCommand}"
										IsEnabled="{Binding CanCheckWinBoostUpdate}"
										Content="{Binding CheckWinBoostUpdateButtonText}"
										Background="#25272B"
										Foreground="White"
										BorderBrush="#FFD740"
										BorderThickness="1"/>

									<!-- DESCARCĂ ACTUALIZAREA -->

									<Button
										Margin="0,10,0,0"
										MinWidth="190"
										Height="38"
										Padding="12,5"
										Command="{Binding DownloadWinBoostUpdateCommand}"
										IsEnabled="{Binding CanDownloadWinBoostUpdate}"
										Content="{Binding DownloadWinBoostUpdateButtonText}"
										Background="#25272B"
										Foreground="White"
										BorderBrush="#4CAF50"
										BorderThickness="1">

										<Button.Style>

											<Style TargetType="Button">

												<Setter
													Property="Visibility"
													Value="Visible"/>

												<Style.Triggers>

													<DataTrigger
														Binding="{Binding CanInstallWinBoostUpdate}"
														Value="True">

														<Setter
															Property="Visibility"
															Value="Collapsed"/>

													</DataTrigger>

												</Style.Triggers>

											</Style>

										</Button.Style>

									</Button>

									<!-- INSTALEAZĂ ACTUALIZAREA -->

									<Button
										Margin="0,10,0,0"
										MinWidth="190"
										Height="38"
										Padding="12,5"
										Command="{Binding InstallWinBoostUpdateCommand}"
										IsEnabled="{Binding CanInstallWinBoostUpdate}"
										Content="{DynamicResource SettingsUpdateInstallButton}">

										<Button.Style>

											<Style TargetType="Button">

												<!-- Ascuns până când update-ul este pregătit -->
												<Setter
													Property="Visibility"
													Value="Collapsed"/>

												<!-- Aspect ACTIV -->
												<Setter
													Property="Background"
													Value="#2E7D32"/>

												<Setter
													Property="Foreground"
													Value="White"/>

												<Setter
													Property="BorderBrush"
													Value="#4CAF50"/>

												<Setter
													Property="BorderThickness"
													Value="1"/>

												<Setter
													Property="Opacity"
													Value="1"/>

												<Setter
													Property="Cursor"
													Value="Hand"/>

												<Setter Property="Template">

													<Setter.Value>

														<ControlTemplate TargetType="Button">

															<Border
																Background="{TemplateBinding Background}"
																BorderBrush="{TemplateBinding BorderBrush}"
																BorderThickness="{TemplateBinding BorderThickness}"
																CornerRadius="2"
																Padding="{TemplateBinding Padding}">

																<ContentPresenter
																	HorizontalAlignment="Center"
																	VerticalAlignment="Center"/>

															</Border>

														</ControlTemplate>

													</Setter.Value>

												</Setter>

												<Style.Triggers>

													<!-- Devine vizibil numai când poate fi instalat -->
													<DataTrigger
														Binding="{Binding CanInstallWinBoostUpdate}"
														Value="True">

														<Setter
															Property="Visibility"
															Value="Visible"/>

													</DataTrigger>

													<!-- Hover -->
													<Trigger
														Property="IsMouseOver"
														Value="True">

														<Setter
															Property="Background"
															Value="#388E3C"/>

														<Setter
															Property="BorderBrush"
															Value="#66BB6A"/>

													</Trigger>

													<!-- Aspect dezactivat -->
													<Trigger
														Property="IsEnabled"
														Value="False">

														<Setter
															Property="Background"
															Value="#303338"/>

														<Setter
															Property="Foreground"
															Value="#8A8A8A"/>

														<Setter
															Property="BorderBrush"
															Value="#55585D"/>

														<Setter
															Property="Cursor"
															Value="Arrow"/>

													</Trigger>

												</Style.Triggers>

											</Style>

										</Button.Style>

									</Button>

								</StackPanel>

							</Grid>

						</Border>
						
					</StackPanel>

				</Border>

			</StackPanel>

		</Grid>

	</ScrollViewer>

</UserControl>